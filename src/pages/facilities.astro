---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { facilitiesData, facilityStats } from '../data/facilities';
---

<Layout 
  title="School Facilities & Campus Infrastructure - Don Bosco School Shirva"
  description="Explore our world-class school facilities at Don Bosco English Medium School Shirva. Advanced STEM labs, Xperimentor kits, indoor adventure park, 800-seat auditorium, 8,000+ volume library, smart classrooms, and 14-bus transport fleet."
>
  <Header />

  <!-- Hero Section -->
  <section class="page-hero on-image">
    <div class="ph-media" data-parallax="-0.12">
      <img src="/about/old-school.jpg" alt="Don Bosco School Shirva Campus" fetchpriority="high" />
    </div>
    <div class="ph-shade" aria-hidden="true"></div>
    <div class="container ph-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb" data-reveal="fade">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page" class="crumb-current">Facilities</span>
      </nav>

      <div class="hero-badges" data-reveal="fade">
        <span class="badge-pill">18 CAMPUS AMENITIES</span>
        <span class="badge-pill">CBSE ACCREDITED INFRASTRUCTURE</span>
        <span class="badge-pill badge-gold">HOLISTIC LEARNING ECOSYSTEM</span>
      </div>

      <h1 class="h1 ph-title" data-split>SCHOOL <em>FACILITIES</em></h1>
      <p class="ph-subtitle" data-reveal="fade">
        A state-of-the-art campus engineered to foster scientific inquiry, physical resilience, artistic mastery, and child wellness. Explore our laboratories, cultural hubs, and safety infrastructure.
      </p>

      <!-- Quick Nav Action Buttons -->
      <div class="hero-actions" data-reveal="fade">
        <a href="#facilities-grid" class="btn-hero-primary">Explore All 18 Facilities</a>
        <a href="/mandatory-public-disclosure#infrastructure" class="btn-hero-ghost">Infrastructure Inspection</a>
        <a href="/contact" class="btn-hero-link">
          Schedule Campus Tour
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Key Infrastructure Stats Bar -->
  <section class="stats-bar" aria-label="Key Infrastructure Statistics">
    <div class="container">
      <div class="stats-grid">
        {facilityStats.map(stat => (
          <div class="stat-card" data-reveal>
            <span class="sc-val">{stat.val}</span>
            <strong class="sc-label">{stat.label}</strong>
            <span class="sc-sub">{stat.sub}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Main Content & Facilities Grid -->
  <main class="main-content section">
    <div class="container facilities-wrapper">

      <!-- Section Intro & Filter Tabs -->
      <div id="facilities-grid" class="section-intro" data-reveal>
        <div class="intro-headings">
          <div class="section-pill">CAMPUS DIRECTORY</div>
          <h2 class="h2 sec-title">World-Class Learning Spaces</h2>
          <p class="sec-desc">
            Discover our tailored spaces created to nurture well-rounded scholars. Select a category below or click on any facility to view detailed specifications, pedagogical aims, and full photo galleries.
          </p>
        </div>

        <!-- Filter Tabs -->
        <div class="filter-tabs-bar" role="tablist" aria-label="Facility Categories">
          <button type="button" class="filter-tab active" data-filter="all" role="tab" aria-selected="true">
            All Facilities (18)
          </button>
          <button type="button" class="filter-tab" data-filter="stem" role="tab" aria-selected="false">
            STEM &amp; Tech (4)
          </button>
          <button type="button" class="filter-tab" data-filter="adventure" role="tab" aria-selected="false">
            Active &amp; Adventure (3)
          </button>
          <button type="button" class="filter-tab" data-filter="academic" role="tab" aria-selected="false">
            Academics &amp; Culture (5)
          </button>
          <button type="button" class="filter-tab" data-filter="care" role="tab" aria-selected="false">
            Health &amp; Campus Care (6)
          </button>
        </div>
      </div>

      <!-- 18 Facilities Grid -->
      <div class="facilities-grid">
        {facilitiesData.map((fac, idx) => (
          <article 
            class="facility-card" 
            data-category={fac.category} 
            data-index={idx}
            data-reveal 
            style={`--delay: ${(idx % 3) * 0.1}s`}
          >
            <!-- Card Header Meta -->
            <div class="fc-header">
              <span class="fc-num">#{idx + 1 < 10 ? `0${idx + 1}` : idx + 1}</span>
              <span class="fc-category-badge">{fac.categoryLabel}</span>
            </div>

            <!-- Card Thumbnail with Zoom Action -->
            <div class="fc-media">
              <img 
                src={fac.img} 
                alt={fac.title} 
                loading="lazy" 
                decoding="async" 
                class="fc-image" 
              />
              <div class="fc-media-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                {fac.extraImages.length + 1} Photos
              </div>
            </div>

            <!-- Card Body -->
            <div class="fc-body">
              <h3 class="h4 fc-title">{fac.title}</h3>
              <p class="fc-tagline">{fac.tagline}</p>
              
              <!-- Quick specs teaser -->
              <div class="fc-specs-teaser">
                {fac.specs.slice(0, 2).map(spec => (
                  <div class="fc-spec-pill">
                    <span class="fsp-lbl">{spec.label}:</span>
                    <strong class="fsp-val">{spec.value}</strong>
                  </div>
                ))}
              </div>
            </div>

            <!-- Card Footer -->
            <div class="fc-footer">
              <button 
                type="button" 
                class="btn-open-facility" 
                data-index={idx}
                aria-label={`View details and gallery for ${fac.title}`}
              >
                <span>Explore Facility</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </button>
            </div>
          </article>
        ))}
      </div>

    </div>
  </main>

  <!-- =========================================================
       REWORKED INTERACTIVE FACILITY POPUP / MODAL
       ========================================================= -->
  <div id="facilityModal" class="facility-modal-backdrop" aria-hidden="true" role="dialog" aria-labelledby="modalTitle" data-lenis-prevent>
    <div class="modal-backdrop-dismiss" id="modalBackdrop"></div>
    <div class="modal-dialog" role="document" data-lenis-prevent>
      
      <!-- Modal Top Sticky Header -->
      <header class="modal-top-bar">
        <div class="mtb-info">
          <span id="modalCategory" class="modal-tag">CATEGORY</span>
          <h2 id="modalTitle" class="modal-heading">Facility Title</h2>
        </div>
        
        <div class="mtb-actions">
          <span id="modalPhotoCount" class="modal-photo-pill">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
            <span id="photoCountText">Photos</span>
          </span>
          <button type="button" id="modalCloseBtn" class="modal-close-trigger" aria-label="Close Facility Dialog (Esc)">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
      </header>

      <!-- Modal Scrollable Content Container -->
      <div class="modal-content-body" data-lenis-prevent>
        
        <!-- Hero Image & Interactive Thumbnail Switcher -->
        <div class="modal-visual-showcase">
          <div class="modal-hero-frame">
            <img id="modalHeroImg" src="" alt="Main Facility Photo" class="modal-hero-img" />
            <div class="hero-overlay-controls">
              <button type="button" id="prevHeroBtn" class="hero-nav-arrow" aria-label="Previous Photo">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
              </button>
              <button type="button" id="nextHeroBtn" class="hero-nav-arrow" aria-label="Next Photo">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
              </button>
            </div>
          </div>

          <!-- Thumbnail Reel for quick switching -->
          <div class="modal-thumb-reel-wrap">
            <div id="modalThumbReel" class="modal-thumb-reel" aria-label="Photo Thumbnails"></div>
          </div>
        </div>

        <!-- Structured Specifications & Key Highlights Grid -->
        <div class="modal-specs-section">
          <h3 class="mss-heading">Key Specifications &amp; Infrastructure Standards</h3>
          <div id="modalSpecsGrid" class="modal-specs-grid"></div>
        </div>

        <!-- Description & Pedagogical Aims -->
        <div class="modal-text-section">
          <h3 class="mts-heading">Overview &amp; Pedagogical Purpose</h3>
          <div id="modalDescHtml" class="modal-rich-text"></div>
        </div>

        <!-- Highlights Checklist -->
        <div id="modalHighlightsBox" class="modal-highlights-card">
          <h4 class="mhc-title">Key Highlights &amp; Student Benefits</h4>
          <ul id="modalHighlightsList" class="mhc-list"></ul>
        </div>

        <!-- Full Gallery Grid in Modal -->
        <div class="modal-gallery-section">
          <div class="mgs-header">
            <h3 class="mgs-title">Complete Photographic Tour</h3>
            <p class="mgs-desc">Click any photograph to view in full dimensions above.</p>
          </div>
          <div id="modalGalleryGrid" class="modal-gallery-grid"></div>
        </div>

      </div>

      <!-- Modal Bottom Footer -->
      <footer class="modal-bottom-bar">
        <div class="mbb-note">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          Don Bosco English Medium School Shirva • All facilities undergo regular maintenance & safety compliance.
        </div>
        <button type="button" id="modalBottomCloseBtn" class="btn-modal-done">Close Overview</button>
      </footer>

    </div>
  </div>

  <Footer />
</Layout>

<script is:inline define:vars={{ facilitiesData }}>
  function initFacilities() {
    // 1. Filtering
    const filterTabs = document.querySelectorAll('.filter-tab');
    const cards = document.querySelectorAll('.facility-card');

    filterTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        filterTabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const filter = tab.getAttribute('data-filter');
        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // 2. Reworked Modal Elements
    const modal = document.getElementById('facilityModal');
    const modalBackdrop = document.getElementById('modalBackdrop');
    const modalCloseBtn = document.getElementById('modalCloseBtn');
    const modalBottomCloseBtn = document.getElementById('modalBottomCloseBtn');
    
    const modalCategory = document.getElementById('modalCategory');
    const modalTitle = document.getElementById('modalTitle');
    const photoCountText = document.getElementById('photoCountText');
    const modalHeroImg = document.getElementById('modalHeroImg');
    const prevHeroBtn = document.getElementById('prevHeroBtn');
    const nextHeroBtn = document.getElementById('nextHeroBtn');
    const modalThumbReel = document.getElementById('modalThumbReel');
    const modalSpecsGrid = document.getElementById('modalSpecsGrid');
    const modalDescHtml = document.getElementById('modalDescHtml');
    const modalHighlightsBox = document.getElementById('modalHighlightsBox');
    const modalHighlightsList = document.getElementById('modalHighlightsList');
    const modalGalleryGrid = document.getElementById('modalGalleryGrid');

    let currentPhotos = [];
    let currentPhotoIndex = 0;

    function setHeroPhoto(index) {
      if (!currentPhotos.length) return;
      currentPhotoIndex = (index + currentPhotos.length) % currentPhotos.length;
      modalHeroImg.src = currentPhotos[currentPhotoIndex];
      modalHeroImg.alt = modalTitle.textContent + ' Photo ' + (currentPhotoIndex + 1);

      // Update active state in reel and gallery
      modalThumbReel.querySelectorAll('.thumb-reel-btn').forEach((btn, idx) => {
        btn.classList.toggle('is-active', idx === currentPhotoIndex);
      });
      modalGalleryGrid.querySelectorAll('.gallery-tile').forEach((tile, idx) => {
        tile.classList.toggle('is-active', idx === currentPhotoIndex);
      });
    }

    if (prevHeroBtn) prevHeroBtn.addEventListener('click', () => setHeroPhoto(currentPhotoIndex - 1));
    if (nextHeroBtn) nextHeroBtn.addEventListener('click', () => setHeroPhoto(currentPhotoIndex + 1));

    function openFacilityModal(index) {
      const fac = facilitiesData[index];
      if (!fac || !modal) return;

      currentPhotos = [fac.img, ...(fac.extraImages || [])];
      currentPhotoIndex = 0;

      modalCategory.textContent = fac.categoryLabel.toUpperCase();
      modalTitle.textContent = fac.title;
      photoCountText.textContent = currentPhotos.length + ' Photos';

      // Set Main Image
      setHeroPhoto(0);

      // Build Thumbnail Reel
      modalThumbReel.innerHTML = '';
      currentPhotos.forEach((imgUrl, i) => {
        const thumbBtn = document.createElement('button');
        thumbBtn.type = 'button';
        thumbBtn.className = 'thumb-reel-btn ' + (i === 0 ? 'is-active' : '');
        thumbBtn.setAttribute('aria-label', 'Show photo ' + (i + 1));
        thumbBtn.innerHTML = '<img src="' + imgUrl + '" alt="' + fac.title + ' thumbnail ' + (i + 1) + '" loading="lazy" />';
        thumbBtn.addEventListener('click', () => setHeroPhoto(i));
        modalThumbReel.appendChild(thumbBtn);
      });

      // Build Specifications Grid
      modalSpecsGrid.innerHTML = '';
      if (fac.specs && fac.specs.length) {
        fac.specs.forEach(spec => {
          const item = document.createElement('div');
          item.className = 'spec-card-item';
          item.innerHTML = '<span class="sci-label">' + spec.label + '</span><strong class="sci-val">' + spec.value + '</strong>';
          modalSpecsGrid.appendChild(item);
        });
      }

      // Rich Description Content
      modalDescHtml.innerHTML = fac.content;

      // Highlights Checklist
      if (fac.highlights && fac.highlights.length) {
        modalHighlightsBox.style.display = 'block';
        modalHighlightsList.innerHTML = '';
        fac.highlights.forEach(hl => {
          const li = document.createElement('li');
          li.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg><span>' + hl + '</span>';
          modalHighlightsList.appendChild(li);
        });
      } else {
        modalHighlightsBox.style.display = 'none';
      }

      // Full Gallery Grid
      modalGalleryGrid.innerHTML = '';
      currentPhotos.forEach((imgUrl, i) => {
        const tile = document.createElement('button');
        tile.type = 'button';
        tile.className = 'gallery-tile ' + (i === 0 ? 'is-active' : '');
        tile.setAttribute('aria-label', 'View photo ' + (i + 1) + ' in main display');
        tile.innerHTML = '<img src="' + imgUrl + '" alt="' + fac.title + ' gallery ' + (i + 1) + '" loading="lazy" /><div class="tile-hover-tag">Photo #' + (i + 1) + '</div>';
        tile.addEventListener('click', () => {
          setHeroPhoto(i);
          const bodyEl = document.querySelector('.modal-content-body');
          if (bodyEl) {
            bodyEl.scrollTo({ top: 0, behavior: 'smooth' });
          }
        });
        modalGalleryGrid.appendChild(tile);
      });

      // Show Modal and reset scroll position to top
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      const modalBody = document.querySelector('.modal-content-body');
      if (modalBody) {
        modalBody.scrollTop = 0;
      }

      // Stop Lenis smooth scroll while popup is open so background never scrolls
      if (typeof window !== 'undefined' && window['__lenis']) {
        try { window['__lenis'].stop(); } catch (err) {}
      }
      document.documentElement.classList.add('modal-open');
      document.body.classList.add('modal-open');
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
    }

    function closeFacilityModal() {
      if (!modal) return;
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');

      // Resume Lenis smooth scroll
      if (typeof window !== 'undefined' && window['__lenis']) {
        try { window['__lenis'].start(); } catch (err) {}
      }
      document.documentElement.classList.remove('modal-open');
      document.body.classList.remove('modal-open');
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
    }

    // Direct click listeners
    document.querySelectorAll('.btn-open-facility').forEach(btn => {
      btn.addEventListener('click', () => {
        const index = parseInt(btn.getAttribute('data-index'), 10);
        openFacilityModal(index);
      });
    });

    // Delegated click listener as a robust fallback
    document.addEventListener('click', (e) => {
      const btn = e.target && e.target.closest ? e.target.closest('.btn-open-facility') : null;
      if (btn) {
        const index = parseInt(btn.getAttribute('data-index'), 10);
        if (!isNaN(index)) {
          openFacilityModal(index);
        }
      }
    });

    if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeFacilityModal);
    if (modalBottomCloseBtn) modalBottomCloseBtn.addEventListener('click', closeFacilityModal);

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal || e.target === modalBackdrop) {
          closeFacilityModal();
        }
      });

      // Wheel event trap: guarantee mouse wheel over ANY modal element (dialog, image, text, footer, backdrop)
      // always scrolls the modal content directly and completely stops background page scrolling
      modal.addEventListener('wheel', (e) => {
        const bodyEl = document.querySelector('.modal-content-body');
        if (!bodyEl) return;

        // Block event from propagating to window or Lenis
        e.preventDefault();
        e.stopPropagation();

        // If cursor is over the thumbnail reel and scrolling horizontally
        const reel = e.target.closest('.modal-thumb-reel-wrap');
        if (reel && Math.abs(e.deltaX) > Math.abs(e.deltaY)) {
          reel.scrollLeft += e.deltaX;
          return;
        }

        // Direct scroll the modal content body
        bodyEl.scrollTop += e.deltaY;
      }, { passive: false });

      // Prevent backdrop touch scrolling from leaking to body
      modal.addEventListener('touchmove', (e) => {
        if (!e.target.closest('.modal-content-body') && !e.target.closest('.modal-thumb-reel-wrap')) {
          e.preventDefault();
        }
      }, { passive: false });
    }

    document.addEventListener('keydown', (e) => {
      if (modal && modal.classList.contains('is-open')) {
        if (e.key === 'Escape') closeFacilityModal();
        if (e.key === 'ArrowLeft') setHeroPhoto(currentPhotoIndex - 1);
        if (e.key === 'ArrowRight') setHeroPhoto(currentPhotoIndex + 1);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFacilities);
  } else {
    initFacilities();
  }
</script>

<style>
  /* =========================================================
     HERO SECTION
     ========================================================= */
  .page-hero {
    position: relative;
    min-height: clamp(520px, 68vh, 720px);
    display: flex;
    align-items: flex-end;
    color: #fff;
    overflow: hidden;
    isolation: isolate;
    background: #0b0d10;
  }
  .ph-media {
    position: absolute;
    inset: -10% 0;
    z-index: -2;
  }
  .ph-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.75);
  }
  .ph-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgba(8, 10, 13, 0.88) 0%,
      rgba(8, 10, 13, 0.65) 45%,
      rgba(8, 10, 13, 0.96) 100%
    );
  }
  .ph-inner {
    padding-top: calc(var(--header-h) + 60px);
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.68);
  }
  .breadcrumb a {
    color: rgba(255, 255, 255, 0.88);
    text-decoration: none;
    transition: color 0.2s;
  }
  .breadcrumb a:hover {
    color: var(--gold);
  }
  .crumb-current {
    color: var(--gold);
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
  }
  .badge-pill {
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.18);
  }
  .badge-gold {
    background: rgba(197, 160, 89, 0.2);
    color: var(--gold);
    border-color: rgba(197, 160, 89, 0.5);
  }

  .ph-title {
    color: #fff;
    max-width: 20ch;
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.1;
  }
  .ph-title :global(em) {
    color: var(--gold);
    font-style: normal;
  }
  .ph-subtitle {
    color: rgba(255, 255, 255, 0.88);
    max-width: 75ch;
    margin: 0;
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin-top: 0.5rem;
  }
  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.75rem 1.6rem;
    border-radius: 999px;
    background: var(--gold);
    color: #fff;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn-hero-primary:hover {
    background: var(--gold-dark);
    transform: translateY(-2px);
  }
  .btn-hero-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.75rem 1.6rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    backdrop-filter: blur(8px);
    transition: all 0.2s ease;
  }
  .btn-hero-ghost:hover {
    background: rgba(255, 255, 255, 0.18);
    transform: translateY(-2px);
  }
  .btn-hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--gold);
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    transition: color 0.2s;
  }
  .btn-hero-link:hover {
    text-decoration: underline;
    color: #fff;
  }

  /* =========================================================
     STATS BAR
     ========================================================= */
  .stats-bar {
    background: var(--bg-alt);
    border-bottom: 1px solid var(--line);
    padding-block: 2rem;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }
  .stat-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.02);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .stat-card:hover {
    transform: translateY(-2px);
    border-color: var(--gold);
  }
  .sc-val {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .sc-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ink);
  }
  .sc-sub {
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* =========================================================
     MAIN SECTION & DIRECTORY
     ========================================================= */
  .main-content {
    padding-block: clamp(3.5rem, 6vw, 6rem);
    background: var(--bg);
  }
  .facilities-wrapper {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .section-intro {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .section-pill {
    display: inline-block;
    width: fit-content;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--gold-text);
    text-transform: uppercase;
    background: rgba(197, 160, 89, 0.12);
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    margin-bottom: 0.4rem;
  }
  .sec-title {
    color: var(--ink);
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
  }
  .sec-desc {
    color: var(--muted);
    margin: 0.5rem 0 0 0;
    max-width: 80ch;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  /* Filter Tabs Bar */
  .filter-tabs-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-top: 0.5rem;
  }
  .filter-tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.5rem 1.25rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .filter-tab:hover {
    border-color: var(--gold);
    color: var(--gold-text);
  }
  .filter-tab.active {
    background: var(--gold);
    color: #fff;
    border-color: var(--gold);
  }

  /* =========================================================
     FACILITY CARDS GRID
     ========================================================= */
  .facilities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }
  .facility-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.03);
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .facility-card:hover {
    transform: translateY(-4px);
    border-color: var(--gold);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.08);
  }

  .fc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem 0.75rem 1.5rem;
  }
  .fc-num {
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--gold-text);
    background: var(--bg-alt);
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    border: 1px solid var(--line);
  }
  .fc-category-badge {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--bg-alt);
    border: 1px solid var(--line);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
  }

  .fc-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--bg-alt);
    overflow: hidden;
  }
  .fc-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .facility-card:hover .fc-image {
    transform: scale(1.06);
  }
  .fc-media-badge {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(0, 0, 0, 0.75);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .fc-body {
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex-grow: 1;
  }
  .fc-title {
    color: var(--ink);
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.35;
  }
  .fc-tagline {
    color: var(--muted);
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .fc-specs-teaser {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--line);
  }
  .fc-spec-pill {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    font-size: 0.82rem;
  }
  .fsp-lbl {
    color: var(--muted);
    font-weight: 600;
  }
  .fsp-val {
    color: var(--ink);
    font-weight: 700;
  }

  .fc-footer {
    padding: 1rem 1.5rem 1.5rem 1.5rem;
  }
  .btn-open-facility {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 46px;
    padding: 0.65rem 1.25rem;
    border-radius: 8px;
    background: var(--bg-alt);
    border: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .btn-open-facility:hover {
    background: var(--gold) !important;
    color: #101216 !important;
    border-color: var(--gold) !important;
  }
  .btn-open-facility:hover * {
    color: #101216 !important;
  }

  /* Global scroll lock when modal is open */
  :global(html.modal-open),
  :global(body.modal-open) {
    overflow: hidden !important;
    height: 100% !important;
    overscroll-behavior: none !important;
  }

  /* =========================================================
     REWORKED POPUP / MODAL DESIGN
     ========================================================= */
  .facility-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(0.75rem, 2.5vw, 2rem);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    overscroll-behavior: contain;
  }
  .facility-modal-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .modal-backdrop-dismiss {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 1;
    cursor: pointer;
  }

  .modal-dialog {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 980px;
    height: min(90vh, 90dvh);
    max-height: 92vh;
    max-height: 92dvh;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-xl, 20px);
    box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.6);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: modalSlideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes modalSlideUp {
    from {
      transform: translateY(30px) scale(0.98);
      opacity: 0;
    }
    to {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
  }

  /* Modal Sticky Top Header */
  .modal-top-bar {
    position: relative;
    z-index: 10;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem clamp(1.25rem, 3vw, 2rem);
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .mtb-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .modal-tag {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--gold-text);
    letter-spacing: 0.08em;
  }
  .modal-heading {
    margin: 0;
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mtb-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }
  .modal-photo-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--bg-alt);
    border: 1px solid var(--line);
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--gold-text);
  }
  .modal-close-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--bg-alt);
    border: 1px solid var(--line);
    color: var(--ink);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .modal-close-trigger:hover {
    background: #ff4d4f;
    color: #fff;
    border-color: #ff4d4f;
  }

  /* Modal Content Body - Scrollable Area */
  .modal-content-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto !important;
    overflow-x: hidden !important;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    touch-action: pan-y;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }
  .modal-content-body::-webkit-scrollbar {
    width: 8px;
  }
  .modal-content-body::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.05);
  }
  :global([data-theme="dark"]) .modal-content-body::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
  }
  .modal-content-body::-webkit-scrollbar-thumb {
    background: var(--gold);
    border-radius: 999px;
  }
  .modal-content-body::-webkit-scrollbar-thumb:hover {
    background: #b5893b;
  }

  /* Visual Showcase */
  .modal-visual-showcase {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .modal-hero-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: clamp(260px, 36vh, 400px);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: #000;
    border: 1px solid var(--line);
  }
  .modal-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.25s ease;
  }
  .hero-overlay-controls {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 1rem;
    pointer-events: none;
  }
  .hero-nav-arrow {
    pointer-events: auto;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition: all 0.2s ease;
  }
  .hero-nav-arrow:hover {
    background: var(--gold);
    color: #000;
    border-color: var(--gold);
    transform: scale(1.08);
  }

  /* Thumbnail Reel */
  .modal-thumb-reel-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 0.5rem;
  }
  .modal-thumb-reel {
    display: flex;
    gap: 0.6rem;
  }
  .thumb-reel-btn {
    position: relative;
    width: 84px;
    height: 60px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
    padding: 0;
    border: 2px solid transparent;
    cursor: pointer;
    background: var(--bg-alt);
    transition: all 0.2s ease;
  }
  .thumb-reel-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb-reel-btn:hover {
    border-color: var(--gold);
  }
  .thumb-reel-btn.is-active {
    border-color: var(--gold);
    box-shadow: 0 0 0 2px rgba(197, 160, 89, 0.4);
  }

  /* Specifications Grid */
  .modal-specs-section {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .mss-heading {
    margin: 0;
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--gold-text);
  }
  .modal-specs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }
  .spec-card-item {
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .sci-label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sci-val {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--ink);
  }

  /* Rich Text Description */
  .modal-text-section {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .mts-heading {
    margin: 0;
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--gold-text);
  }
  .modal-rich-text {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .modal-rich-text p {
    margin: 0;
  }
  .modal-rich-text ul {
    margin: 0;
    padding-left: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .modal-rich-text li {
    line-height: 1.6;
  }

  /* Highlights Checklist */
  .modal-highlights-card {
    background: linear-gradient(135deg, rgba(197, 160, 89, 0.12) 0%, rgba(197, 160, 89, 0.04) 100%);
    border: 1px solid rgba(197, 160, 89, 0.35);
    border-radius: var(--r-lg);
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .mhc-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--ink);
  }
  .mhc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .mhc-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink);
  }
  .mhc-list li svg {
    color: var(--gold);
    flex-shrink: 0;
    margin-top: 3px;
  }

  /* Gallery Section in Modal */
  .modal-gallery-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .mgs-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .mgs-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--ink);
  }
  .mgs-desc {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .modal-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
  }
  .gallery-tile {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-md);
    overflow: hidden;
    padding: 0;
    border: 2px solid transparent;
    cursor: pointer;
    background: var(--bg-alt);
    transition: all 0.25s ease;
  }
  .gallery-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .gallery-tile:hover img {
    transform: scale(1.08);
  }
  .gallery-tile.is-active {
    border-color: var(--gold);
    box-shadow: 0 0 0 2px rgba(197, 160, 89, 0.4);
  }
  .tile-hover-tag {
    position: absolute;
    bottom: 0.5rem;
    left: 0.5rem;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .gallery-tile:hover .tile-hover-tag {
    opacity: 1;
  }

  /* Modal Bottom Footer */
  .modal-bottom-bar {
    position: relative;
    z-index: 10;
    flex-shrink: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.15rem clamp(1.25rem, 3vw, 2rem);
    background: var(--bg-alt);
    border-top: 1px solid var(--line);
  }
  .mbb-note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .mbb-note svg {
    color: var(--gold);
    flex-shrink: 0;
  }
  .btn-modal-done {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.55rem 1.5rem;
    border-radius: 999px;
    background: var(--gold) !important;
    color: #101216 !important;
    font-weight: 700;
    font-size: 0.9rem;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .btn-modal-done:hover {
    background: #0B0D12 !important;
    color: #ffffff !important;
  }

  /* =========================================================
     RESPONSIVE MEDIA QUERIES
     ========================================================= */
  @media (max-width: 768px) {
    .page-hero {
      min-height: 480px;
    }
    .ph-inner {
      padding-top: calc(var(--header-h) + 40px);
      gap: 1rem;
    }
    .ph-title {
      font-size: 2rem;
    }
    .ph-subtitle {
      font-size: 0.95rem;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .btn-hero-primary, .btn-hero-ghost {
      width: 100%;
    }
    .filter-tabs-bar {
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 0.5rem;
      -webkit-overflow-scrolling: touch;
    }
    .filter-tab {
      flex-shrink: 0;
    }
    .facilities-grid {
      grid-template-columns: 1fr;
    }
    .facility-modal-backdrop {
      padding: 0;
    }
    .modal-dialog {
      width: 100%;
      height: 100%;
      max-height: 100dvh;
      border-radius: 0;
      border: none;
      margin: 0;
    }
    .modal-gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .page-hero { min-height: 420px; }
    .facility-card { padding: 1.15rem; }
    .modal-hero-frame { max-height: 260px; }
    .modal-specs-grid { grid-template-columns: 1fr; }
    .modal-gallery-grid { grid-template-columns: 1fr; }
    .modal-top-bar { padding: 1rem; }
    .modal-heading { font-size: 1.3rem; }
  }

  /* =========================================================
     DARK MODE HIGH CONTRAST SPECIFICATIONS
     (Fixes user feedback regarding dark mode heading contrast)
     ========================================================= */
  :global([data-theme="dark"]) .sec-title,
  :global([data-theme="dark"]) .fc-title,
  :global([data-theme="dark"]) .sc-val,
  :global([data-theme="dark"]) .sc-label,
  :global([data-theme="dark"]) .modal-heading,
  :global([data-theme="dark"]) .sci-val,
  :global([data-theme="dark"]) .mhc-title,
  :global([data-theme="dark"]) .mgs-title,
  :global([data-theme="dark"]) .fsp-val {
    color: #F8F6F0 !important;
  }

  :global([data-theme="dark"]) .sec-desc,
  :global([data-theme="dark"]) .fc-tagline,
  :global([data-theme="dark"]) .sc-sub,
  :global([data-theme="dark"]) .fsp-lbl,
  :global([data-theme="dark"]) .sci-label,
  :global([data-theme="dark"]) .mgs-desc,
  :global([data-theme="dark"]) .mbb-note {
