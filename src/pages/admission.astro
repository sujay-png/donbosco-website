---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { admissionData } from '../data/admission';

const title = "Admissions 2025–26 - Don Bosco English Medium School Shirva";
const description = "Official Admission guidelines for Don Bosco English Medium School Shirva for the Academic Year 2025-26. Download Nursery, KG, and Class I to IX application forms or apply online.";
---

<Layout title={title} description={description}>
  <Header />

  <!-- Page Hero -->
  <section class="page-hero on-image">
    <div class="ph-media" data-parallax="-0.12">
      <img src="/hero_new.jpg" alt="Don Bosco English Medium School Shirva Campus" fetchpriority="high" />
    </div>
    <div class="ph-shade" aria-hidden="true"></div>
    <div class="container ph-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb" data-reveal="fade">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span class="crumb-parent">Academics</span>
        <span aria-hidden="true">/</span>
        <span aria-current="page" class="crumb-current">Admission</span>
      </nav>
      <div class="ph-badge" data-reveal="fade">
        <span class="badge-dot"></span>
        Admissions Open for AY {admissionData.academicYear}
      </div>
      <h1 class="h1 ph-title" data-split>Admissions <em>{admissionData.academicYear}</em></h1>
      <p class="ph-sub" data-reveal="fade">
        {admissionData.subtitle}
      </p>

      <div class="hero-actions" data-reveal="fade-up">
        <a href={admissionData.onlinePortalUrl} target="_blank" rel="noopener noreferrer" class="btn btn-gold hero-btn">
          <span>Apply Online Now</span>
          <svg class="btn-ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
        <a href="#offline-forms" class="btn btn-outline hero-btn">
          <span>Download Forms</span>
          <svg class="btn-ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="8 17 12 21 16 17"></polyline>
            <line x1="12" y1="12" x2="12" y2="21"></line>
            <path d="M20.88 18.09A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.29"></path>
          </svg>
        </a>
        <a href={`tel:${admissionData.contactPhoneRaw}`} class="btn btn-glass hero-btn">
          <svg class="btn-ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <span>Helpline: {admissionData.contactPhone}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Quick Highlights Bar -->
  <section class="highlights-sec">
    <div class="container">
      <div class="highlights-grid" data-reveal="fade-up">
        <div class="hl-card">
          <div class="hl-icon-wrap">
            <span class="hl-emoji">🎓</span>
          </div>
          <div class="hl-info">
            <span class="hl-title">CBSE Affiliated</span>
            <span class="hl-desc">Play School to Senior Secondary</span>
          </div>
        </div>
        <div class="hl-card">
          <div class="hl-icon-wrap">
            <span class="hl-emoji">📅</span>
          </div>
          <div class="hl-info">
            <span class="hl-title">Academic Year 2025–26</span>
            <span class="hl-desc">Admissions actively open</span>
          </div>
        </div>
        <div class="hl-card">
          <div class="hl-icon-wrap">
            <span class="hl-emoji">⚡</span>
          </div>
          <div class="hl-info">
            <span class="hl-title">Flexible Dual Mode</span>
            <span class="hl-desc">Apply online or download paper form</span>
          </div>
        </div>
        <div class="hl-card">
          <div class="hl-icon-wrap">
            <span class="hl-emoji">📞</span>
          </div>
          <div class="hl-info">
            <span class="hl-title">Admissions Desk</span>
            <a href={`tel:${admissionData.contactPhoneRaw}`} class="hl-desc link-hl">{admissionData.contactPhone}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <main id="main-content" class="admission-main">
    <!-- TWO MODES SECTION -->
    <section class="modes-section" id="application-modes">
      <div class="container">
        <div class="sec-header text-center" data-reveal="fade-up">
          <div class="sec-badge">
            <span class="sec-badge-dot"></span>
            Application Pathways
          </div>
          <h2 class="h2 sec-title">Choose Your Application <em>Mode</em></h2>
          <p class="sec-sub">
            We provide both convenient digital application and traditional campus offline registration. Select the option that best suits your convenience.
          </p>
        </div>

        <div class="modes-grid">
          <!-- CARD 1: OFFLINE MODE -->
          <article class="mode-card offline-card" id="offline-forms" data-reveal="fade-up">
            <div class="mode-card-header">
              <div class="mode-badge-wrap">
                <span class="mode-badge offline-badge">In-Person &amp; Paper Mode</span>
              </div>
              <h3 class="mode-title">OFFLINE MODE</h3>
              <p class="mode-tagline">Physical registration at the school office or downloadable paper submission.</p>
            </div>

            <div class="mode-card-body">
              <div class="guidelines-block">
                <h4 class="guidelines-title">
                  <span class="gt-icon">📋</span> Guidelines for Offline Admission:
                </h4>
                <ol class="guidelines-list">
                  {admissionData.offlineGuidelines.map((item, idx) => (
                    <li class="gl-item">
                      <span class="gl-num">{idx + 1}</span>
                      <p class="gl-text">{item}</p>
                    </li>
                  ))}
                </ol>
              </div>

              <!-- Note Alert -->
              <div class="mode-note">
                <div class="note-icon">📌</div>
                <div class="note-content">
                  <strong>Important Notice:</strong>
                  <p>{admissionData.offlineNote}</p>
                </div>
              </div>

              <!-- Download Forms Box -->
              <div class="forms-container">
                <div class="forms-header">
                  <h4 class="forms-title">
                    <span class="ft-icon">📥</span> Download Official Admission Forms
                  </h4>
                  <span class="forms-subtitle">Print, fill out, and submit directly to the school principal.</span>
                </div>

                <div class="forms-list">
                  {admissionData.downloadableForms.map((form) => (
                    <div class="form-download-card">
                      <div class="fd-left">
                        <div class="fd-file-icon">
                          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="12" y1="18" x2="12" y2="12"></line>
                            <line x1="9" y1="15" x2="15" y2="15"></line>
                          </svg>
                          <span class="pdf-pill">PDF</span>
                        </div>
                        <div class="fd-info">
                          <div class="fd-top-meta">
                            <span class="fd-badge">{form.badge}</span>
                            <span class="fd-size">{form.fileSize}</span>
                          </div>
                          <h5 class="fd-title">{form.title}</h5>
                          <span class="fd-grades">For: <strong>{form.grades}</strong></span>
                        </div>
                      </div>

                      <div class="fd-actions">
                        <a 
                          href={form.url} 
                          download={form.filename} 
                          class="btn btn-gold btn-sm form-btn"
                          aria-label={`Download ${form.title} (${form.fileSize})`}
                        >
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                          </svg>
                          <span>Download Form</span>
                        </a>
                        <a 
                          href={form.url} 
                          target="_blank" 
                          rel="noopener noreferrer" 
                          class="btn btn-outline btn-sm form-btn view-btn"
                          aria-label={`View ${form.title} in new tab`}
                        >
                          <span>Preview</span>
                        </a>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </article>

          <!-- CARD 2: ONLINE MODE -->
          <article class="mode-card online-card" data-reveal="fade-up" style="--delay: 0.15s;">
            <div class="mode-card-header">
              <div class="mode-badge-wrap">
                <span class="mode-badge online-badge">Fast &amp; Digital Portal</span>
              </div>
              <h3 class="mode-title">ONLINE MODE</h3>
              <p class="mode-tagline">Convenient online application portal accessible 24/7 from anywhere.</p>
            </div>

            <div class="mode-card-body">
              <div class="guidelines-block">
                <h4 class="guidelines-title">
                  <span class="gt-icon">🌐</span> Guidelines for Online Admission:
                </h4>
                <div class="online-steps-tracker">
                  {admissionData.onlineGuidelines.map((step) => (
                    <div class="os-item">
                      <div class="os-marker">
                        <span class="os-number">{step.step}</span>
                        <span class="os-line" aria-hidden="true"></span>
                      </div>
                      <div class="os-content">
                        <h5 class="os-title">{step.title}</h5>
                        <p class="os-desc">{step.description}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Portal Callout -->
              <div class="portal-callout-box">
                <div class="pc-content">
                  <span class="pc-kicker">Official Admissions Web Portal</span>
                  <h4 class="pc-title">Apply in Just a Few Minutes</h4>
                  <p class="pc-desc">
                    Access our dedicated CBSE admission software. Complete your form, upload supporting information, and track admission confirmation status easily.
                  </p>
                </div>
                <div class="pc-action">
                  <a 
                    href={admissionData.onlinePortalUrl} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="btn btn-gold btn-lg portal-apply-btn"
                  >
                    <span>Apply Now Online</span>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10"></circle>
                      <line x1="2" y1="12" x2="22" y2="12"></line>
                      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                    </svg>
                  </a>
                  <span class="portal-url-tag">admission.donboscoschoolshirva.edu.in</span>
                </div>
              </div>

              <!-- Assistance Box -->
              <div class="online-help-strip">
                <div class="oh-icon">💬</div>
                <div class="oh-text">
                  <span>Need help filling the online form?</span>
                  <strong>Call Admissions Helpline: <a href={`tel:${admissionData.contactPhoneRaw}`}>{admissionData.contactPhone}</a></strong>
                </div>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- GENERAL CRITERIA SECTION -->
    <section class="criteria-section" id="general-criteria">
      <div class="container">
        <div class="sec-header text-center" data-reveal="fade-up">
          <div class="sec-badge">
            <span class="sec-badge-dot"></span>
            Standards &amp; Eligibility
          </div>
          <h2 class="h2 sec-title">General Admission <em>Criteria</em></h2>
          <p class="sec-sub">
            Essential guidelines regarding age cutoffs, assessment procedures, parent-principal interactions, and document verification.
          </p>
        </div>

        <!-- AGE CRITERIA GRID -->
        <div class="age-criteria-wrap" data-reveal="fade-up">
          <div class="ac-header">
            <div class="ac-title-wrap">
              <span class="ac-icon">🗓️</span>
              <div>
                <h3 class="ac-main-title">Age Criteria (As on June 1st for AY {admissionData.academicYear})</h3>
                <p class="ac-main-sub">The age requirements appropriate to each grade as prescribed by the education department.</p>
              </div>
            </div>
            <span class="ac-pill">Academic Year 2025–26</span>
          </div>

          <div class="age-cards-grid">
            {admissionData.ageCriteria.map((item) => (
              <div class="age-card">
                <div class="age-card-top">
                  <span class="age-card-emoji">{item.icon}</span>
                  <span class="age-badge">{item.grade}</span>
                </div>
                <div class="age-card-content">
                  <div class="age-val">{item.age}</div>
                  <div class="age-cutoff">{item.note}</div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- 4-STEP ADMISSION PROCESS TIMELINE -->
        <div class="timeline-wrap" data-reveal="fade-up">
          <div class="tl-header text-center">
            <h3 class="tl-title">Step-by-Step Admission Procedure</h3>
            <p class="tl-sub">From application to final enrolment, here is how the admission process flows:</p>
          </div>

          <div class="steps-flow-grid">
            {admissionData.admissionProcessSteps.map((step) => (
              <div class="flow-step-card">
                <div class="flow-step-top">
                  <span class="flow-num">{step.step}</span>
                  <div class="flow-dot"></div>
                </div>
                <h4 class="flow-step-title">{step.title}</h4>
                <p class="flow-step-desc">{step.description}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- PARENT & PRINCIPAL INTERACTION CALLOUT -->
        <div class="interaction-highlight-card" data-reveal="fade-up">
          <div class="ih-left">
            <div class="ih-icon">🤝</div>
            <div>
              <h4 class="ih-title">Personal Interaction with the Principal</h4>
              <p class="ih-desc">
                After the interaction/written test, a school visit is scheduled for parents and the student. Both parents must be present for the interaction with the Principal. On approval of the Principal, the student will be granted admission into the appropriate grade.
              </p>
            </div>
          </div>
          <div class="ih-badge-wrap">
            <span class="ih-badge">Both Parents Required</span>
          </div>
        </div>
      </div>
    </section>

    <!-- DOCUMENTS REQUIRED SECTION -->
    <section class="documents-section" id="required-documents">
      <div class="container">
        <div class="sec-header text-center" data-reveal="fade-up">
          <div class="sec-badge">
            <span class="sec-badge-dot"></span>
            Verification Checklist
          </div>
          <h2 class="h2 sec-title">Documents to be <em>Submitted</em></h2>
          <p class="sec-sub">
            All listed documents must be submitted at the school office at the latest within <strong>7 days</strong> of confirming admission. Special care should be taken to ensure all details furnished are true and accurate.
          </p>
        </div>

        <div class="docs-grid" data-reveal="fade-up">
          {admissionData.requiredDocuments.map((doc, idx) => (
            <div class:list={['doc-card', { 'doc-optional': doc.isOptional }]}>
              <div class="doc-card-top">
                <span class="doc-idx">{String(idx + 1).padStart(2, '0')}</span>
                <span class:list={['doc-status-tag', doc.isOptional ? 'tag-opt' : 'tag-req']}>
                  {doc.isOptional ? 'If Applicable' : 'Mandatory'}
                </span>
              </div>
              <h4 class="doc-title">{doc.title}</h4>
              <p class="doc-detail">{doc.detail}</p>
            </div>
          ))}
        </div>

        <div class="doc-footer-alert" data-reveal="fade-up">
          <div class="df-icon">⚠️</div>
          <div class="df-text">
            <strong>Important Submission Deadline:</strong> All original documents for verification, along with attested photocopies, must be deposited at the administrative office within 7 days of admission confirmation to secure your child’s seat.
          </div>
        </div>
      </div>
    </section>

    <!-- ADMISSION BROCHURE & CAMPUS GLIMPSE -->
    <section class="brochure-section" id="admission-brochure">
      <div class="container">
        <div class="sec-header text-center" data-reveal="fade-up">
          <div class="sec-badge">
            <span class="sec-badge-dot"></span>
            Campus &amp; Prospectus
          </div>
          <h2 class="h2 sec-title">Admission Brochure &amp; <em>Campus Glimpse</em></h2>
          <p class="sec-sub">
            Explore our curriculum highlights, campus facilities, and extracurricular excellence.
          </p>
        </div>

        <div class="brochure-layout" data-reveal="fade-up">
          <!-- Official Brochure Card -->
          <div class="brochure-card">
            <div class="bc-image-wrap">
              <img 
                src={admissionData.brochure.image} 
                alt="Don Bosco School Admission Brochure" 
                class="bc-img"
                loading="lazy"
                id="brochureImage"
              />
              <div class="bc-overlay">
                <button type="button" class="btn btn-gold btn-sm zoom-btn" id="openBrochureModalBtn">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    <line x1="11" y1="8" x2="11" y2="14"></line>
                    <line x1="8" y1="11" x2="14" y2="11"></line>
                  </svg>
                  <span>Click to Expand Brochure</span>
                </button>
              </div>
            </div>

            <div class="bc-info">
              <span class="bc-badge">Official Prospectus</span>
              <h3 class="bc-title">{admissionData.brochure.title}</h3>
              <p class="bc-desc">{admissionData.brochure.description}</p>
              <div class="bc-actions">
                <a 
                  href={admissionData.brochure.downloadUrl} 
                  download="Don-Bosco-School-Admission-brochure.png" 
                  class="btn btn-gold btn-sm"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                  </svg>
                  <span>Download High-Res Brochure</span>
                </a>
                <button type="button" class="btn btn-outline btn-sm" id="viewBrochureBtn">
                  <span>Full Screen View</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Campus Photos & Highlights -->
          <div class="campus-side-wrap">
            <div class="campus-photos-grid">
              {admissionData.campusPhotos.map((photo) => (
                <div class="cp-card">
                  <div class="cp-img-wrap">
                    <img src={photo.src} alt={photo.alt} class="cp-img" loading="lazy" />
                  </div>
                  <div class="cp-caption">
                    <span class="cp-dot"></span>
                    <span>{photo.caption}</span>
                  </div>
                </div>
              ))}
            </div>

            <!-- Key School Pillars -->
            <div class="pillars-card">
              <h4 class="pillars-title">Why Parents Choose Don Bosco Shirva:</h4>
              <ul class="pillars-list">
                <li>
                  <span class="pl-ic">✓</span>
                  <div>
                    <strong>Value-Based Holistic Education:</strong>
                    <span>Blending CBSE academic rigor with moral grounding and leadership development.</span>
                  </div>
                </li>
                <li>
                  <span class="pl-ic">✓</span>
                  <div>
                    <strong>Modern Infrastructure:</strong>
                    <span>Robotics &amp; AI lab, smart classes, composite physics/chemistry/biology labs, and extensive library.</span>
                  </div>
                </li>
                <li>
                  <span class="pl-ic">✓</span>
                  <div>
                    <strong>Safe &amp; Secure Campus:</strong>
                    <span>Comprehensive CCTV surveillance, RO drinking water, infirmary with school nurse, and school bus network.</span>
                  </div>
                </li>
                <li>
                  <span class="pl-ic">✓</span>
                  <div>
                    <strong>Co-Curricular Excellence:</strong>
                    <span>Scouts &amp; Guides, YSM, Western Dance, Karate, Sports tournaments, and Cultural fests.</span>
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ADMISSION HELPDESK BANNER -->
    <section class="helpdesk-sec" id="admissions-helpdesk">
      <div class="container">
        <div class="helpdesk-card" data-reveal="fade-up">
          <div class="hd-left">
            <span class="hd-eyebrow">Admissions Helpdesk &amp; Inquiries</span>
            <h2 class="h2 hd-title">Have Questions About <em>Admissions?</em></h2>
            <p class="hd-desc">
              Our Admissions Unit is always delighted to assist you with class availability, syllabus details, fee structures, and scheduling campus visits.
            </p>

            <div class="hd-contact-grid">
              <a href={`tel:${admissionData.contactPhoneRaw}`} class="hd-contact-item">
                <div class="hd-ci-icon">
                  <Icon name="phone" size={20} />
                </div>
                <div>
                  <small>Call Admissions Desk</small>
                  <strong>{admissionData.contactPhone}</strong>
                </div>
              </a>

              <a href={`mailto:${admissionData.contactEmail}`} class="hd-contact-item">
                <div class="hd-ci-icon">
                  <Icon name="mail" size={20} />
                </div>
                <div>
                  <small>Email Admissions Desk</small>
                  <strong>{admissionData.contactEmail}</strong>
                </div>
              </a>

              <div class="hd-contact-item">
                <div class="hd-ci-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                </div>
                <div>
                  <small>Office Hours</small>
                  <strong>Mon–Fri: 9am–4pm | Sat: 9am–1pm</strong>
                </div>
              </div>
            </div>
          </div>

          <div class="hd-right">
            <div class="hd-card-box">
              <span class="hcb-badge">Campus Address</span>
              <h4 class="hcb-title">Don Bosco English Medium School</h4>
              <p class="hcb-addr">Shirva, Udupi District – 574116, Karnataka, India</p>
              <div class="hcb-buttons">
