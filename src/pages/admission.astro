    min-height: 24px;
    background: var(--adm-border);
    margin-top: 4px;
  }

  .os-item:last-child .os-line {
    display: none;
  }

  .os-content {
    padding-top: 0.35rem;
  }

  .os-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--adm-heading);
    margin: 0 0 0.25rem;
  }

  .os-desc {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--adm-body);
    margin: 0;
  }

  /* Portal Callout Box */
  .portal-callout-box {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border-radius: 20px;
    padding: 2rem 2.2rem;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    box-shadow: 0 16px 36px rgba(15, 23, 42, 0.2);
  }

  .pc-kicker {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--gold, #ffb606);
    margin-bottom: 0.4rem;
  }

  .pc-title {
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #fff;
    margin: 0 0 0.5rem;
  }

  .pc-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
  }

  .pc-action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .btn-lg {
    min-height: 52px;
    padding: 0.95rem 1.8rem;
    font-size: 1.02rem;
    font-weight: 700;
    border-radius: 999px;
  }

  .portal-apply-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    box-shadow: 0 6px 20px rgba(255, 182, 6, 0.35);
  }

  .portal-apply-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(255, 182, 6, 0.45);
  }

  .portal-url-tag {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.55);
    font-family: monospace;
  }

  .online-help-strip {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.25rem;
    border-radius: 14px;
    background: var(--adm-surface-2);
    border: 1px solid var(--adm-border);
  }

  .oh-icon {
    font-size: 1.35rem;
  }

  .oh-text {
    display: flex;
    flex-direction: column;
    font-size: 0.88rem;
    color: var(--adm-body);
  }

  .oh-text strong a {
    color: var(--adm-heading);
    font-weight: 700;
    text-decoration: underline;
  }

  /* ==========================================================================
     GENERAL CRITERIA & TIMELINE
     ========================================================================== */
  .criteria-section {
    padding-block: clamp(3rem, 6vw, 6rem);
    background: var(--adm-surface-2);
    border-block: 1px solid var(--adm-border);
  }

  .age-criteria-wrap {
    background: var(--adm-surface);
    border-radius: 24px;
    border: 1px solid var(--adm-border);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.04);
    padding: 2.25rem;
    margin-bottom: 3.5rem;
  }

  .ac-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.75rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--adm-border);
    flex-wrap: wrap;
  }

  .ac-title-wrap {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .ac-icon {
    font-size: 2rem;
  }

  .ac-main-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--adm-heading);
    margin: 0 0 0.25rem;
  }

  .ac-main-sub {
    font-size: 0.92rem;
    color: var(--adm-muted);
    margin: 0;
  }

  .ac-pill {
    font-size: 0.82rem;
    font-weight: 700;
    background: rgba(255, 182, 6, 0.15);
    color: #925400;
    padding: 0.4rem 1rem;
    border-radius: 999px;
  }

  .age-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .age-card {
    background: var(--adm-surface-2);
    border: 1px solid var(--adm-border);
    border-radius: 18px;
    padding: 1.6rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .age-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 182, 6, 0.4);
    background: var(--adm-surface);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.05);
  }

  .age-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .age-card-emoji {
    font-size: 1.8rem;
  }

  .age-badge {
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    background: #0f172a;
    color: #ffffff;
  }

  .age-val {
    font-size: 2rem;
    font-weight: 800;
    color: var(--adm-heading);
    line-height: 1;
    margin-bottom: 0.35rem;
  }

  .age-cutoff {
    font-size: 0.82rem;
    color: var(--adm-muted);
  }

  /* Timeline Flow */
  .timeline-wrap {
    margin-bottom: 3.5rem;
  }

  .tl-header {
    max-width: 650px;
    margin: 0 auto 2.5rem;
  }

  .tl-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--adm-heading);
    margin: 0 0 0.4rem;
  }

  .tl-sub {
    font-size: 0.95rem;
    color: var(--adm-muted);
    margin: 0;
  }

  .steps-flow-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .flow-step-card {
    background: var(--adm-surface);
    border: 1px solid var(--adm-border);
    border-radius: 20px;
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    position: relative;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.03);
    transition: transform 0.25s ease;
  }

  .flow-step-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.06);
  }

  .flow-step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .flow-num {
    font-size: 1.6rem;
    font-weight: 900;
    color: var(--gold, #ffb606);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .flow-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #0f172a;
  }

  .flow-step-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--adm-heading);
    margin: 0;
  }

  .flow-step-desc {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--adm-body);
    margin: 0;
  }

  /* Interaction Highlight Card */
  .interaction-highlight-card {
    background: linear-gradient(135deg, rgba(209, 27, 131, 0.08) 0%, rgba(255, 182, 6, 0.08) 100%);
    border: 1px solid rgba(209, 27, 131, 0.2);
    border-radius: 20px;
    padding: 1.75rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .ih-left {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 820px;
  }

  .ih-icon {
    font-size: 2.2rem;
    flex-shrink: 0;
    line-height: 1;
  }

  .ih-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--adm-heading);
    margin: 0 0 0.35rem;
  }

  .ih-desc {
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--adm-body);
    margin: 0;
  }

  .ih-badge {
    background: #d11b83;
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  /* ==========================================================================
     DOCUMENTS SECTION
     ========================================================================== */
  .documents-section {
    padding-block: clamp(3rem, 6vw, 6rem);
  }

  .docs-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.35rem;
    margin-bottom: 2.5rem;
  }

  .doc-card {
    background: var(--adm-surface);
    border: 1px solid var(--adm-border);
    border-radius: 20px;
    padding: 1.6rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.03);
    transition: all 0.25s ease;
  }

  .doc-card:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 182, 6, 0.4);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.06);
  }

  .doc-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .doc-idx {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--gold, #ffb606);
    font-family: monospace;
  }

  .doc-status-tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
  }

  .tag-req {
    background: rgba(209, 27, 131, 0.12);
    color: #d11b83;
  }

  .tag-opt {
    background: var(--adm-surface-2);
    color: var(--adm-muted);
  }

  .doc-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--adm-heading);
    margin: 0;
    line-height: 1.35;
  }

  .doc-detail {
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--adm-muted);
    margin: 0;
  }

  .doc-footer-alert {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    background: rgba(255, 182, 6, 0.12);
    border: 1px solid rgba(255, 182, 6, 0.35);
    border-radius: 16px;
    padding: 1.25rem 1.6rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .df-icon {
    font-size: 1.6rem;
    flex-shrink: 0;
  }

  .df-text {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--adm-body);
  }

  .df-text strong {
    color: #925400;
  }

  /* ==========================================================================
     BROCHURE SECTION
     ========================================================================== */
  .brochure-section {
    padding-block: clamp(3rem, 6vw, 6rem);
    background: var(--adm-surface-2);
    border-top: 1px solid var(--adm-border);
  }

  .brochure-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .brochure-card {
    background: var(--adm-surface);
    border: 1px solid var(--adm-border);
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.05);
    display: flex;
    flex-direction: column;
  }

  .bc-image-wrap {
    position: relative;
    background: #0f172a;
    aspect-ratio: 16 / 11;
    overflow: hidden;
  }

  .bc-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.4s ease;
  }

  .brochure-card:hover .bc-img {
    transform: scale(1.03);
  }

  .bc-overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.4);
    display: grid;
    place-items: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .brochure-card:hover .bc-overlay {
    opacity: 1;
  }

  .zoom-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .bc-info {
    padding: 1.75rem 2rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .bc-badge {
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #d11b83;
    background: rgba(209, 27, 131, 0.1);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
  }

  .bc-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--adm-heading);
    margin: 0;
  }

  .bc-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--adm-muted);
    margin: 0;
  }

  .bc-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }

  /* Campus Side Wrap */
  .campus-side-wrap {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .campus-photos-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .cp-card {
    background: var(--adm-surface);
    border: 1px solid var(--adm-border);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.04);
  }

  .cp-img-wrap {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #0f172a;
  }

  .cp-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .cp-card:hover .cp-img {
    transform: scale(1.04);
  }

  .cp-caption {
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--adm-body);
  }

  .cp-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold, #ffb606);
    flex-shrink: 0;
  }

  /* Pillars Card */
  .pillars-card {
    background: var(--adm-surface);
    border: 1px solid var(--adm-border);
    border-radius: 20px;
    padding: 1.75rem;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.03);
  }

  .pillars-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--adm-heading);
    margin: 0 0 1rem;
  }

  .pillars-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .pillars-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .pl-ic {
    color: #10b981;
    font-weight: 800;
    font-size: 0.95rem;
    margin-top: 0.15rem;
    flex-shrink: 0;
  }

  .pillars-list li div {
    display: flex;
    flex-direction: column;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .pillars-list li strong {
    color: var(--adm-heading);
    margin-bottom: 0.15rem;
  }

  .pillars-list li span {
    color: var(--adm-muted);
  }

  /* ==========================================================================
     HELPDESK SECTION
     ========================================================================== */
  .helpdesk-sec {
    padding-block: clamp(3rem, 6vw, 6rem);
  }

  .helpdesk-card {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border-radius: 32px;
    padding: clamp(2.25rem, 5vw, 4rem);
    color: #ffffff;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 3.5rem;
    align-items: center;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.25);
    position: relative;
    overflow: hidden;
  }

  .hd-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--gold, #ffb606);
    display: block;
    margin-bottom: 0.75rem;
  }

  .hd-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: #fff;
    margin: 0 0 1rem;
  }

  .hd-title em {
    font-style: italic;
    color: var(--gold, #ffb606);
    font-weight: 400;
  }

  .hd-desc {
    font-size: 1rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.8);
    margin: 0 0 2rem;
    max-width: 580px;
  }

  .hd-contact-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hd-contact-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: all 0.25s ease;
    text-decoration: none;
    color: #ffffff;
  }

  .hd-contact-item:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--gold, #ffb606);
    transform: translateX(4px);
  }

  .hd-ci-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 182, 6, 0.15);
    color: var(--gold, #ffb606);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .hd-contact-item small {
    display: block;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.65);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.15rem;
  }

  .hd-contact-item strong {
    font-size: 0.98rem;
    color: #ffffff;
  }

  /* Helpdesk Right Card */
  .hd-card-box {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 24px;
    padding: 2.25rem;
    backdrop-filter: blur(12px);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .hcb-badge {
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--gold, #ffb606);
    background: rgba(255, 182, 6, 0.15);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
  }

  .hcb-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #fff;
    margin: 0;
  }

  .hcb-addr {
    font-size: 0.92rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
  }

  .hcb-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-top: 0.5rem;
  }

  .btn-block {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    gap: 0.5rem;
  }

  /* ==========================================================================
     MODAL STYLES
     ========================================================================== */
  .brochure-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
    place-items: center;
    padding: 1.5rem;
  }

  .brochure-modal.is-open {
    display: grid;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 15, 29, 0.85);
    backdrop-filter: blur(8px);
  }

  .modal-dialog {
    position: relative;
    z-index: 2;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 24px;
    max-width: 960px;
    width: 100%;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);
  }

  .modal-header {
    padding: 1.25rem 1.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .mh-info {
    display: flex;
    flex-direction: column;
  }

  .mh-badge {
    font-size: 0.72rem;
    color: var(--gold, #ffb606);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .mh-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #fff;
    margin: 0.15rem 0 0;
  }

  .mh-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .btn-close-modal {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-close-modal:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.05);
  }

  .modal-body {
    padding: 1rem;
    overflow-y: auto;
    display: flex;
    justify-content: center;
    background: #050b14;
  }

  .modal-full-img {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    object-fit: contain;
  }

  /* ==========================================================================
     EXPLICIT DARK MODE ENHANCEMENTS
     ========================================================================== */
  :global([data-theme="dark"]) .admission-main {
