<script>
  // Brochure Modal Logic
  const modal = document.getElementById('brochureModal');
  const backdrop = document.getElementById('modalBackdrop');
  const openBtn = document.getElementById('openBrochureModalBtn');
  const viewBtn = document.getElementById('viewBrochureBtn');
  const closeBtn = document.getElementById('closeBrochureModalBtn');

  function openModal() {
    if (modal) {
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  }

  openBtn?.addEventListener('click', openModal);
  viewBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('is-open')) {
      closeModal();
    }
  });
</script>

