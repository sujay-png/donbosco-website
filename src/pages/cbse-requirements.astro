---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { cbseRequirementsData, cbseHighlights } from '../data/cbse-requirements';
---

<Layout 
  title="CBSE Requirements & Regulatory Documents - Don Bosco School Shirva"
  description="Comprehensive regulatory and statutory compliance documentation for Don Bosco English Medium School Shirva under CBSE (Affiliation No. 830838, School Code: 45731). View and download affiliation letters, safety certificates, land deeds, and governance frameworks."
>
  <Header />

  <!-- Hero Section -->
  <section class="page-hero on-image">
    <div class="ph-media" data-parallax="-0.12">
      <img src="/about/old-school.jpg" alt="Don Bosco School Shirva Campus" fetchpriority="high" />
    </div>
    <div class="ph-shade" aria-hidden="true"></div>
    <div class="container ph-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb" data-reveal="fade">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>CBSE</span>
        <span aria-hidden="true">/</span>
        <span aria-current="page" class="crumb-current">CBSE Requirements</span>
      </nav>

      <div class="hero-badges" data-reveal="fade">
        <span class="badge-pill">CBSE AFFILIATION NO: 830838</span>
        <span class="badge-pill">SCHOOL CODE: 45731</span>
        <span class="badge-pill badge-gold">REGULATORY COMPLIANCE</span>
      </div>

      <h1 class="h1 ph-title" data-split>CBSE <em>REQUIREMENTS</em></h1>
      <p class="ph-subtitle" data-reveal="fade">
        Statutory accreditations, NOCs, regulatory clearances, safety certifications, and governance disclosures in complete accordance with CBSE affiliation bye-laws and educational norms.
      </p>

      <!-- Jump link to table -->
      <div class="hero-actions" data-reveal="fade">
        <a href="#documents-grid" class="btn-hero-primary">Explore All 15 Documents</a>
        <a href="#compliance-table" class="btn-hero-ghost">View Summary Checklist</a>
        <a href="/mandatory-public-disclosure" class="btn-hero-link">
          Mandatory Public Disclosure (Appendix IX)
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Highlights Bar -->
  <section class="highlights-bar" aria-label="Key Accreditation Highlights">
    <div class="container">
      <div class="highlights-grid">
        {cbseHighlights.map(item => (
          <div class="highlight-item" data-reveal>
            <span class="hl-label">{item.label}</span>
            <strong class="hl-val">{item.val}</strong>
            <span class="hl-sub">{item.sub}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Main Content Area -->
  <main class="main-section section">
    <div class="container req-wrapper">

      <!-- Section Header & Filter Controls -->
      <div id="documents-grid" class="section-intro" data-reveal>
        <div class="intro-headings">
          <div class="section-pill">STATUTORY REPOSITORY</div>
          <h2 class="h2 sec-title">Official Documents &amp; Certificates</h2>
          <p class="sec-desc">
            Browse verified institutional certifications, land deeds, and administrative compliances. Click on any document card to view in full resolution or download official files.
          </p>
        </div>

        <!-- Filter Tabs -->
        <div class="filter-tabs-bar" role="tablist" aria-label="Document Categories">
          <button type="button" class="filter-tab active" data-filter="all" role="tab" aria-selected="true">
            All Documents (15)
          </button>
          <button type="button" class="filter-tab" data-filter="affiliation" role="tab" aria-selected="false">
            Affiliation &amp; Approvals (5)
          </button>
          <button type="button" class="filter-tab" data-filter="safety" role="tab" aria-selected="false">
            Safety &amp; Health (4)
          </button>
          <button type="button" class="filter-tab" data-filter="governance" role="tab" aria-selected="false">
            Institutional Framework (3)
          </button>
          <button type="button" class="filter-tab" data-filter="academics" role="tab" aria-selected="false">
            Academics &amp; Outcomes (3)
          </button>
        </div>
      </div>

      <!-- Grid of 15 Requirement Cards -->
      <div class="requirements-grid">
        {cbseRequirementsData.map((doc, idx) => (
          <div 
            class="req-card" 
            data-category={doc.category} 
            data-reveal
            style={`--delay: ${(idx % 3) * 0.1}s`}
          >
            <!-- Card Header -->
            <div class="rc-header">
              <span class="rc-num">#{doc.no}</span>
              <span class="rc-tag">{doc.categoryLabel}</span>
            </div>

            <!-- Card Thumbnail with Zoom Action -->
            <div class="rc-media-wrap">
              <button 
                type="button" 
                class="rc-preview-trigger"
                data-modal-type={doc.pdfUrl ? 'pdf' : 'image'}
                data-modal-title={doc.title}
                data-modal-src={doc.pdfUrl || doc.imgSrc}
                data-modal-img={doc.imgSrc}
                data-modal-dl={doc.pdfUrl || doc.imgSrc}
                aria-label={`Preview ${doc.title}`}
              >
                <img 
                  src={doc.imgSrc} 
                  alt={doc.title} 
                  loading="lazy" 
                  decoding="async" 
                  class="rc-img" 
                />
                <div class="rc-overlay">
                  <span class="zoom-pill">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    Quick View
                  </span>
                </div>
              </button>
            </div>

            <!-- Card Info -->
            <div class="rc-body">
              <h3 class="h4 rc-title">{doc.title}</h3>
              <p class="rc-auth">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {doc.authority}
              </p>
              <p class="rc-desc">{doc.description}</p>
            </div>

            <!-- Card Footer / Action Buttons -->
            <div class="rc-footer">
              {doc.pageUrl ? (
                <a href={doc.pageUrl} class="rc-btn-page">
                  <span>View Details</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
              ) : (
                <div class="rc-dual-actions">
                  <button 
                    type="button" 
                    class="rc-btn-view"
                    data-modal-type="pdf"
                    data-modal-title={doc.title}
                    data-modal-src={doc.pdfUrl || doc.imgSrc}
                    data-modal-dl={doc.pdfUrl}
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    Preview
                  </button>
                  <a 
                    href={doc.pdfUrl || doc.imgSrc} 
                    download 
                    class="rc-btn-dl"
                    aria-label={`Download ${doc.title}`}
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    <span>PDF</span>
                  </a>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- Official CBSE Regulatory Summary Table -->
      <section id="compliance-table" class="compliance-table-section" data-reveal>
        <div class="table-section-head">
          <div>
            <div class="section-pill">VERIFICATION MATRIX</div>
            <h2 class="h3 matrix-title">CBSE Institutional Requirements Checklist</h2>
            <p class="matrix-desc">Comprehensive index of all 15 accreditations and official records for public verification.</p>
          </div>
          <a href="/mandatory-public-disclosure" class="disclosure-nav-pill">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            Mandatory Public Disclosure
          </a>
        </div>

        <div class="table-responsive standard-table-box">
          <table class="compliance-table">
            <thead>
              <tr>
                <th scope="col" style="width: 70px;">SL. NO</th>
                <th scope="col" style="width: 32%;">REQUIREMENT / DOCUMENT</th>
                <th scope="col" style="width: 25%;">ISSUING AUTHORITY</th>
                <th scope="col">CATEGORY</th>
                <th scope="col" style="text-align: right; width: 180px;">ACTION</th>
              </tr>
            </thead>
            <tbody>
              {cbseRequirementsData.map(item => (
                <tr>
                  <td class="td-num">#{item.no}</td>
                  <td class="td-doc">
                    <strong class="doc-name">{item.title}</strong>
                    <span class="doc-sub">{item.description}</span>
                  </td>
                  <td class="td-auth">
                    <span>{item.authority}</span>
                  </td>
                  <td class="td-cat">
                    <span class="cat-pill">{item.categoryLabel}</span>
                  </td>
                  <td class="td-action">
                    {item.pageUrl ? (
                      <a href={item.pageUrl} class="tbl-action-btn">
                        <span>View Page</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                      </a>
                    ) : (
                      <div class="tbl-action-duo">
                        <button 
                          type="button" 
                          class="tbl-action-btn"
                          data-modal-type="pdf"
                          data-modal-title={item.title}
                          data-modal-src={item.pdfUrl || item.imgSrc}
                          data-modal-dl={item.pdfUrl}
                        >
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                          View
                        </button>
                        <a href={item.pdfUrl || item.imgSrc} download class="tbl-dl-btn" aria-label={`Download ${item.title}`}>
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        </a>
                      </div>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

    </div>
  </main>

  <!-- Interactive Document Preview / Lightbox Modal -->
  <div id="cbse-modal" class="cbse-modal" aria-hidden="true" role="dialog" aria-labelledby="cbse-modal-title">
    <div class="modal-backdrop" id="cbse-modal-backdrop"></div>
    <div class="modal-container">
      <!-- Modal Header -->
      <div class="modal-header">
        <div class="modal-header-info">
          <span class="modal-tag">CBSE STATUTORY COMPLIANCE DOCUMENT</span>
          <h3 id="cbse-modal-title" class="modal-title">Document Inspection</h3>
        </div>
        <div class="modal-actions">
          <a id="cbse-modal-dl" href="#" download class="modal-btn" title="Download Document">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span class="sr-only">Download</span>
          </a>
          <a id="cbse-modal-newtab" href="#" target="_blank" rel="noopener noreferrer" class="modal-btn" title="Open in New Tab">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            <span class="sr-only">Open Tab</span>
          </a>
          <button type="button" id="cbse-modal-close" class="modal-close-btn" aria-label="Close Preview">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
      </div>

      <!-- Modal Body -->
      <div class="modal-body">
        <!-- PDF Viewer Frame -->
        <div id="pdf-view-wrapper" class="modal-view-panel">
          <iframe id="cbse-modal-iframe" src="" title="PDF Viewer"></iframe>
        </div>
        <!-- High-res Image Lightbox View -->
        <div id="img-view-wrapper" class="modal-view-panel" style="display: none;">
          <img id="cbse-modal-image" src="" alt="Certificate Document" class="modal-img-preview" />
        </div>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Category Filtering
    const tabs = document.querySelectorAll('.filter-tab');
    const cards = document.querySelectorAll('.req-card');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const filter = tab.getAttribute('data-filter');
        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // 2. Interactive Document Modal
    const modal = document.getElementById('cbse-modal');
    const modalBackdrop = document.getElementById('cbse-modal-backdrop');
    const modalClose = document.getElementById('cbse-modal-close');
    const modalTitle = document.getElementById('cbse-modal-title');
    const modalIframe = document.getElementById('cbse-modal-iframe');
    const modalImg = document.getElementById('cbse-modal-image');
    const pdfPanel = document.getElementById('pdf-view-wrapper');
    const imgPanel = document.getElementById('img-view-wrapper');
    const modalDl = document.getElementById('cbse-modal-dl');
    const modalNewTab = document.getElementById('cbse-modal-newtab');

    function openModal(type, title, src, dlUrl, imgBackup) {
      if (!modal) return;
      if (modalTitle) modalTitle.textContent = title || 'Document Inspection';
      if (modalDl) modalDl.href = dlUrl || src;
      if (modalNewTab) modalNewTab.href = src;

      if (type === 'pdf' && src.endsWith('.pdf')) {
        if (pdfPanel) pdfPanel.style.display = 'block';
        if (imgPanel) imgPanel.style.display = 'none';
        if (modalIframe) modalIframe.src = src;
      } else {
        // Image preview
        if (pdfPanel) pdfPanel.style.display = 'none';
        if (imgPanel) imgPanel.style.display = 'flex';
        if (modalImg) modalImg.src = imgBackup || src;
      }

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      if (modalIframe) modalIframe.src = '';
      if (modalImg) modalImg.src = '';
      document.body.style.overflow = '';
    }

    document.querySelectorAll('[data-modal-src]').forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const type = trigger.getAttribute('data-modal-type') || 'pdf';
        const title = trigger.getAttribute('data-modal-title');
        const src = trigger.getAttribute('data-modal-src');
        const dlUrl = trigger.getAttribute('data-modal-dl');
        const imgBackup = trigger.getAttribute('data-modal-img');
        openModal(type, title, src, dlUrl, imgBackup);
      });
    });

    if (modalClose) modalClose.addEventListener('click', closeModal);
    if (modalBackdrop) modalBackdrop.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && modal.classList.contains('is-open')) {
        closeModal();
      }
    });
  });
</script>

<style>
  /* =========================================================
     HERO SECTION
     ========================================================= */
  .page-hero {
    position: relative;
    min-height: clamp(520px, 68vh, 720px);
    display: flex;
    align-items: flex-end;
    color: #fff;
    overflow: hidden;
    isolation: isolate;
    background: #0b0d10;
  }
  .ph-media {
    position: absolute;
    inset: -10% 0;
    z-index: -2;
  }
  .ph-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.75);
  }
  .ph-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgba(8, 10, 13, 0.88) 0%,
      rgba(8, 10, 13, 0.65) 45%,
      rgba(8, 10, 13, 0.96) 100%
    );
  }
  .ph-inner {
    padding-top: calc(var(--header-h) + 60px);
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.68);
  }
  .breadcrumb a {
    color: rgba(255, 255, 255, 0.88);
    text-decoration: none;
    transition: color 0.2s;
  }
  .breadcrumb a:hover {
    color: var(--gold);
  }
  .crumb-current {
    color: var(--gold);
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
  }
  .badge-pill {
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.18);
  }
  .badge-gold {
    background: rgba(197, 160, 89, 0.2);
    color: var(--gold);
    border-color: rgba(197, 160, 89, 0.5);
  }

  .ph-title {
    color: #fff;
    max-width: 20ch;
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.1;
  }
  .ph-title :global(em) {
    color: var(--gold);
    font-style: normal;
  }
  .ph-subtitle {
    color: rgba(255, 255, 255, 0.88);
    max-width: 75ch;
    margin: 0;
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin-top: 0.5rem;
  }
  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.75rem 1.6rem;
    border-radius: 999px;
    background: var(--gold);
    color: #101216;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn-hero-primary:hover {
    background: #0B0D12;
    color: #FFFFFF;
    transform: translateY(-2px);
  }
  .btn-hero-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.75rem 1.6rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #fff;
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    backdrop-filter: blur(8px);
    transition: all 0.2s ease;
  }
  .btn-hero-ghost:hover {
    background: #FFFFFF;
    color: #101216;
    border-color: #FFFFFF;
    transform: translateY(-2px);
  }
  .btn-hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--gold);
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    transition: color 0.2s;
  }
  .btn-hero-link:hover {
    text-decoration: underline;
    color: #fff;
  }

  /* =========================================================
     HIGHLIGHTS STRIP
     ========================================================= */
  .highlights-bar {
    background: var(--bg-alt);
    border-bottom: 1px solid var(--line);
    padding-block: 2rem;
  }
  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }
  .highlight-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.02);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .highlight-item:hover {
    transform: translateY(-2px);
    border-color: var(--gold);
  }
  .hl-label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }
  .hl-val {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .hl-sub {
    font-size: 0.82rem;
    color: var(--gold-text);
    font-weight: 600;
  }

  /* =========================================================
     MAIN SECTION
     ========================================================= */
  .main-section {
    padding-block: clamp(3.5rem, 6vw, 6rem);
    background: var(--bg);
  }
  .req-wrapper {
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
  }

  .section-intro {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .section-pill {
    display: inline-block;
    width: fit-content;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--gold-text);
    text-transform: uppercase;
    background: rgba(197, 160, 89, 0.12);
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    margin-bottom: 0.4rem;
  }
  .sec-title {
    color: var(--ink);
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
  }
  .sec-desc {
    color: var(--muted);
    margin: 0.5rem 0 0 0;
