---

<Layout 
  title="Board Results - Don Bosco English Medium School Shirva"
  description="CBSE Board Exam results for Class 10 (AISSE) and Class 12 (AISSCE) batches at Don Bosco English Medium School Shirva. Celebrating academic excellence and 100% pass rates."
>
  <Header />

  <!-- Page Hero -->
  <section class="page-hero on-image">
    <div class="ph-media" data-parallax="-0.12">
      <img src="/about/old-school.jpg" alt="Don Bosco School Shirva" fetchpriority="high" />
    </div>
    <div class="ph-shade" aria-hidden="true"></div>
    <div class="container ph-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb" data-reveal="fade">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>Academics</span>
        <span aria-hidden="true">/</span>
        <span aria-current="page" class="crumb-current">Board Results</span>
      </nav>
      <h1 class="h1 ph-title" data-split>Board <em>Results</em></h1>
    </div>
  </section>

  <!-- Main Content -->
  <main class="inner-main section" id="results-content">
    <div class="container">
      
      <!-- Intro Section -->
      <header class="intro-section" data-reveal>
        <div class="badge-pill">
          <span class="badge-dot"></span>
          Academic Milestones
        </div>
        <h2 class="h2 intro-title">
          Congratulations to the students on achieving success in the CBSE Board Exams!
        </h2>
        <p class="intro-desc">
          We applaud the relentless dedication of our students, the guidance of our esteemed faculty, and the unwavering encouragement of parents. Don Bosco English Medium School proudly upholds a glorious legacy of 100% pass results in CBSE Board Examinations.
        </p>

        <!-- Stats highlights -->
        <div class="stats-row">
          <div class="stat-item">
            <span class="stat-number">100%</span>
            <span class="stat-label">Pass Percentage</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-number">Class X & XII</span>
            <span class="stat-label">CBSE Affiliation</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-number">Multiple</span>
            <span class="stat-label">Distinctions & Centums</span>
          </div>
        </div>
      </header>

      <!-- Tabs Component -->
      <section class="results-showcase" aria-label="Board Results by Batch">
        <div class="tabs-container" data-reveal="fade">
          <div class="tab-nav-wrapper">
            <div class="tab-nav" role="tablist" aria-label="Class selection tabs">
              <button 
                type="button" 
                class="tab-btn is-active" 
                role="tab" 
                id="tab-btn-10" 
                aria-selected="true" 
                aria-controls="tab-panel-10"
                data-tab="class-10"
              >
                <span class="tab-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                    <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                  </svg>
                </span>
                <span class="tab-title">Class 10 Batch</span>
                <span class="tab-count">{class10Batches.length} Batches</span>
              </button>

              <button 
                type="button" 
                class="tab-btn" 
                role="tab" 
                id="tab-btn-12" 
                aria-selected="false" 
                aria-controls="tab-panel-12"
                data-tab="class-12"
              >
                <span class="tab-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8" r="7"/>
                    <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>
                  </svg>
                </span>
                <span class="tab-title">Class 12 Batch</span>
                <span class="tab-count">{class12Batches.length} Batches</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Tab Panels -->
        <div class="tab-panels-wrapper">
          
          <!-- Class 10 Panel -->
          <div 
            class="tab-panel is-active" 
            role="tabpanel" 
            id="tab-panel-10" 
            aria-labelledby="tab-btn-10"
            data-panel="class-10"
          >
            <div class="panel-header">
              <div class="panel-header-info">
                <span class="panel-tag">Secondary School Examination (AISSE)</span>
                <h3 class="panel-title">All India Secondary School Examination (Class X)</h3>
              </div>
              <span class="panel-note">Showing all {class10Batches.length} recorded academic batches</span>
            </div>

            <div class="results-list">
              {class10Batches.map((batch, bIdx) => (
                <article class="batch-card" data-reveal="slide-up" style={`--delay: ${bIdx * 0.05}s`}>
                  <div class="batch-card-header">
                    <div class="batch-title-group">
                      <span class="batch-pill">{batch.exam}</span>
                      <h4 class="batch-year">{batch.year}</h4>
                    </div>
                    <div class="batch-status-badge">
                      <span class="badge-icon">✓</span>
                      <span>100% Pass Result</span>
                    </div>
                  </div>

                  {batch.description && (
                    <p class="batch-desc">{batch.description}</p>
                  )}

                  <div class:list={['batch-media-grid', { 'is-multi': batch.images.length > 1 }]}>
                    {batch.images.map((img) => (
                      <figure class="media-figure">
                        <button 
                          type="button" 
                          class="media-zoom-trigger" 
                          data-lightbox-trigger
                          data-img-src={img.src}
                          data-img-alt={img.alt}
                          data-img-caption={`${batch.year} - ${img.label}`}
                          aria-label={`Enlarge result banner for ${batch.year} (${img.label})`}
                        >
                          <img 
                            src={img.src} 
                            alt={img.alt} 
                            loading="lazy" 
                            decoding="async" 
                            class="batch-image" 
                          />
                          <span class="zoom-hover-overlay" aria-hidden="true">
                            <span class="zoom-btn-icon">
                              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                <line x1="11" y1="8" x2="11" y2="14"></line>
                                <line x1="8" y1="11" x2="14" y2="11"></line>
                              </svg>
                            </span>
                            <span class="zoom-text">Click to View Full Resolution</span>
                          </span>
                        </button>
                        <figcaption class="media-caption">
                          <span class="caption-bullet"></span>
                          <span>{img.label}</span>
                        </figcaption>
                      </figure>
                    ))}
                  </div>
                </article>
              ))}
            </div>
          </div>

          <!-- Class 12 Panel -->
          <div 
            class="tab-panel" 
            role="tabpanel" 
            id="tab-panel-12" 
            aria-labelledby="tab-btn-12"
            data-panel="class-12"
            hidden
          >
            <div class="panel-header">
              <div class="panel-header-info">
                <span class="panel-tag">Senior School Certificate Examination (AISSCE)</span>
                <h3 class="panel-title">All India Senior School Certificate Examination (Class XII)</h3>
              </div>
              <span class="panel-note">Showing all {class12Batches.length} recorded academic batches</span>
            </div>

            <div class="results-list">
              {class12Batches.map((batch, bIdx) => (
                <article class="batch-card" data-reveal="slide-up" style={`--delay: ${bIdx * 0.05}s`}>
                  <div class="batch-card-header">
                    <div class="batch-title-group">
                      <span class="batch-pill">{batch.exam}</span>
                      <h4 class="batch-year">{batch.year}</h4>
                    </div>
                    <div class="batch-status-badge">
                      <span class="badge-icon">✓</span>
                      <span>100% Pass Result</span>
                    </div>
                  </div>

                  {batch.description && (
                    <p class="batch-desc">{batch.description}</p>
                  )}

                  <div class:list={['batch-media-grid', { 'is-multi': batch.images.length > 1 }]}>
                    {batch.images.map((img) => (
                      <figure class="media-figure">
                        <button 
                          type="button" 
                          class="media-zoom-trigger" 
                          data-lightbox-trigger
                          data-img-src={img.src}
                          data-img-alt={img.alt}
                          data-img-caption={`${batch.year} - ${img.label}`}
                          aria-label={`Enlarge result banner for ${batch.year} (${img.label})`}
                        >
                          <img 
                            src={img.src} 
                            alt={img.alt} 
                            loading="lazy" 
                            decoding="async" 
                            class="batch-image" 
                          />
                          <span class="zoom-hover-overlay" aria-hidden="true">
                            <span class="zoom-btn-icon">
                              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                <line x1="11" y1="8" x2="11" y2="14"></line>
                                <line x1="8" y1="11" x2="14" y2="11"></line>
                              </svg>
                            </span>
                            <span class="zoom-text">Click to View Full Resolution</span>
                          </span>
                        </button>
                        <figcaption class="media-caption">
                          <span class="caption-bullet"></span>
                          <span>{img.label}</span>
                        </figcaption>
                      </figure>
                    ))}
                  </div>
                </article>
              ))}
            </div>
          </div>

        </div>
      </section>

    </div>
  </main>

  <!-- Interactive Lightbox Modal -->
  <dialog class="lightbox-modal" id="results-lightbox" aria-label="Board Result Banner Viewer" data-lenis-prevent>
    <div class="lightbox-backdrop" data-lightbox-close></div>
    <div class="lightbox-window">
      <header class="lightbox-bar">
        <span class="lightbox-title" id="lightbox-caption">Board Results</span>
        <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close modal">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </header>
      <div class="lightbox-content">
        <img src="" alt="" id="lightbox-img" class="lightbox-image" />
      </div>
    </div>
  </dialog>

  <Footer />
</Layout>

<script>
  // Tab Switcher Logic with URL Hash & History Support
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const tabPanels = document.querySelectorAll<HTMLElement>('.tab-panel');

  const switchTab = (targetId: string, updateUrl = true) => {
    tabBtns.forEach((btn) => {
      const isTarget = btn.getAttribute('data-tab') === targetId;
      btn.classList.toggle('is-active', isTarget);
      btn.setAttribute('aria-selected', String(isTarget));
    });

    tabPanels.forEach((panel) => {
      const isTarget = panel.getAttribute('data-panel') === targetId;
      panel.classList.toggle('is-active', isTarget);
      if (isTarget) {
        panel.removeAttribute('hidden');
      } else {
        panel.setAttribute('hidden', '');
      }
    });

    if (updateUrl && history.replaceState) {
      const url = new URL(window.location.href);
      url.hash = targetId;
      history.replaceState(null, '', url.toString());
    }
  };

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-tab');
      if (target) switchTab(target);
    });
  });

  // Handle URL hash on initial load
  const initialHash = window.location.hash.replace('#', '');
  if (initialHash === 'class-12' || initialHash === 'class-10') {
    switchTab(initialHash, false);
  }

  // Lightbox Modal Functionality
  const modal = document.querySelector<HTMLDialogElement>('#results-lightbox');
  const lightboxImg = document.querySelector<HTMLImageElement>('#lightbox-img');
  const lightboxCaption = document.querySelector<HTMLElement>('#lightbox-caption');
  const triggerBtns = document.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]');
  const closeElements = document.querySelectorAll<HTMLElement>('[data-lightbox-close]');

  const openLightbox = (src: string, alt: string, caption: string) => {
    if (!modal || !lightboxImg) return;
    lightboxImg.src = src;
    lightboxImg.alt = alt;
    if (lightboxCaption) lightboxCaption.textContent = caption;
    
    if (typeof modal.showModal === 'function') {
      modal.showModal();
    } else {
      modal.setAttribute('open', '');
    }
    document.body.style.overflow = 'hidden';
  };

  const closeLightbox = () => {
    if (!modal) return;
    if (typeof modal.close === 'function') {
      modal.close();
    } else {
      modal.removeAttribute('open');
    }
    if (lightboxImg) lightboxImg.src = '';
    document.body.style.overflow = '';
  };

  triggerBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.getAttribute('data-img-src') || '';
      const alt = btn.getAttribute('data-img-alt') || '';
      const caption = btn.getAttribute('data-img-caption') || '';
      openLightbox(src, alt, caption);
    });
  });

  closeElements.forEach((el) => {
    el.addEventListener('click', closeLightbox);
  });

  modal?.addEventListener('cancel', (e) => {
    e.preventDefault();
    closeLightbox();
  });
</script>

<style>
  /* Hero Styles */
  .page-hero {
    position: relative;
    min-height: clamp(460px, 62vh, 640px);
    display: flex;
    align-items: flex-end;
    color: #fff;
    overflow: hidden;
    isolation: isolate;
    background: #0b0d10;
  }
  .ph-media {
    position: absolute;
    inset: -10% 0;
    z-index: -2;
  }
  .ph-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: phZoom 2.2s var(--ease) both;
  }
  @keyframes phZoom {
    from { transform: scale(1.12); }
    to { transform: scale(1); }
  }
  .ph-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(8,10,13,.78) 0%, rgba(8,10,13,.55) 45%, rgba(8,10,13,.92) 100%);
  }
  .ph-inner {
    padding-top: calc(var(--header-h) + 90px);
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .6rem;
    font-size: .8rem;
    font-weight: 600;
    letter-spacing: .04em;
    color: rgba(255,255,255,.6);
  }
  .breadcrumb a {
    color: rgba(255,255,255,.85);
    transition: color .2s;
    min-height: 32px;
    display: inline-flex;
    align-items: center;
  }
  .breadcrumb a:hover {
    color: var(--gold);
  }
  .crumb-current {
    color: var(--gold);
  }
  .ph-title {
    color: #fff;
    max-width: 18ch;
    text-transform: uppercase;
  }
  .ph-title :global(em) {
    color: var(--gold);
  }

  /* Main Section */
  .inner-main {
    width: 100%;
    overflow-x: clip;
    padding-block: clamp(3.5rem, 7vw, 6rem);
    background: var(--bg-alt);
    transition: background-color .4s var(--ease);
  }

  /* Intro Section */
  .intro-section {
    text-align: center;
    max-width: 900px;
    margin-inline: auto;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: var(--r-pill);
    background: rgba(255, 182, 6, 0.12);
    border: 1px solid rgba(255, 182, 6, 0.3);
    color: var(--gold-text);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }
  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 10px var(--gold);
  }

  .intro-title {
    margin-bottom: 1.25rem;
    color: var(--ink);
    font-size: clamp(1.8rem, 3.5vw, 2.75rem);
    line-height: 1.25;
    font-weight: 600;
  }
  :global([data-theme="dark"]) .intro-title {
    color: #F1EEE7;
  }

  .intro-desc {
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.75;
    color: var(--muted);
    max-width: 780px;
  }

  /* Stats Row */
  .stats-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1.5rem, 3vw, 3rem);
    margin-top: 2.5rem;
    padding: 1.25rem clamp(1.5rem, 4vw, 3rem);
    background: var(--surface);
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    width: 100%;
    max-width: 760px;
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }
  .stat-number {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    font-weight: 600;
    color: var(--gold-text);
    line-height: 1.1;
  }
  .stat-label {
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .stat-divider {
    width: 1px;
    height: 38px;
    background: var(--line);
  }

  /* Tab Navigation */
  .results-showcase {
    max-width: 1140px;
    margin-inline: auto;
  }
  .tab-nav-wrapper {
    display: flex;
    justify-content: center;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .tab-nav {
    display: inline-flex;
    background: var(--surface);
    padding: 0.45rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow-sm);
    gap: 0.5rem;
