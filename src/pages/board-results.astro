    exam: 'CBSE Class X (AISSE)',
    title: 'Batch 2023 – 2024',
    description: 'Congratulations to our students on securing outstanding results and carrying forward our tradition of 100% excellence in the CBSE Class X examinations.',
    images: [
      {
        src: '/board-results/class-10/2023-2024.jpg',
        alt: 'Don Bosco Shirva CBSE Class X Board Results 2023 - 2024',
        label: 'Result Felicitation & Toppers'
      }
    ]
  },
  {
