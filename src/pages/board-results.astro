const class12Batches: BatchResult[] = [
  {
    year: '2023 – 2024',
    exam: 'CBSE Class XII (AISSCE)',
    title: 'Batch 2023 – 2024',
    description: 'Hearty congratulations to the Senior Secondary Class XII batch for stellar performance in the CBSE AISSCE examinations.',
    images: [
      {
        src: '/board-results/class-12/2023-2024.jpg',
