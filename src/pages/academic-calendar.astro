---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Academic Calendar - Don Bosco English Medium School Shirva";
const description = "View and download the official Academic Calendar of Don Bosco English Medium School Shirva. Comprehensive schedule of term dates, examinations, holidays, and school activities.";
---

<Layout title={title} description={description}>
  <Header />

  <!-- Page Hero -->
  <section class="page-hero on-image">
    <div class="ph-media" data-parallax="-0.12">
      <img src="/hero_new.jpg" alt="" fetchpriority="high" />
    </div>
    <div class="ph-shade" aria-hidden="true"></div>
    <div class="container ph-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb" data-reveal="fade">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span class="crumb-parent">Academics</span>
        <span aria-hidden="true">/</span>
        <span aria-current="page" class="crumb-current">Academic Calendar</span>
      </nav>
      <div class="ph-badge" data-reveal="fade">
        <span class="badge-dot"></span>
        Official Academic Schedule
      </div>
      <h1 class="h1 ph-title" data-split>Academic <em>Calendar</em></h1>
      <p class="ph-sub" data-reveal="fade">Complete scholastic timeline, examination schedules, public holidays, and campus events.</p>
    </div>
  </section>

  <main id="main-content" class="calendar-main">
    <!-- Intro Card -->
    <section class="calendar-intro-sec">
      <div class="container">
        <div class="intro-glass-card" data-reveal="fade-up">
          <div class="intro-left">
            <div class="intro-kicker">
              <span class="kicker-icon">📅</span>
              <span>Annual Scholastic Planner</span>
            </div>
            <h2 class="h2 intro-heading">School Academic Calendar</h2>
            <p class="intro-desc">
              The official academic calendar provides students, parents, and educators with essential schedules, including term commencement dates, internal assessments, CBSE periodic tests, term examinations, and vacation schedules.
            </p>
            <div class="intro-actions">
              <a href="/academic-calendar.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-gold">
                <span>View Full PDF in New Tab</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
              <a href="/academic-calendar.pdf" download="Don-Bosco-Shirva-Academic-Calendar.pdf" class="btn btn-outline-dark">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span>Download Calendar (PDF • 2.3 MB)</span>
              </a>
            </div>
          </div>
          <div class="intro-stats">
            <div class="stat-box">
              <span class="stat-number">2024–25</span>
              <span class="stat-label">Academic Year</span>
            </div>
            <div class="stat-box">
              <span class="stat-number">PDF</span>
              <span class="stat-label">Format</span>
            </div>
            <div class="stat-box">
              <span class="stat-number">2.3 MB</span>
              <span class="stat-label">File Size</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Embedded PDF Viewer -->
    <section class="viewer-sec">
      <div class="container">
        <div class="viewer-container" data-reveal="fade-up">
          <div class="viewer-toolbar">
            <div class="toolbar-title">
              <span class="doc-icon">📄</span>
              <span>Official Academic Calendar Document</span>
            </div>
            <div class="toolbar-actions">
              <a href="/academic-calendar.pdf" target="_blank" rel="noopener noreferrer" class="tb-btn" title="Open in new window">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
                <span>Fullscreen Tab</span>
              </a>
              <a href="/academic-calendar.pdf" download="Don-Bosco-Shirva-Academic-Calendar.pdf" class="tb-btn" title="Download PDF">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span>Download</span>
              </a>
            </div>
          </div>
          <div class="viewer-frame-wrap">
            <iframe 
              src="/academic-calendar.pdf" 
              title="Don Bosco English Medium School Academic Calendar"
              class="calendar-iframe"
            ></iframe>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* Base & Hero */
  .page-hero {
    position: relative;
    padding: 7rem 0 3.5rem;
    overflow: hidden;
    color: #ffffff;
    min-height: 380px;
    display: flex;
    align-items: center;
  }
  .ph-media {
    position: absolute;
    inset: -10% 0;
    z-index: 0;
  }
  .ph-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .ph-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(16, 24, 40, 0.94) 0%, rgba(26, 32, 44, 0.88) 60%, rgba(10, 15, 30, 0.94) 100%);
    z-index: 1;
  }
  .ph-inner {
    position: relative;
    z-index: 2;
    max-width: 900px;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 1.25rem;
  }
  .breadcrumb a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .breadcrumb a:hover {
    color: #ffb606;
  }
  .crumb-parent {
    color: rgba(255, 255, 255, 0.85);
  }
  .crumb-current {
    color: #ffb606;
    font-weight: 600;
  }
  .ph-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: rgba(255, 182, 6, 0.15);
    border: 1px solid rgba(255, 182, 6, 0.4);
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #ffb606;
    margin-bottom: 1rem;
    backdrop-filter: blur(4px);
  }
  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #ffb606;
    box-shadow: 0 0 8px #ffb606;
  }
  .ph-title {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 0.85rem;
    color: #ffffff;
    letter-spacing: -0.02em;
  }
  .ph-title em {
    font-style: normal;
    color: #ffb606;
    background: linear-gradient(135deg, #ffd066 0%, #ffb606 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .ph-sub {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
    max-width: 650px;
    line-height: 1.6;
  }

  /* Intro Section */
  .calendar-main {
    background: var(--bg-surface, #f8fafc);
    color: var(--text-color, #1e293b);
    padding-bottom: 5rem;
  }
  .calendar-intro-sec {
    margin-top: -2.5rem;
    position: relative;
    z-index: 10;
    margin-bottom: 2.5rem;
  }
  .intro-glass-card {
    background: var(--card-bg, #ffffff);
    border: 1px solid var(--border-color, rgba(226, 232, 240, 0.8));
    border-radius: 1.25rem;
    padding: 2.25rem;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.07);
    display: grid;
    grid-template-columns: 1.8fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .intro-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #d97706;
    margin-bottom: 0.5rem;
  }
  .intro-heading {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 800;
    color: var(--heading-color, #0f172a);
    margin: 0 0 0.75rem;
    line-height: 1.25;
  }
  .intro-desc {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text-muted, #475569);
    margin: 0 0 1.5rem;
  }
  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }
  .intro-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    background: var(--stat-bg, #f8fafc);
    padding: 1.5rem 1rem;
    border-radius: 1rem;
    border: 1px solid rgba(226, 232, 240, 0.6);
  }
  .stat-box {
    text-align: center;
  }
  .stat-number {
    display: block;
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.1;
    margin-bottom: 0.25rem;
  }
  .stat-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #64748b;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.65rem 1.25rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn-gold {
    background: #ffb606 !important;
    color: #101216 !important;
    border: 1px solid #ffb606 !important;
    box-shadow: 0 4px 12px rgba(255, 182, 6, 0.3);
  }
  .btn-gold:hover, .btn-gold:focus-visible {
    background: #0B0D12 !important;
    color: #ffffff !important;
    border-color: #0B0D12 !important;
    transform: translateY(-2px);
  }
  .btn-gold:hover * {
    color: #ffffff !important;
  }
  :global([data-theme="dark"]) .btn-gold:hover,
  :global([data-theme="dark"]) .btn-gold:focus-visible {
    background: #ffffff !important;
    color: #0b0c0f !important;
    border-color: #ffffff !important;
  }
  :global([data-theme="dark"]) .btn-gold:hover * {
    color: #0b0c0f !important;
  }

  .btn-outline-dark {
    background: #ffffff !important;
    color: #101216 !important;
    border: 1px solid rgba(16, 18, 22, 0.22) !important;
  }
  .btn-outline-dark:hover, .btn-outline-dark:focus-visible {
    background: #101216 !important;
    color: #ffffff !important;
    border-color: #101216 !important;
  }
  .btn-outline-dark:hover * {
    color: #ffffff !important;
  }
  :global([data-theme="dark"]) .btn-outline-dark {
    background: rgba(255, 255, 255, 0.06) !important;
    color: #f1eee7 !important;
    border-color: rgba(255, 255, 255, 0.2) !important;
  }
  :global([data-theme="dark"]) .btn-outline-dark:hover,
  :global([data-theme="dark"]) .btn-outline-dark:focus-visible {
    background: #ffb606 !important;
    color: #0b0c0f !important;
    border-color: #ffb606 !important;
  }
  :global([data-theme="dark"]) .btn-outline-dark:hover * {
    color: #0b0c0f !important;
  }

  /* PDF Viewer Box */
  .viewer-container {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.15);
  }
  .viewer-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    background: #1e293b;
    color: #ffffff;
    border-bottom: 1px solid #334155;
    gap: 1rem;
  }
  .toolbar-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9375rem;
    font-weight: 700;
  }
  .toolbar-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .tb-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 36px;
    padding: 0.4rem 0.85rem;
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border-radius: 6px;
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s;
  }
  .tb-btn:hover {
    background: rgba(255, 255, 255, 0.2);
  }
  .viewer-frame-wrap {
    width: 100%;
    height: 850px;
    background: #334155;
  }
  .calendar-iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  /* Responsive Design */
  @media (max-width: 992px) {
    .intro-glass-card {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      padding: 1.75rem;
    }
    .intro-stats {
      margin-top: 0.5rem;
    }
    .viewer-frame-wrap {
      height: 650px;
    }
  }

  @media (max-width: 768px) {
    .page-hero {
      padding: 5.5rem 0 2.5rem;
      min-height: 320px;
    }
    .calendar-intro-sec {
      margin-top: -1.75rem;
    }
    .intro-actions {
      flex-direction: column;
    }
    .btn {
      width: 100%;
    }
    .viewer-frame-wrap {
      height: 500px;
    }
    .tb-btn span {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .intro-stats {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .viewer-frame-wrap {
      height: 420px;
    }
  }

  /* Dark mode */
  :global([data-theme="dark"]) .calendar-main {
    background: #090d16;
  }
  :global([data-theme="dark"]) .intro-glass-card {
    background: #111827;
    border-color: #1f2937;
  }
  :global([data-theme="dark"]) .intro-heading,
  :global([data-theme="dark"]) .stat-number {
    color: #f9fafb;
  }
  :global([data-theme="dark"]) .intro-desc {
    color: #cbd5e1;
  }
  :global([data-theme="dark"]) .intro-stats,
  :global([data-theme="dark"]) .btn-outline-dark {
    background: #1a2234;
    border-color: #2d3748;
    color: #e2e8f0;
  }
</style>
