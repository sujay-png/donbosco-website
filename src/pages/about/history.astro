---
import Layout from '../../layouts/Layout.astro';
import PageLayout from '../../components/PageLayout.astro';

const milestones = [
  { year: '1983', text: 'English Medium School founded in Shirva under Late Very Rev. Fr Aloysius Rosario.' },
  { year: '1992', text: 'Fr Sylvester Dsouza expands the school’s reach by establishing new sections.' },
  { year: '2016', text: 'Strategic leap under V. Rev. Fr. Stany Tauro — shift from State Board to CBSE.' },
  { year: '2018', text: 'Successful CBSE affiliation.' },
  { year: '2022', text: 'Rev Fr Rolwyn Joy Aranha takes charge as Principal.' },
];

const principals = [
  { name: 'Mrs Irine Rodrigues', years: '1983 – 2016', img: '/about/principal-1.jpg' },
  { name: 'Mrs Juliet Gretta Noronha', years: '1998 – 2016', img: '/about/principal-2.jpg' },
  { name: 'Rev Fr Mahesh Dsouza', years: '2016 – 2019', img: '/about/principal-3.jpg' },
  { name: 'Ms Myrtle L F Lewis', years: '2019 – 2022', img: '/about/principal-4.jpg' },
  { name: 'Rev Fr Rolwyn Joy Aranha', years: '2022 – Present', img: '/about/principal-photo.jpg', current: true },
];

const eca = ['/about/eca-1.jpg', '/about/eca-2.jpg', '/about/eca-3.jpg', '/about/eca-4.jpg', '/about/eca-5.jpg', '/about/eca-6.jpg'];
---

<Layout title="History – Don Bosco School Shirva">
  <PageLayout title="Our <span>History</span>" subtitle="Since 1983" breadcrumb="About Us" currentPage="History" image="/about/old-school.jpg">

    <!-- Intro -->
    <section class="section intro">
      <div class="container">
        <div class="intro-grid">
          <span class="year-ghost" aria-hidden="true">1983</span>
          <div class="intro-copy">
            <span class="eyebrow" data-reveal>(01) &nbsp;The Beginning</span>
            <blockquote class="h2 intro-quote" data-split>“A school’s true purpose is to foster learning, nurture growth and <em>shape futures</em>”</blockquote>
            <p class="lead" data-reveal>The year 1983 ushered a new era of growth for a serene village of Udupi district in Karnataka, Shirva as the community welcomed an English Medium School dedicated to nurturing local talent.</p>
          </div>
        </div>
        <div class="intro-media-wrap">
          <div class="media intro-media" data-reveal="clip">
            <img src="/about/old-school.jpg" alt="Don Bosco School - Old Photo" loading="lazy" data-parallax="0.08" />
          </div>
          <span class="intro-badge" data-reveal>Est. 1983</span>
        </div>
      </div>
    </section>

    <!-- Timeline -->
    <section class="timeline-sec section-tight section-alt">
      <div class="container">
        <ol class="timeline">
          {milestones.map((m, i) => (
            <li class="tl-item" data-reveal style={`--d:${i * 0.08}s`}>
              <span class="tl-dot" aria-hidden="true"></span>
              <span class="tl-year">{m.year}</span>
              <p class="tl-text">{m.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Founders -->
    <section class="section">
      <div class="container founders">
        <article class="founder">
          <div class="media founder-media" data-reveal="clip">
            <img src="/about/correspondent-1.jpg" alt="Late Very Rev. Fr Aloysius Rosario" loading="lazy" />
          </div>
          <div class="founder-body" data-reveal>
            <span class="eyebrow">The Vision</span>
            <h2 class="h2">The <em>Foundation</em></h2>
            <p class="muted">The elderly residents of Shirva longed to see their younger generations acquire the English language skills they had missed, which had hindered their own career prospects in urban centres. Their collective aspirations, efforts and resolve inspired <strong>Late Very Rev. Fr Aloysius Rosario</strong>, the founder Correspondent, to turn his own vision of establishing an English Medium School in Shirva into a reality.</p>
          </div>
        </article>

        <article class="founder is-reverse">
          <div class="media founder-media" data-reveal="clip">
            <img src="/about/correspondent-2.jpg" alt="Fr Sylvester Dsouza" loading="lazy" />
          </div>
          <div class="founder-body" data-reveal>
            <span class="eyebrow">Growth</span>
            <h2 class="h2"><em>Expansion</em></h2>
            <p class="muted">Years later in 1992 <strong>Fr Sylvester Dsouza</strong>, the Parish Priest at the time expanded the schools reach by establishing new sections. Since then successive Correspondents have steered the institution toward continued excellence. The school is currently administered by the <strong>Catholic Education Society of Udupi Diocese</strong>, functioning as a religious minority institution guided by the principles of Don Bosco and is under the gracious patronage of Our Lady of Health Church, Shirva.</p>
          </div>
        </article>
      </div>
    </section>

    <!-- Principals -->
    <section class="section section-alt">
      <div class="container">
        <div class="sec-head">
          <div class="sec-meta" data-reveal><span class="sec-index">(02)</span><span class="eyebrow">Leadership</span></div>
          <div class="sec-title-wrap"><h2 class="h2" data-split>Principals Through <em>the Years</em></h2></div>
        </div>
        <div class="people">
          {principals.map((p, i) => (
            <figure class:list={['person', { 'is-current': p.current }]} data-reveal style={`--d:${i * 0.07}s`}>
              <div class="media person-media">
                <img src={p.img} alt={p.name} loading="lazy" />
                {p.current && <span class="tag tag-gold person-tag">Current</span>}
              </div>
              <figcaption>
                <span class="person-years">{p.years}</span>
                <span class="person-name">{p.name}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- Milestones & Infrastructure -->
    <section class="section deep infra">
      <span class="ghost-word" aria-hidden="true">CBSE</span>
      <div class="container">
        <div class="sec-head">
          <div class="sec-meta" data-reveal><span class="sec-index">(03)</span><span class="eyebrow">2016 — 2018</span></div>
          <div class="sec-title-wrap">
            <h2 class="h2" data-split>Milestones &amp; <em>Infrastructure</em></h2>
            <p class="lead" data-reveal>The School Management team under the then innovative thinker Correspondent <strong>V. Rev. Fr. Stany Tauro</strong> took a strategic leap in 2016, deciding to shift from State Board to CBSE curriculum. This vision became a reality in 2018 with successful CBSE affiliation.</p>
          </div>
        </div>
        <div class="infra-grid">
          <p class="infra-text" data-reveal>Beyond academic excellence, the school’s mission is to inspire students to embrace life long learning, cultivate critical thinking and thrive as productive, responsible citizens in a rapidly evolving world. Today Don Bosco School is endowed with exemplary infrastructure, providing students with a comprehensive learning environment. The school campus features a fleet of school buses for convenient transportation, a spacious playground, expert school counsellors, a dedicated school nurse, digital fluency through computer labs, diverse perspectives through the expansive library, collaborative learning in smart classes, and advanced science labs.</p>
          <div class="infra-media">
            <div class="media" data-reveal="clip"><img src="/about/buses.jpg" alt="School Buses" loading="lazy" /></div>
            <div class="media" data-reveal="clip" style="--d:.15s"><img src="/about/kindergarten.jpg" alt="Kindergarten" loading="lazy" /></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Holistic Growth -->
    <section class="section">
      <div class="container">
        <div class="sec-head">
          <div class="sec-meta" data-reveal><span class="sec-index">(04)</span><span class="eyebrow">Beyond Academics</span></div>
          <div class="sec-title-wrap"><h2 class="h2" data-split>Holistic Growth &amp; <em>Co-Curriculars</em></h2></div>
        </div>
        <div class="two-col prose" data-reveal>
          <p>The school has been consistently demonstrating exceptional academic procures yielding outstanding results and a proven track record of educational excellence. The school curriculum integrates art and design, encouraging students to develop their drawing and crafting skills. At Don Bosco we believe education encompasses more than academics. In music students learn keyboard and guitar, cultivating creativity and fine motor skills. Participation in music and dance performances enhances stage presence and confidence. Martial arts training teaches perseverance and self discipline. Skating and adventure classes promote physical agility, team work and resilience. Visual art classes including drawing and painting foster imagination and self expression. Through these activities students develop holistic skills complementing academic learning. The stitching and craft program fosters creativity and practical knowledge.</p>
        </div>

        <div class="eca-grid">
          {eca.map((src, i) => (
            <div class:list={['media', 'eca', `eca-${i + 1}`]} data-reveal="clip" style={`--d:${(i % 3) * 0.08}s`}>
              <img src={src} alt="Co-curricular activity at Don Bosco School" loading="lazy" />
            </div>
          ))}
        </div>

        <div class="two-col prose" data-reveal>
          <p>The school is proud of a range of youth organizations like NCC, Scouts and Guides, Cubs and Bulbuls, and Bunnies which foster character, teamwork and community service. The school also nurtures diverse interest and talents through a range of vibrant clubs like Eco club, interact club, English club, Kannada club, history club, and YSM which explore new interest and passion of the students. Behind the remarkable achievements and vibrant co-curricular landscape of our school lies a dynamic team of highly skilled, passionate and dedicated teachers led by the visionary guidance of young energetic and tech-savvy Principal Rev. Fr Rolwyn Joy Aranha.</p>
        </div>
      </div>
    </section>

    <!-- Leadership + Foundation -->
    <section class="section section-alt">
      <div class="container">
        <article class="lead-card deep" data-reveal>
          <div class="lc-photo media">
            <img src="/about/principal-photo.jpg" alt="Rev. Fr Rolwyn Joy Aranha" loading="lazy" />
          </div>
          <div class="lc-body">
            <span class="eyebrow">(05) &nbsp;Today</span>
            <h2 class="h2">Visionary <em>Leadership</em></h2>
            <div class="prose">
              <p><strong>Rev. Fr Rolwyn Joy Aranha</strong>, the school Principal is a remarkable leader who brings both intelligence and dedication to his role. His deep interest in technology has been instrumental in the school's digital transformation. The school owns its own app. With the vision of modern education he has applied his tech savvy skills to upgrade and update the school's infrastructure ensuring that the students and the staffs benefit from a digital environment. His commitment to innovation and excellence has not only enhanced the learning experience but has also set the school on a progressive path inspiring all to embrace the future with confidence. Supporting him is a dedicated Vice Principal, <strong>Mrs Irene Cardoza</strong> who inspires the entire school community to embrace progress.</p>
              <p>The guidance and encouragement of the present Correspondent <strong>Very Rev. Dr Leslie Clifford Dsouza</strong> have been invaluable in empowering the Principal and Staff to work tirelessly towards the bright future of the students.</p>
            </div>
          </div>
        </article>

        <div class="foundation">
          <div class="sec-head">
            <div class="sec-meta" data-reveal><span class="sec-index">(06)</span><span class="eyebrow">Early Years</span></div>
            <div class="sec-title-wrap"><h2 class="h2" data-split>Foundation for <em>the Future</em></h2></div>
          </div>
          <div class="two-col prose cols-2" data-reveal>
            <p>The Playschool and Kindergarten section of the school are vital for laying the foundation of a student's educational journey. Here young learners are nurtured in a supportive and engaging environment where the emphasis is on fostering curiosity, creativity and early cognitive skills through interactive learning methods. Children are introduced to basic concepts in literacy and numeracy as well as essential social and economic skills.</p>
            <p>Our skilled and dedicated educators ensure that each child receives individualized attention, helping them develop a love for learning from an early age. This solid foundation supports their transition to higher grades with confidence and enthusiasm setting the stage for life long learning and academic growth. The school is committed to continuously enhancing their early childhood progress to align with the latest educational practices ensuring that every child is given best possible start.</p>
          </div>

          <div class="motto-box" data-reveal>
            <p class="motto-line">“Growing in truth and purity”</p>
            <p class="muted">Today the school has adopted to meet the changing needs technologies and cultural values. Embodying its motto, Don Bosco English Medium School continues to cultivate a community of young minds nurtured by values, knowledge and character.</p>
          </div>
        </div>
      </div>
    </section>

  </PageLayout>
</Layout>

<style>
  /* Intro */
  .intro-grid { position: relative; display: grid; grid-template-columns: 1fr; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .year-ghost {
    position: absolute; right: -2vw; top: -3rem;
    font-family: var(--font-display); font-size: clamp(8rem, 24vw, 22rem); line-height: .8;
    color: transparent; -webkit-text-stroke: 1px var(--line-strong);
    letter-spacing: -0.05em; pointer-events: none; user-select: none;
  }
  .intro-copy { position: relative; max-width: 980px; display: flex; flex-direction: column; gap: 1.75rem; }
  .intro-quote { font-style: normal; }
  .intro-copy .lead { max-width: 62ch; color: var(--muted); }
  .intro-media-wrap { position: relative; }
  .intro-media { aspect-ratio: 21 / 9; border-radius: var(--r-lg); }
  .intro-media img { height: 118%; margin-top: -9%; }
  .intro-badge {
    position: absolute; left: clamp(1rem, 3vw, 2.5rem); bottom: clamp(1rem, 3vw, 2.5rem);
    background: var(--gold); color: #101216;
    font-family: var(--font-display); font-size: clamp(1.4rem, 2.5vw, 2rem);
    padding: .7rem 1.4rem; border-radius: var(--r-pill);
  }

  /* Timeline */
  .timeline { display: grid; grid-template-columns: repeat(5, 1fr); position: relative; }
  .timeline::before { content: ""; position: absolute; left: 0; right: 0; top: 7px; height: 1px; background: var(--line-strong); }
  .tl-item { position: relative; padding: 2.25rem 1.5rem 0 0; display: flex; flex-direction: column; gap: .6rem; }
  .tl-dot { position: absolute; top: 0; left: 0; width: 15px; height: 15px; border-radius: 50%; background: var(--bg-alt); border: 1px solid var(--gold-text); }
  .tl-dot::after { content: ""; position: absolute; inset: 3px; border-radius: 50%; background: var(--gold); }
  .tl-year { font-family: var(--font-display); font-size: clamp(2rem, 3.2vw, 2.9rem); line-height: 1; letter-spacing: -0.03em; }
  .tl-text { color: var(--muted); font-size: .94rem; }

  /* Founders */
  .founders { display: flex; flex-direction: column; gap: clamp(3rem, 8vw, 7rem); }
  .founder { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr); gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .founder.is-reverse { grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); }
  .founder.is-reverse .founder-media { order: 2; }
  .founder-media { aspect-ratio: 4 / 5; border-radius: 999px 999px var(--r-lg) var(--r-lg); max-width: 420px; width: 100%; }
  .founder.is-reverse .founder-media { justify-self: end; }
  .js .founder-media[data-reveal="clip"] { clip-path: inset(100% 0 0 0 round 999px 999px var(--r-lg) var(--r-lg)); }
  .js .founder-media[data-reveal="clip"].is-in { clip-path: inset(0 0 0 0 round 999px 999px var(--r-lg) var(--r-lg)); }
  .founder-media img { object-position: top; }
  .founder-body { display: flex; flex-direction: column; gap: 1.25rem; }
  .founder-body p { font-size: 1.08rem; }

  /* People */
  .people { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1.1rem; }
  .person { margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  .person-media { aspect-ratio: 3 / 4; border-radius: var(--r); }
  .person-media img { object-position: top; filter: grayscale(.25); transition: filter .6s, transform 1s var(--ease); }
  .person:hover .person-media img { filter: none; transform: scale(1.04); }
  .person.is-current .person-media { box-shadow: 0 0 0 2px var(--gold); }
  .person.is-current .person-media img { filter: none; }
  .person-tag { position: absolute; left: .75rem; top: .75rem; }
  .person figcaption { display: flex; flex-direction: column; gap: .25rem; }
  .person-years { font-size: .74rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--gold-text); }
  .person-name { font-family: var(--font-display); font-size: 1.2rem; line-height: 1.2; }

  /* Infra */
  .infra { overflow: hidden; }
  .ghost-word {
    position: absolute; right: -2vw; bottom: -4vw;
    font-family: var(--font-display); font-size: clamp(9rem, 28vw, 26rem); line-height: .8;
    color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,.08);
    letter-spacing: -0.05em; pointer-events: none; user-select: none;
  }
  .infra .lead strong { color: var(--gold); }
  .infra-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .infra-text { color: var(--on-deep-muted); font-size: 1.05rem; }
  .infra-media { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .infra-media .media { aspect-ratio: 4 / 5; border-radius: var(--r-lg); }
  .infra-media .media:nth-child(2) { margin-top: 3rem; }

  /* Holistic */
  .two-col { max-width: 980px; margin-left: auto; }
  .two-col p { font-size: 1.06rem; }
  .cols-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .eca-grid {
    display: grid; grid-template-columns: repeat(12, 1fr); gap: .9rem;
    margin-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .eca { border-radius: var(--r); aspect-ratio: 4 / 3; }
  .eca-1 { grid-column: span 5; grid-row: span 2; aspect-ratio: auto; }
  .eca-2 { grid-column: span 4; }
  .eca-3 { grid-column: span 3; }
  .eca-4 { grid-column: span 3; }
  .eca-5 { grid-column: span 4; }
  .eca-6 { grid-column: span 12; aspect-ratio: 21 / 7; }

  /* Leadership card */
  .lead-card {
    border-radius: clamp(24px, 3vw, 36px);
    padding: clamp(1.25rem, 3vw, 2rem);
    display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(2rem, 5vw, 4rem); align-items: center;
    margin-bottom: var(--section);
  }
  .lc-photo { border-radius: var(--r-lg); aspect-ratio: 4 / 5; }
  .lc-photo img { object-position: 60% center; }
  .lc-body { display: flex; flex-direction: column; gap: 1.25rem; padding: clamp(.5rem, 2vw, 2rem) clamp(.5rem, 2vw, 2rem) clamp(.5rem, 2vw, 2rem) 0; }
  .lc-body .prose strong { color: var(--gold); }

  .motto-box {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: var(--r-lg);
    border: 1px solid var(--line-strong);
    text-align: center;
    display: flex; flex-direction: column; gap: 1.25rem; align-items: center;
    background: var(--surface);
  }
  .motto-line {
    font-family: var(--font-display); font-style: italic; font-weight: 300;
    font-size: clamp(2rem, 5vw, 4rem); line-height: 1.05; letter-spacing: -0.03em; color: var(--gold-text);
    font-variation-settings: "opsz" 144, "SOFT" 100, "WONK" 1;
  }
  .motto-box .muted { max-width: 62ch; }

  @media (max-width: 1100px) {
    .people { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 992px) {
    .timeline { grid-template-columns: 1fr; padding-left: 2rem; }
    .timeline::before { left: 7px; right: auto; top: 0; bottom: 0; width: 1px; height: auto; }
    .tl-item { padding: 0 0 2rem 0; }
    .tl-dot { left: -2rem; top: .6rem; }
    .founder, .founder.is-reverse, .infra-grid, .lead-card, .cols-2 { grid-template-columns: 1fr; }
    .founder.is-reverse .founder-media { order: 0; justify-self: start; }
    .founder-media { max-width: 340px; }
    .lc-body { padding: 0 .5rem .5rem; }
    .lc-photo { aspect-ratio: 16 / 10; }
  }
  @media (max-width: 768px) {
    .people { grid-template-columns: repeat(2, 1fr); }
    .intro-media { aspect-ratio: 4 / 3; }
    .eca-grid { grid-template-columns: 1fr 1fr; }
    .eca-1, .eca-2, .eca-3, .eca-4, .eca-5 { grid-column: span 1; grid-row: auto; aspect-ratio: 1; }
    .eca-1 { grid-column: span 2; aspect-ratio: 16 / 10; }
    .eca-6 { grid-column: span 2; aspect-ratio: 16 / 9; }
    .infra-media .media:nth-child(2) { margin-top: 1.5rem; }
  }
  @media (max-width: 480px) {
    .people { grid-template-columns: 1fr; }
    .infra-media { grid-template-columns: 1fr; }
    .infra-media .media:nth-child(2) { margin-top: 0; }
    .eca-grid { grid-template-columns: 1fr; }
    .eca-1, .eca-2, .eca-3, .eca-4, .eca-5, .eca-6 { grid-column: span 1; }
  }
</style>
