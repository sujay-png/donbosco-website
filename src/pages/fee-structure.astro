---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const feeItems = [
  { no: '1', classGrade: 'Primary', fee: '₹ 21,900/-', frequency: 'Annual Fee' },
  { no: '2', classGrade: 'Middle School', fee: '₹ 21,960/-', frequency: 'Annual Fee' },
  { no: '3', classGrade: 'Secondary (Class IX - X)', fee: '₹ 23,400/-', frequency: 'Annual Fee' },
  { no: '4', classGrade: 'Senior Secondary (Commerce)', fee: '₹ 27,000/-', frequency: 'Annual Fee' },
  { no: '5', classGrade: 'Senior Secondary (Science)', fee: '₹ 30,000/-', frequency: 'Annual Fee' },
];
---

<Layout 
  title="Fee Structure - Don Bosco English Medium School Shirva"
  description="Official annual fee structure for Primary, Middle, Secondary, and Senior Secondary streams at Don Bosco English Medium School Shirva as per CBSE disclosures."
>
  <Header />

  <section class="page-hero on-image">
    <div class="ph-media" data-parallax="-0.12"><img src="/about/old-school.jpg" alt="Don Bosco Campus" fetchpriority="high" /></div>
    <div class="ph-shade" aria-hidden="true"></div>
    <div class="container ph-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb" data-reveal="fade">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/mandatory-public-disclosure">CBSE Disclosures</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page" class="crumb-current">Fee Structure</span>
      </nav>
      <div class="hero-badge" data-reveal="fade">CBSE MANDATORY COMPLIANCE</div>
      <h1 class="h1 ph-title" data-split>FEE <em>STRUCTURE</em></h1>
      <p class="ph-sub" data-reveal="fade">Transparent, government-compliant annual tuition fee framework for academic year 2024–25.</p>
    </div>
  </section>

  <main class="fee-main section">
    <div class="container fee-container">

      <!-- Highlights Banner -->
      <div class="fee-summary-cards" data-reveal>
        <div class="summary-card">
          <div class="sc-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <div class="sc-content">
            <span class="sc-label">Primary to Senior Secondary</span>
            <strong class="sc-val">₹21,900 – ₹30,000</strong>
          </div>
        </div>

        <div class="summary-card">
          <div class="sc-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div class="sc-content">
            <span class="sc-label">Payment Schedule</span>
            <strong class="sc-val">Term-wise Installments</strong>
          </div>
        </div>

        <div class="summary-card">
          <div class="sc-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <div class="sc-content">
            <span class="sc-label">No Hidden Costs</span>
            <strong class="sc-val">Inclusive of Lab & Library</strong>
          </div>
        </div>
      </div>

      <!-- Main Fee Table Card -->
      <div class="table-card" data-reveal>
        <div class="table-header-block">
          <div>
            <h2 class="h3 card-title">Annual Tuition & Activity Fees</h2>
            <p class="card-desc">Approved by School Management Committee (SMC) & Parent Teacher Association (PTA)</p>
          </div>
          <a href="/mandatory-public-disclosure" class="back-pill">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
            All Disclosures
          </a>
        </div>

        <div class="table-responsive">
          <table class="fee-table">
            <thead>
              <tr>
                <th scope="col" class="th-num">S.N</th>
                <th scope="col">Class / Academic Level</th>
                <th scope="col" class="th-fee">Annual Fees</th>
                <th scope="col" class="th-freq">Billing Frequency</th>
              </tr>
            </thead>
            <tbody>
              {feeItems.map(item => (
                <tr>
                  <td class="td-num">#{item.no}</td>
                  <td class="td-class">
                    <strong>{item.classGrade}</strong>
                  </td>
                  <td class="td-fee">
                    <span class="fee-amount">{item.fee}</span>
                  </td>
                  <td class="td-freq">
                    <span class="freq-tag">{item.frequency}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="table-notes">
          <h4 class="notes-heading">Important Notes Regarding Fee Remittance:</h4>
          <ul>
            <li>School fees can be deposited via Net Banking / UPI / Demand Draft or at the designated school bank counter.</li>
            <li>Concessions are granted to meritorious students and economically disadvantaged families through the Catholic Board of Education scholarship assistance program.</li>
            <li>For official fee receipts, installment schedule details, and transportation fee queries, kindly contact the School Accounts Office during working hours (9:00 AM – 4:00 PM).</li>
          </ul>
        </div>
      </div>

      <!-- Action Support Banner -->
      <div class="fee-cta" data-reveal>
        <div class="cta-text">
          <h3 class="h3 cta-title">Need Help with Fees or Admissions?</h3>
          <p class="cta-desc">Our accounts office is here to help with receipt queries, online payments, and sibling discount guidelines.</p>
        </div>
        <div class="cta-actions">
          <a href="/contact" class="btn btn-primary">Contact Accounts</a>
          <a href="tel:+918722089715" class="btn btn-outline">Call: 8722089715</a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* Hero */
  .page-hero {
    position: relative;
    min-height: clamp(380px, 48vh, 520px);
    display: flex; align-items: flex-end;
    color: #fff;
    overflow: hidden;
    isolation: isolate;
    background: #0b0d10;
  }
  .ph-media { position: absolute; inset: -10% 0; z-index: -2; }
  .ph-media img { width: 100%; height: 100%; object-fit: cover; }
  .ph-shade {
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(180deg, rgba(8,10,13,.82) 0%, rgba(8,10,13,.65) 45%, rgba(8,10,13,.95) 100%);
  }
  .ph-inner {
    padding-top: calc(var(--header-h) + 60px);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    display: flex; flex-direction: column; gap: 0.8rem;
  }
  .breadcrumb {
    display: flex; flex-wrap: wrap; align-items: center; gap: .6rem;
    font-size: .85rem; font-weight: 600;
    color: rgba(255,255,255,.7);
  }
  .breadcrumb a { color: rgba(255,255,255,.85); text-decoration: none; transition: color .2s; }
  .breadcrumb a:hover { color: var(--gold); }
  .crumb-current { color: var(--gold); }
  .hero-badge {
    display: inline-block;
    width: fit-content;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold);
    background: rgba(212,175,55,0.12);
    border: 1px solid rgba(212,175,55,0.3);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
  }
  .ph-title { color: #fff; margin: 0; }
  .ph-title :global(em) { color: var(--gold); font-style: normal; }
  .ph-sub { color: rgba(255,255,255,0.85); max-width: 65ch; margin: 0; font-size: 1.05rem; }

  /* Main */
  .fee-main {
    padding-block: clamp(3rem, 6vw, 5rem);
    background: var(--bg);
  }
  .fee-container {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  /* Summary Cards */
  .fee-summary-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .summary-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 1.5rem 1.75rem;
    box-shadow: 0 4px 18px rgba(0,0,0,0.03);
    transition: transform .2s ease, border-color .2s ease;
  }
  .summary-card:hover {
    transform: translateY(-2px);
    border-color: var(--gold);
  }
  .sc-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: rgba(197, 160, 89, 0.12);
    color: var(--gold-text);
    flex-shrink: 0;
  }
  .sc-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .sc-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .sc-val {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--ink);
  }

  /* Table Card */
  .table-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    box-shadow: 0 8px 30px rgba(0,0,0,0.04);
  }
  .table-header-block {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  .card-title {
    color: var(--ink);
    margin: 0 0 0.4rem 0;
  }
  .card-desc {
    color: var(--muted);
    margin: 0;
    font-size: 0.95rem;
  }
  .back-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--gold-text);
    background: var(--bg-alt);
    border: 1px solid var(--line);
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    text-decoration: none;
    transition: all .2s ease;
    min-height: 44px;
  }
  .back-pill:hover {
    background: var(--gold);
    color: #101216;
    border-color: var(--gold);
  }
  .back-pill:hover * {
    color: #101216 !important;
  }

  .table-responsive {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    margin-bottom: 2rem;
  }
  .fee-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1rem;
    text-align: left;
    min-width: 580px;
  }
  .fee-table th {
    background: var(--bg-alt);
    color: var(--ink);
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 1.1rem 1.5rem;
    border-bottom: 2px solid var(--line);
  }
  .fee-table td {
    padding: 1.15rem 1.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    vertical-align: middle;
  }
  .fee-table tbody tr:last-child td {
    border-bottom: none;
  }
  .fee-table tbody tr:hover {
    background: color-mix(in srgb, var(--gold) 4%, transparent);
  }
  .th-num, .td-num {
    width: 80px;
    color: var(--muted);
    font-weight: 600;
  }
  .td-class strong {
    color: var(--ink);
    font-size: 1.05rem;
  }
  .th-fee, .td-fee {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--gold-text);
  }
  .fee-amount {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    background: rgba(197, 160, 89, 0.08);
    border-radius: 6px;
    border: 1px solid rgba(197, 160, 89, 0.2);
  }
  .freq-tag {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
    background: var(--bg-alt);
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
  }

  /* Notes */
  .table-notes {
    background: var(--bg-alt);
    border-left: 4px solid var(--gold);
    border-radius: 0 var(--r-md) var(--r-md) 0;
    padding: 1.5rem 1.75rem;
  }
  .notes-heading {
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 0.75rem 0;
  }
  .table-notes ul {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .table-notes li {
    font-size: 0.92rem;
    color: var(--ink);
    line-height: 1.55;
  }

  /* Fee CTA */
  .fee-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    background: linear-gradient(135deg, rgba(197, 160, 89, 0.12) 0%, rgba(197, 160, 89, 0.04) 100%);
    border: 1px solid rgba(197, 160, 89, 0.3);
    border-radius: var(--r-lg);
    padding: 2.25rem 2.5rem;
  }
  .cta-title {
    color: var(--ink);
    margin: 0 0 0.4rem 0;
  }
  .cta-desc {
    color: var(--muted);
    margin: 0;
    max-width: 60ch;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    transition: all .2s ease;
  }
  .btn-primary {
    background: var(--gold) !important;
    color: #101216 !important;
    border: 1px solid var(--gold) !important;
  }
  .btn-primary:hover, .btn-primary:focus-visible {
    background: #0B0D12 !important;
    color: #ffffff !important;
    border-color: #0B0D12 !important;
    transform: translateY(-2px);
  }
  .btn-primary:hover * {
    color: #ffffff !important;
  }
  :global([data-theme="dark"]) .btn-primary:hover,
  :global([data-theme="dark"]) .btn-primary:focus-visible {
    background: #ffffff !important;
    color: #0b0c0f !important;
    border-color: #ffffff !important;
  }
  :global([data-theme="dark"]) .btn-primary:hover * {
    color: #0b0c0f !important;
  }

  .btn-outline {
    background: #ffffff !important;
    color: #101216 !important;
    border: 1px solid rgba(16, 18, 22, 0.22) !important;
  }
  .btn-outline:hover, .btn-outline:focus-visible {
    background: #101216 !important;
    color: #ffffff !important;
    border-color: #101216 !important;
    transform: translateY(-2px);
  }
  .btn-outline:hover * {
    color: #ffffff !important;
  }
  :global([data-theme="dark"]) .btn-outline {
    background: rgba(255, 255, 255, 0.06) !important;
    color: #f1eee7 !important;
    border-color: rgba(255, 255, 255, 0.2) !important;
  }
  :global([data-theme="dark"]) .btn-outline:hover,
  :global([data-theme="dark"]) .btn-outline:focus-visible {
    background: var(--gold) !important;
    color: #0b0c0f !important;
    border-color: var(--gold) !important;
  }
  :global([data-theme="dark"]) .btn-outline:hover * {
    color: #0b0c0f !important;
  }

  /* Responsive & Dark mode */
  @media (max-width: 768px) {
    .table-card { padding: 1.25rem; }
    .fee-cta { padding: 1.5rem; }
    .cta-actions { width: 100%; }
    .btn { width: 100%; }
  }
  @media (max-width: 480px) {
    .fee-summary-cards { grid-template-columns: 1fr; }
    .table-card { padding: 1rem 0.75rem; }
    .fee-table th, .fee-table td { padding: 0.85rem 1rem; }
  }

  /* Dark mode overrides */
  :global([data-theme="dark"]) .card-title,
  :global([data-theme="dark"]) .cta-title,
  :global([data-theme="dark"]) .notes-heading,
  :global([data-theme="dark"]) .fee-table th,
  :global([data-theme="dark"]) .td-class strong,
  :global([data-theme="dark"]) .sc-val {
    color: #F8F6F0 !important;
  }
  :global([data-theme="dark"]) .table-notes li,
  :global([data-theme="dark"]) .fee-table td {
    color: #D8D4CC !important;
  }
  :global([data-theme="dark"]) .summary-card,
  :global([data-theme="dark"]) .table-card {
    background: #14171F !important;
    border-color: rgba(255,255,255,0.08) !important;
  }
  :global([data-theme="dark"]) .fee-table th {
    background: #1B1F2A !important;
  }
  :global([data-theme="dark"]) .table-notes {
    background: #181C26 !important;
  }
  :global([data-theme="dark"]) .btn-outline {
    color: #F8F6F0 !important;
    border-color: rgba(255,255,255,0.18) !important;
  }
</style>
