<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('pdf-modal');
    const modalIframe = document.getElementById('modal-iframe');
    const modalTitle = document.getElementById('modal-doc-title');
    const modalDownloadBtn = document.getElementById('modal-download-btn');
    const modalNewTabBtn = document.getElementById('modal-newtab-btn');
    const modalCloseBtn = document.getElementById('modal-close-btn');
    const modalBackdrop = document.getElementById('modal-backdrop');

    function openModal(url, title) {
      if (!modal || !modalIframe) return;
      modalIframe.src = url;
      if (modalTitle) modalTitle.textContent = title || 'Document Preview';
      if (modalDownloadBtn) modalDownloadBtn.href = url;
      if (modalNewTabBtn) modalNewTabBtn.href = url;
      
      modal.setAttribute('aria-hidden', 'false');
      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal || !modalIframe) return;
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      modalIframe.src = '';
      document.body.style.overflow = '';
    }

    document.querySelectorAll('[data-preview-url]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const url = btn.getAttribute('data-preview-url');
        const title = btn.getAttribute('data-preview-title');
        if (url) openModal(url, title);
      });
    });

    if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
    if (modalBackdrop) modalBackdrop.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && modal.classList.contains('is-open')) {
        closeModal();
      }
    });
  });
</script>

