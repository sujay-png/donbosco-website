---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  generalInfo,
  complianceDocuments,
  academicDisclosures,
  resultsClassX,
  resultsClassXII,
  staffInfo,
  infrastructureData,
  inspectionVideo
} from '../data/mandatory-disclosure';
---

<Layout 
  title="Mandatory Public Disclosure (CBSE Appendix IX) - Don Bosco School Shirva"
  description="Official Mandatory Public Disclosure for Don Bosco English Medium School Shirva as mandated by CBSE (Affiliation No. 830838, School Code: 45731) under Appendix IX. Access official certificates, academic results, faculty disclosures, and campus infrastructure data."
>
  <Header />

  <!-- Hero Section -->
  <section class="page-hero on-image">
    <div class="ph-media" data-parallax="-0.12">
      <img src="/about/old-school.jpg" alt="Don Bosco School Shirva Campus" fetchpriority="high" />
    </div>
    <div class="ph-shade" aria-hidden="true"></div>
    <div class="container ph-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb" data-reveal="fade">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>CBSE</span>
        <span aria-hidden="true">/</span>
        <span aria-current="page" class="crumb-current">Mandatory Public Disclosure</span>
      </nav>
      
      <div class="hero-badges" data-reveal="fade">
        <span class="badge-pill">CBSE AFFILIATION NO: 830838</span>
        <span class="badge-pill">SCHOOL CODE: 45731</span>
        <span class="badge-pill badge-gold">APPENDIX IX COMPLIANT</span>
      </div>

      <h1 class="h1 ph-title" data-split>MANDATORY PUBLIC <em>DISCLOSURE</em></h1>
      <p class="ph-subtitle" data-reveal="fade">
        Statutory institutional disclosures under the Central Board of Secondary Education (CBSE) Affiliation Bye-Laws. Complete documentation of official approvals, faculty roster, student outcomes, safety certifications, and infrastructure.
      </p>

      <!-- Quick Jump Navigation -->
      <div class="quick-nav" data-reveal="fade">
        <a href="#general-info" class="quick-nav-pill">
          <span class="pill-num">01</span> General Info
        </a>
        <a href="#documents" class="quick-nav-pill">
          <span class="pill-num">02</span> Documents & Certs
        </a>
        <a href="#academics" class="quick-nav-pill">
          <span class="pill-num">03</span> Results & Academics
        </a>
        <a href="#staff" class="quick-nav-pill">
          <span class="pill-num">04</span> Teaching Staff
        </a>
        <a href="#infrastructure" class="quick-nav-pill">
          <span class="pill-num">05</span> Infrastructure
        </a>
      </div>
    </div>
  </section>

  <!-- Key Metrics Bar -->
  <section class="metrics-bar" aria-label="Key School Metrics">
    <div class="container">
      <div class="metrics-grid">
        <div class="metric-card" data-reveal>
          <div class="mc-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          </div>
          <div class="mc-content">
            <span class="mc-val">830838</span>
            <span class="mc-label">CBSE Affiliation No</span>
          </div>
        </div>

        <div class="metric-card" data-reveal>
          <div class="mc-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <div class="mc-content">
            <span class="mc-val">100%</span>
            <span class="mc-label">Class X Pass Record (3 Yrs)</span>
          </div>
        </div>

        <div class="metric-card" data-reveal>
          <div class="mc-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div class="mc-content">
            <span class="mc-val">45</span>
            <span class="mc-label">Qualified Teachers (30:1 Ratio)</span>
          </div>
        </div>

        <div class="metric-card" data-reveal>
          <div class="mc-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
          </div>
          <div class="mc-content">
            <span class="mc-val">8,093 m²</span>
            <span class="mc-label">Total Campus Area</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Sections -->
  <main class="main-content section">
    <div class="container disclosures-wrapper">

      <!-- SECTION 1: GENERAL INFORMATION -->
      <section id="general-info" class="disclosure-card-section" data-reveal>
        <div class="section-title-wrap">
          <div class="section-badge">SECTION A</div>
          <h2 class="h2 section-title">1. GENERAL INFORMATION</h2>
          <p class="section-desc">Key institutional credentials, administrative contact points, and principal details.</p>
        </div>

        <div class="info-grid">
          {generalInfo.map((item) => (
            <div class="info-card">
              <div class="ic-num">#{item.no}</div>
              <div class="ic-body">
                <span class="ic-label">{item.label}</span>
                {item.link ? (
                  <a href={item.link} class="ic-value ic-link">
                    {item.value}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
                  </a>
                ) : (
                  <strong class="ic-value">{item.value}</strong>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- CBSE Standard Table Layout -->
        <div class="table-responsive standard-table-box">
          <table class="disclosure-table">
            <thead>
              <tr>
                <th scope="col" style="width: 80px;">SL. NO</th>
                <th scope="col" style="width: 35%;">INFORMATION</th>
                <th scope="col">DETAILS</th>
              </tr>
            </thead>
            <tbody>
              {generalInfo.map((row) => (
                <tr>
                  <td class="td-num">{row.no}</td>
                  <td class="td-key"><strong>{row.label}</strong></td>
                  <td class="td-val">
                    {row.link ? (
                      <a href={row.link} class="table-contact-link">{row.value}</a>
                    ) : (
                      <span>{row.value}</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- SECTION 2: DOCUMENTS AND INFORMATION -->
      <section id="documents" class="disclosure-card-section" data-reveal>
        <div class="section-title-wrap">
          <div class="section-badge">SECTION B</div>
          <h2 class="h2 section-title">2. DOCUMENTS AND INFORMATION</h2>
          <p class="section-desc">
            Statutory certifications, registration letters, government approvals, and safety compliances. All documents can be viewed online or downloaded directly.
          </p>
        </div>

        <div class="docs-grid">
          {complianceDocuments.map((doc) => (
            <div class="doc-item-card">
              <div class="doc-card-top">
                <div class="doc-sl">DOC #{doc.no}</div>
                <span class="doc-tag">{doc.tag}</span>
              </div>
              <h3 class="h4 doc-title">{doc.title}</h3>
              <p class="doc-auth">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {doc.authority}
              </p>
              
              <div class="doc-card-bottom">
                <div class="doc-meta">
                  <span class="doc-fmt">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    PDF
                  </span>
                  <span class="doc-size">{doc.fileSize}</span>
                </div>
                
                <div class="doc-actions">
                  <button 
                    type="button" 
                    class="btn-doc-view" 
                    data-preview-url={doc.fileUrl}
                    data-preview-title={doc.title}
                    aria-label={`Preview ${doc.title}`}
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    Preview
                  </button>
                  <a 
                    href={doc.fileUrl} 
                    download 
                    class="btn-doc-download"
                    aria-label={`Download ${doc.title}`}
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Download
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- CBSE Table representation -->
        <div class="table-responsive standard-table-box">
          <table class="disclosure-table">
            <thead>
              <tr>
                <th scope="col" style="width: 80px;">SL. NO</th>
                <th scope="col">DOCUMENTS / INFORMATION</th>
                <th scope="col" style="width: 260px; text-align: right;">UPLOAD DOCUMENTS</th>
              </tr>
            </thead>
            <tbody>
              {complianceDocuments.map((doc) => (
                <tr>
                  <td class="td-num">{doc.no}</td>
                  <td class="td-doc-desc">
                    <strong>{doc.title}</strong>
                    <span class="td-auth-sub">{doc.authority}</span>
                  </td>
                  <td class="td-action-cell">
                    <div class="table-action-group">
                      <button 
                        type="button" 
                        class="table-view-btn" 
                        data-preview-url={doc.fileUrl}
                        data-preview-title={doc.title}
                      >
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        View
                      </button>
                      <a href={doc.fileUrl} target="_blank" rel="noopener noreferrer" class="table-dl-btn" download>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        Download ({doc.fileSize})
                      </a>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- SECTION 3: RESULTS AND ACADEMICS -->
      <section id="academics" class="disclosure-card-section" data-reveal>
        <div class="section-title-wrap">
          <div class="section-badge">SECTION C</div>
          <h2 class="h2 section-title">3. RESULTS AND ACADEMICS</h2>
          <p class="section-desc">Institutional disclosures including fee framework, academic calendar, administrative committees, and multi-year board examination outcomes.</p>
        </div>

        <!-- Academic Institutional Links Grid -->
        <div class="academic-cards-grid">
          {academicDisclosures.map((item) => (
            <div class="acad-item-card">
              <div class="acad-card-top">
                <span class="acad-num">#{item.no}</span>
                <span class="acad-tag">MANDATORY</span>
              </div>
              <h3 class="h4 acad-title">{item.title}</h3>
              <p class="acad-desc">{item.description}</p>
              
              <div class="acad-action">
                {item.isDownload ? (
                  <a href={item.url} download class="acad-btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    {item.linkText}
                  </a>
                ) : (
                  <a href={item.url} class="acad-btn-primary">
                    <span>{item.linkText}</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- Institutional Links Table -->
        <div class="table-responsive standard-table-box">
          <table class="disclosure-table">
            <thead>
              <tr>
                <th scope="col" style="width: 80px;">SL. NO</th>
                <th scope="col">DOCUMENTS / INFORMATION</th>
                <th scope="col" style="width: 220px; text-align: right;">UPLOAD DOCUMENTS</th>
              </tr>
            </thead>
            <tbody>
              {academicDisclosures.map((row) => (
                <tr>
                  <td class="td-num">{row.no}</td>
                  <td class="td-doc-desc">
                    <strong>{row.title}</strong>
                    <span class="td-auth-sub">{row.description}</span>
                  </td>
                  <td class="td-action-cell">
                    <a href={row.url} class="table-view-btn" {...(row.isDownload ? { download: true } : {})}>
                      {row.isDownload ? (
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                      ) : (
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                      )}
                      {row.linkText}
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Board Results: Class X & XII -->
        <div class="results-container">
          <!-- Class X Results -->
          <div class="result-subsection">
            <div class="res-subhead">
              <div>
                <h3 class="h3 res-title">RESULT CLASS: X (SECONDARY SCHOOL EXAMINATION)</h3>
                <p class="res-desc">Three consecutive academic years of 100% pass performance in All India Secondary School Examination.</p>
              </div>
              <span class="pill-distinction">100% PASS RATE</span>
            </div>

            <div class="table-responsive standard-table-box">
              <table class="disclosure-table">
                <thead>
                  <tr>
                    <th scope="col" style="width: 80px;">SL. NO</th>
                    <th scope="col">ACADEMIC YEAR</th>
                    <th scope="col">NO. OF REGISTERED STUDENTS</th>
                    <th scope="col">NO. OF STUDENTS PASSED</th>
                    <th scope="col" class="th-accent">PASS PERCENTAGE</th>
                    <th scope="col">REMARKS</th>
                  </tr>
                </thead>
                <tbody>
                  {resultsClassX.map((item, idx) => (
                    <tr>
                      <td class="td-num">{idx + 1}</td>
                      <td><strong class="font-year">{item.year}</strong></td>
                      <td>{item.registered}</td>
                      <td><strong>{item.passed}</strong></td>
                      <td><span class="pass-badge-100">{item.passPercentage}</span></td>
                      <td class="td-muted">{item.remarks}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- Class XII Results -->
          <div class="result-subsection">
            <div class="res-subhead">
              <div>
                <h3 class="h3 res-title">RESULT CLASS: XII (SENIOR SCHOOL CERTIFICATE EXAMINATION)</h3>
                <p class="res-desc">Academic excellence across Science and Commerce streams in Senior Secondary Examinations.</p>
              </div>
              <span class="pill-distinction">CBSE SENIOR SECONDARY</span>
            </div>

            <div class="table-responsive standard-table-box">
              <table class="disclosure-table">
                <thead>
                  <tr>
                    <th scope="col" style="width: 80px;">SL. NO</th>
                    <th scope="col">ACADEMIC YEAR</th>
                    <th scope="col">NO. OF REGISTERED STUDENTS</th>
                    <th scope="col">NO. OF STUDENTS PASSED</th>
                    <th scope="col" class="th-accent">PASS PERCENTAGE</th>
                    <th scope="col">REMARKS</th>
                  </tr>
                </thead>
                <tbody>
                  {resultsClassXII.map((item, idx) => (
                    <tr>
                      <td class="td-num">{idx + 1}</td>
                      <td><strong class="font-year">{item.year}</strong></td>
                      <td>{item.registered}</td>
                      <td><strong>{item.passed}</strong></td>
                      <td>
                        <span class={item.passPercentage === '100%' ? 'pass-badge-100' : 'pass-badge-high'}>
                          {item.passPercentage}
                        </span>
                      </td>
                      <td class="td-muted">{item.remarks}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 4: STAFF (TEACHING) -->
      <section id="staff" class="disclosure-card-section" data-reveal>
        <div class="section-title-wrap">
          <div class="section-badge">SECTION D</div>
          <h2 class="h2 section-title">4. STAFF (TEACHING)</h2>
          <p class="section-desc">Faculty roster details, qualification distribution, teacher-student section ratio, and student wellness support.</p>
        </div>

        <!-- Faculty Quick Cards -->
        <div class="staff-cards-grid">
          <div class="staff-hero-card">
            <div class="shc-role">PRINCIPAL & HEAD OF INSTITUTION</div>
            <h3 class="h3 shc-name">{staffInfo.principal.name}</h3>
            <span class="shc-qual">{staffInfo.principal.qualifications}</span>
            <p class="shc-bio">Leading academic and pastoral excellence at Don Bosco School Shirva with dedicated student mentoring.</p>
          </div>

          <div class="staff-stat-card">
            <span class="ssc-label">TOTAL TEACHERS</span>
            <strong class="ssc-val">{staffInfo.totalTeachers}</strong>
            <div class="ssc-pills">
              <span class="ssc-pill"><strong>{staffInfo.breakdown.pgt}</strong> PGT</span>
              <span class="ssc-pill"><strong>{staffInfo.breakdown.tgt}</strong> TGT</span>
              <span class="ssc-pill"><strong>{staffInfo.breakdown.prt}</strong> PRT</span>
            </div>
          </div>

          <div class="staff-stat-card">
            <span class="ssc-label">TEACHER-SECTION RATIO</span>
            <strong class="ssc-val">{staffInfo.sectionRatio}</strong>
            <p class="ssc-note">Optimal class attention compliant with CBSE national benchmarks.</p>
          </div>

          <div class="staff-stat-card">
            <span class="ssc-label">WELLNESS & COUNSELLING</span>
            <strong class="ssc-val">{staffInfo.counsellors}</strong>
            <p class="ssc-note">Full-time counsellors & wellness teachers guiding psychological and academic health.</p>
          </div>
        </div>

        <!-- Teaching Staff Table -->
        <div class="table-responsive standard-table-box">
          <table class="disclosure-table">
            <thead>
              <tr>
                <th scope="col" style="width: 80px;">SL. NO</th>
                <th scope="col" style="width: 45%;">INFORMATION</th>
                <th scope="col">DETAILS</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="td-num">1</td>
                <td class="td-key"><strong>PRINCIPAL</strong></td>
                <td class="td-val">
                  <strong>{staffInfo.principal.name}</strong>
                  <span class="td-sub-detail">{staffInfo.principal.qualifications}</span>
                </td>
              </tr>
              <tr>
                <td class="td-num">2</td>
                <td class="td-key"><strong>TOTAL NO. OF TEACHERS</strong></td>
                <td class="td-val"><strong>{staffInfo.totalTeachers}</strong></td>
              </tr>
              <tr class="tr-sub">
                <td class="td-num-sub">a</td>
                <td class="td-key-sub">PGT (Post Graduate Teachers)</td>
                <td class="td-val"><strong>{staffInfo.breakdown.pgt}</strong></td>
              </tr>
              <tr class="tr-sub">
                <td class="td-num-sub">b</td>
                <td class="td-key-sub">TGT (Trained Graduate Teachers)</td>
                <td class="td-val"><strong>{staffInfo.breakdown.tgt}</strong></td>
              </tr>
              <tr class="tr-sub">
                <td class="td-num-sub">c</td>
                <td class="td-key-sub">PRT (Primary Teachers)</td>
                <td class="td-val"><strong>{staffInfo.breakdown.prt}</strong></td>
              </tr>
              <tr>
                <td class="td-num">3</td>
                <td class="td-key"><strong>TEACHERS SECTION RATIO</strong></td>
                <td class="td-val"><span class="ratio-pill">{staffInfo.sectionRatio}</span></td>
              </tr>
              <tr>
                <td class="td-num">4</td>
                <td class="td-key"><strong>DETAILS OF SPECIAL EDUCATOR</strong></td>
                <td class="td-val">
                  <span>{staffInfo.specialEducators}</span>
                  <span class="td-sub-detail">Supported via inclusive faculty network & remedial programs</span>
                </td>
              </tr>
              <tr>
                <td class="td-num">5</td>
                <td class="td-key"><strong>DETAILS OF COUNSELLOR AND WELLNESS TEACHER</strong></td>
                <td class="td-val"><strong>0{staffInfo.counsellors} Qualified Mentors</strong></td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- SECTION 5: SCHOOL INFRASTRUCTURE -->
      <section id="infrastructure" class="disclosure-card-section" data-reveal>
        <div class="section-title-wrap">
          <div class="section-badge">SECTION E</div>
          <h2 class="h2 section-title">5. SCHOOL INFRASTRUCTURE</h2>
          <p class="section-desc">Physical campus metrics, laboratories, sanitation provisions, and video walkthrough documentation.</p>
        </div>

        <!-- Infrastructure Cards Grid -->
        <div class="infra-cards-grid">
          {infrastructureData.map((item) => (
            <div class="infra-card">
              <div class="ic-head">
                <span class="ic-num">#{item.no}</span>
                {item.metric && <span class="ic-metric">{item.metric}</span>}
              </div>
              <h3 class="h4 ic-param">{item.parameter}</h3>
              <p class="ic-detail">{item.detail}</p>
            </div>
          ))}
        </div>

        <!-- Inspection Video Showcase -->
        <div class="video-showcase-card">
          <div class="video-info-side">
            <span class="vsc-badge">OFFICIAL VIDEO INSPECTION</span>
            <h3 class="h3 vsc-title">{inspectionVideo.title}</h3>
            <p class="vsc-desc">{inspectionVideo.description}</p>
            <div class="vsc-points">
              <div class="vsc-point">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
