---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Collaborations from '../components/Collaborations.astro';

const contactCards = [
  {
    icon: 'pin',
    title: 'School Address',
    subtitle: 'Campus Location',
    badge: 'Main Campus',
    lines: [
      'SHIRVA, UDUPI DISTRICT – 574116',
      'Karnataka, India'
    ],
    highlight: 'Near St. Mary of the Syrian Cathedral',
    actionText: 'View on Google Maps',
    actionHref: 'https://maps.google.com/?q=Don+Bosco+English+Medium+Senior+Secondary+School+Shirva',
    external: true
  },
  {
    icon: 'phone',
    title: 'Contact info',
    subtitle: 'Direct Lines & Email',
    badge: 'Official Desk',
    contacts: [
      { label: 'Mobile', value: '+91 87220 89715', href: 'tel:+918722089715', icon: 'phone' },
      { label: 'Landline', value: '0820-2553320', href: 'tel:08202553320', icon: 'phone' },
      { label: 'School Office', value: 'shirvadonboscoschool@gmail.com', href: 'mailto:shirvadonboscoschool@gmail.com', icon: 'mail' },
      { label: 'Inquiries', value: 'enquires.wrnxt@gmail.com', href: 'mailto:enquires.wrnxt@gmail.com', icon: 'mail' }
    ],
    highlight: 'Quick response during working hours',
    actionText: 'Call School Office',
    actionHref: 'tel:+918722089715',
    external: false
  },
  {
    icon: 'clock',
    title: 'School time',
    subtitle: 'Working Hours',
    badge: 'Timings',
    timings: [
      { day: 'Monday – Friday', hours: '9:00 AM – 4:00 PM' },
      { day: 'Saturday', hours: '9:00 AM – 1:00 PM' },
      { day: 'Sunday & Public Holidays', hours: 'Closed' }
    ],
    highlight: 'Office Support: +91 87220 89715',
    actionText: 'Send an Inquiry',
    actionHref: '#inquiry-form',
    external: false
  }
];

const socialLinks = [
  {
    name: 'Instagram',
    handle: '@donboscoshoolshirva',
    href: 'https://www.instagram.com/donboscoschoolshirva/',
    icon: 'instagram',
    color: '#E1306C'
  },
  {
    name: 'Facebook',
    handle: 'donboscocbseshirva',
    href: 'https://www.facebook.com/donboscocbseshirva',
    icon: 'facebook',
    color: '#1877F2'
  },
  {
    name: 'X (Twitter)',
    handle: '@DonBoscoSchoolShirva',
    href: 'https://x.com/DonBoscoSchoolShirva',
    icon: 'x',
    color: '#000000'
  },
  {
    name: 'YouTube',
    handle: 'Don Bosco Shirva Channel',
    href: 'https://www.youtube.com/channel/UCA-mm4zX39MVrTpOhWuEeoQ',
    icon: 'youtube',
    color: '#FF0000'
  }
];
---

<Layout 
  title="Contact Us - Don Bosco English Medium School Shirva"
  description="Contact Don Bosco English Medium School Shirva. Address, phone numbers (+91 87220 89715, 0820-2553320), email, school timings, Google map directions, and inquiry form."
>
  <Header />

  <!-- Page Hero -->
  <section class="page-hero on-image">
    <div class="ph-media" data-parallax="-0.12">
      <img src="/about/old-school.jpg" alt="Don Bosco English Medium School Campus" fetchpriority="high" />
    </div>
    <div class="ph-shade" aria-hidden="true"></div>
    <div class="container ph-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb" data-reveal="fade">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page" class="crumb-current">Contact</span>
      </nav>
      <h1 class="h1 ph-title" data-split>Contact <em>Us</em></h1>
    </div>
  </section>

  <!-- Main Content Area -->
  <main class="inner-main section" id="contact-content">
    <div class="container">

      <!-- Section Header -->
      <header class="contact-header" data-reveal>
        <div class="badge-pill">
          <span class="badge-dot"></span>
          Get In Touch
        </div>
        <h2 class="h2 intro-title">We'd Love to Hear From You</h2>
        <p class="intro-desc">
          Reach out to our administrative team, faculty, or admissions office. We are always happy to assist students, parents, and visitors with inquiries regarding schooling, admissions, academics, and campus life.
        </p>
      </header>

      <!-- 3 Quick Contact Cards -->
      <div class="cards-grid">
        {contactCards.map((card, idx) => (
          <article class="info-card" data-reveal="slide-up" style={`--delay: ${idx * 0.1}s`}>
            <div class="card-top">
              <div class="icon-bubble" aria-hidden="true">
                <Icon name={card.icon} size={28} />
              </div>
              <div class="card-meta">
                <span class="card-subtitle">{card.subtitle}</span>
                <h3 class="card-title">{card.title}</h3>
              </div>
              <span class="card-pill">{card.badge}</span>
            </div>

            <div class="card-body">
              {card.lines && (
                <div class="info-lines">
                  {card.lines.map((l) => (
                    <p class="address-line">{l}</p>
                  ))}
                </div>
              )}

              {card.contacts && (
                <div class="contacts-list">
                  {card.contacts.map((c) => (
                    <div class="contact-item">
                      <span class="item-label">{c.label}:</span>
                      <a href={c.href} class="item-value" aria-label={`${c.label}: ${c.value}`}>
                        {c.value}
                      </a>
                    </div>
                  ))}
                </div>
              )}

              {card.timings && (
                <div class="timings-list">
                  {card.timings.map((t) => (
                    <div class="timing-item">
                      <span class="timing-day">{t.day}</span>
                      <span class="timing-hours">{t.hours}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>

            <div class="card-footer">
              <div class="card-highlight">
                <span class="dot-indicator" aria-hidden="true"></span>
                <span>{card.highlight}</span>
              </div>
              <a 
                href={card.actionHref} 
                class="card-action-btn"
                target={card.external ? '_blank' : undefined}
                rel={card.external ? 'noopener noreferrer' : undefined}
              >
                <span>{card.actionText}</span>
                <Icon name={card.external ? 'arrow-up-right' : 'arrow'} size={16} />
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Social Media Connect Strip -->
      <div class="social-connect-bar" data-reveal>
        <div class="social-bar-left">
          <span class="social-badge">Community</span>
          <h3 class="social-bar-title">Like, Share &amp; Follow us:</h3>
          <p class="social-bar-sub">Stay connected with daily school activities, student honors, and celebrations.</p>
        </div>

        <div class="social-chips">
          {socialLinks.map((s) => (
            <a 
              href={s.href} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="social-chip" 
              aria-label={`Follow us on ${s.name} at ${s.handle}`}
            >
              <span class="social-icon-box" aria-hidden="true">
                <Icon name={s.icon} size={20} />
              </span>
              <span class="social-chip-text">
                <span class="social-chip-name">{s.name}</span>
                <span class="social-chip-handle">{s.handle}</span>
              </span>
              <Icon name="arrow-up-right" size={14} class="chip-arrow" />
            </a>
          ))}
        </div>
      </div>

      <!-- Map & Interactive Inquiry Form 2-Column Section -->
      <section class="interactive-split" id="inquiry-form" aria-label="Campus Location and Inquiry Form">
        <div class="split-grid">
          
          <!-- Column 1: Google Map Embed -->
          <div class="map-column" data-reveal="slide-up">
            <div class="map-card">
              <div class="map-card-head">
                <div class="map-head-title">
                  <div class="map-indicator">
                    <span class="pulse-ring" aria-hidden="true"></span>
                    <span class="pulse-dot" aria-hidden="true"></span>
                  </div>
                  <div>
                    <h3 class="h4 map-title">Find Our Campus</h3>
                    <p class="map-sub">Shirva, Udupi District, Karnataka – 574116</p>
                  </div>
                </div>
                <a 
                  href="https://maps.google.com/?q=Don+Bosco+English+Medium+Senior+Secondary+School+Shirva"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-open-map"
                  aria-label="Open location in Google Maps (opens in new tab)"
                >
                  <span>Open Maps</span>
                  <Icon name="arrow-up-right" size={16} />
                </a>
              </div>

              <!-- Map Iframe Wrapper -->
              <div class="map-frame-wrapper" id="map-section">
                <iframe
                  loading="lazy"
                  src="https://maps.google.com/maps?q=Don%20Bosco%20English%20Medium%20Senior%20Secondary%20School&t=m&z=16&output=embed&iwloc=near"
                  title="Don Bosco English Medium Senior Secondary School Location"
                  aria-label="Google Map showing Don Bosco English Medium Senior Secondary School campus"
                  class="map-iframe"
                ></iframe>
              </div>

              <!-- Map Footer Details -->
              <div class="map-card-foot">
                <div class="landmark-item">
                  <Icon name="pin" size={18} />
                  <span><strong>Landmark:</strong> Situated adjacent to Our Lady of Health Church &amp; St. Mary's Syrian Cathedral, Shirva.</span>
                </div>
                <div class="coordinates-badge">
                  <span>GPS: 13.2307° N, 74.8327° E</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Column 2: Inquiry & Message Form -->
          <div class="form-column" data-reveal="slide-up" style="--delay: 0.15s">
            <div class="form-card">
              <div class="form-card-head">
                <span class="form-badge">Online Inquiry</span>
                <h3 class="form-title">
                  Fill the form below so we can get to know you and your needs better.
                </h3>
                <p class="form-sub">
                  Have a question about admissions, curriculum, fee structure, or bus facilities? Submit your details below and our team will get in touch with you.
                </p>
              </div>

              <!-- Contact Form -->
              <form 
                class="contact-form" 
                id="contactUsForm" 
                action="https://formsubmit.co/enquires.wrnxt@gmail.com" 
                method="POST" 
                novalidate
              >
                <!-- FormSubmit.co Integration (Primary: enquires.wrnxt@gmail.com, CC: shirvadonboscoschool@gmail.com) -->
                <input type="hidden" name="_cc" value="shirvadonboscoschool@gmail.com" />
                <input type="hidden" name="_subject" id="formSubmitSubject" value="New Inquiry - Don Bosco English Medium School Shirva" />
                <input type="hidden" name="_template" value="table" />
                <input type="hidden" name="_captcha" value="false" />
                <!-- Anti-spam Honeypot -->
                <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

                <!-- Form Feedback Message (Alert) -->
                <div class="form-feedback hidden" id="formFeedback" role="alert" aria-live="polite"></div>

                <div class="form-grid">
                  <!-- Name Field -->
                  <div class="form-group">
                    <label for="userName" class="field-label">
                      Your Name <span class="req">*</span>
                    </label>
                    <div class="input-wrap">
                      <input 
                        type="text" 
                        id="userName" 
                        name="name" 
                        placeholder="e.g. John Fernandes" 
                        required 
                        autocomplete="name"
                        minlength="2"
                        class="form-input"
                      />
                    </div>
                    <span class="field-error" id="nameError"></span>
                  </div>

                  <!-- Email Field -->
                  <div class="form-group">
                    <label for="userEmail" class="field-label">
                      Email Address <span class="req">*</span>
                    </label>
                    <div class="input-wrap">
                      <input 
                        type="email" 
                        id="userEmail" 
                        name="email" 
                        placeholder="e.g. parent@example.com" 
                        required 
                        autocomplete="email"
                        class="form-input"
                      />
                    </div>
                    <span class="field-error" id="emailError"></span>
                  </div>

                  <!-- Phone Number Field -->
                  <div class="form-group">
                    <label for="userPhone" class="field-label">
                      Phone / Mobile Number <span class="optional">(Optional)</span>
                    </label>
                    <div class="input-wrap">
                      <input 
                        type="tel" 
                        id="userPhone" 
                        name="phone" 
                        placeholder="+91 98765 43210" 
                        autocomplete="tel"
                        class="form-input"
                      />
                    </div>
                  </div>

                  <!-- Subject Field -->
                  <div class="form-group">
                    <label for="userSubject" class="field-label">
                      Subject / Purpose <span class="req">*</span>
                    </label>
                    <div class="input-wrap">
                      <select id="userSubject" name="subject" required class="form-input form-select">
                        <option value="" disabled selected>Select an inquiry reason</option>
                        <option value="Admissions Inquiry">Admissions Inquiry (Pre-KG to Class XII)</option>
                        <option value="Academic & Curriculum">Academic &amp; Curriculum Inquiry</option>
                        <option value="School Timings & Transport">School Timings &amp; Transport Facilities</option>
                        <option value="TC / Student Records">TC / Student Records &amp; Certificates</option>
                        <option value="General Query">General Feedback &amp; Queries</option>
                      </select>
                    </div>
                    <span class="field-error" id="subjectError"></span>
                  </div>

                  <!-- Message Field -->
                  <div class="form-group full-width">
                    <label for="userMessage" class="field-label">
                      Your Message <span class="req">*</span>
                    </label>
                    <div class="input-wrap">
                      <textarea 
                        id="userMessage" 
                        name="message" 
                        rows="4" 
                        placeholder="Please describe your inquiry, student grade/class, or any specific information you require..." 
                        required 
                        minlength="10"
                        class="form-input form-textarea"
                      ></textarea>
                    </div>
                    <span class="field-error" id="messageError"></span>
                  </div>
                </div>

                <!-- Submit Button -->
                <div class="form-actions">
                  <button type="submit" class="submit-btn" id="submitBtn">
                    <span class="btn-spinner hidden" aria-hidden="true"></span>
                    <span class="btn-text">Send Message</span>
                    <Icon name="arrow" size={18} class="btn-icon" />
                  </button>
                </div>
              </form>

            </div>
          </div>

        </div>
      </section>

    </div>
  </main>

  <!-- Partner Affiliations Marquee -->
  <Collaborations />

  <Footer />
</Layout>

<style>
  /* ==========================================================================
     Contact Page Styles — Editorial Academic Design System
     ========================================================================== */

  /* Page Hero */
  .page-hero {
    position: relative;
    padding-top: calc(var(--header-h) + clamp(2.5rem, 5vw, 4.5rem));
    padding-bottom: clamp(3rem, 6vw, 5rem);
    background: var(--deep);
    color: var(--on-deep);
    overflow: hidden;
  }
  .page-hero.on-image .ph-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.38;
    filter: saturate(0.85);
  }
  .page-hero.on-image .ph-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }
  .ph-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(11, 12, 15, 0.75) 0%, rgba(11, 12, 15, 0.94) 100%);
    z-index: 1;
  }
  .ph-inner {
    position: relative;
    z-index: 2;
  }
  .breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--on-deep-muted);
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .breadcrumb a {
    color: var(--on-deep-muted);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }
  .breadcrumb a:hover {
    color: var(--gold);
  }
  .crumb-current {
    color: var(--gold);
    font-weight: 600;
  }
  .ph-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.15;
    font-weight: 500;
    color: var(--on-deep);
    margin: 0;
  }
  .ph-title em {
    font-style: italic;
    color: var(--gold);
    font-family: var(--font-display);
  }

  /* Main Section */
  .inner-main {
    padding-block: clamp(3.5rem, 7vw, 6rem);
    background: var(--bg);
  }

  /* Header Section */
  .contact-header {
    max-width: 800px;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem) auto;
    text-align: center;
  }
  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    border-radius: var(--r-pill);
    background: rgba(255, 182, 6, 0.12);
    border: 1px solid rgba(255, 182, 6, 0.35);
    color: var(--gold-text);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 8px var(--gold);
  }
  .intro-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    line-height: 1.25;
    color: var(--ink);
    margin-bottom: 1rem;
    font-weight: 600;
  }
  .intro-desc {
    font-size: clamp(1rem, 1.2vw, 1.12rem);
    color: var(--muted);
    line-height: 1.7;
    margin: 0 auto;
  }

  /* 3 Quick Cards Grid */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2rem);
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .info-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--shadow-sm);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease), border-color 0.4s var(--ease);
    position: relative;
    overflow: hidden;
  }
  .info-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .info-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow);
    border-color: rgba(255, 182, 6, 0.4);
  }
  .info-card:hover::before {
    opacity: 1;
  }

  .card-top {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.5rem;
    position: relative;
  }
  .icon-bubble {
    flex-shrink: 0;
    width: 54px;
    height: 54px;
    border-radius: var(--r);
    background: rgba(255, 182, 6, 0.12);
    border: 1px solid rgba(255, 182, 6, 0.25);
    color: var(--gold-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s var(--ease), color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .info-card:hover .icon-bubble {
    background: var(--gold);
    color: #101216;
    transform: scale(1.05) rotate(-3deg);
  }
  .card-meta {
    flex: 1;
  }
  .card-subtitle {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    font-weight: 700;
    display: block;
    margin-bottom: 0.2rem;
  }
  .card-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.25;
  }
  .card-pill {
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.6rem;
    border-radius: var(--r-pill);
    background: var(--bg-alt);
    color: var(--muted);
    border: 1px solid var(--line);
    white-space: nowrap;
  }

  /* Card Body */
  .card-body {
    flex: 1;
    margin-bottom: 1.5rem;
  }
  .address-line {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.6;
    margin-bottom: 0.25rem;
  }
  .contacts-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .contact-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .item-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    font-weight: 700;
  }
  .item-value {
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    transition: color 0.2s var(--ease);
    word-break: break-all;
    min-height: 24px;
    display: inline-flex;
    align-items: center;
  }
  .item-value:hover {
    color: var(--gold-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .timings-list {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .timing-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.45rem;
    border-bottom: 1px dashed var(--line);
    font-size: 0.95rem;
  }
  .timing-item:last-child {
    border-bottom: none;
  }
  .timing-day {
    color: var(--muted);
    font-weight: 500;
  }
  .timing-hours {
    font-weight: 600;
    color: var(--ink);
  }

  /* Card Footer */
  .card-footer {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .card-highlight {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .dot-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
    flex-shrink: 0;
  }
  .card-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 44px;
    padding: 0.65rem 1rem;
    border-radius: var(--r-sm);
    background: var(--bg-alt);
    border: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s var(--ease);
  }
  .card-action-btn:hover {
    background: var(--gold);
    color: #101216;
    border-color: var(--gold);
    transform: translateY(-2px);
  }
  .card-action-btn:hover * {
    color: #101216 !important;
  }

  /* Social Connect Bar */
  .social-connect-bar {
    background: var(--surface);
    border: 1px solid var(--line);
