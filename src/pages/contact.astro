</style>

<script>
  // Interactive client-side inquiry form validation and submit handling
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contactUsForm') as HTMLFormElement | null;
    const feedback = document.getElementById('formFeedback') as HTMLDivElement | null;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
    
    if (!form || !feedback || !submitBtn) return;

    const spinner = submitBtn.querySelector('.btn-spinner');
    const btnText = submitBtn.querySelector('.btn-text');

    const nameInput = document.getElementById('userName') as HTMLInputElement | null;
    const emailInput = document.getElementById('userEmail') as HTMLInputElement | null;
    const phoneInput = document.getElementById('userPhone') as HTMLInputElement | null;
    const subjectInput = document.getElementById('userSubject') as HTMLSelectElement | null;
    const messageInput = document.getElementById('userMessage') as HTMLTextAreaElement | null;
    const subjectHidden = document.getElementById('formSubmitSubject') as HTMLInputElement | null;

    const nameError = document.getElementById('nameError');
    const emailError = document.getElementById('emailError');
    const subjectError = document.getElementById('subjectError');
    const messageError = document.getElementById('messageError');

    const clearErrors = () => {
      if (nameError) nameError.textContent = '';
      if (emailError) emailError.textContent = '';
      if (subjectError) subjectError.textContent = '';
      if (messageError) messageError.textContent = '';
      feedback.className = 'form-feedback hidden';
      feedback.textContent = '';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearErrors();

      let isValid = true;

      // Validate Name
      const nameVal = nameInput?.value.trim() || '';
      if (!nameVal || nameVal.length < 2) {
        if (nameError) nameError.textContent = 'Please enter your full name (minimum 2 characters).';
        isValid = false;
      }

      // Validate Email
      const emailVal = emailInput?.value.trim() || '';
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailVal || !emailRegex.test(emailVal)) {
        if (emailError) emailError.textContent = 'Please enter a valid email address.';
        isValid = false;
      }

      // Validate Subject
      const subjectVal = subjectInput?.value || '';
      if (!subjectVal) {
        if (subjectError) subjectError.textContent = 'Please select a reason for your inquiry.';
        isValid = false;
      }

      // Validate Message
      const messageVal = messageInput?.value.trim() || '';
      if (!messageVal || messageVal.length < 10) {
        if (messageError) messageError.textContent = 'Please enter a message of at least 10 characters.';
        isValid = false;
      }

      if (!isValid) {
        feedback.className = 'form-feedback error';
        feedback.textContent = 'Please correct the highlighted fields above and try again.';
        feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        return;
      }

      const phoneVal = phoneInput?.value.trim() || 'Not provided';
      const formattedSubject = `[Don Bosco Shirva Inquiry] ${subjectVal} - ${nameVal}`;
      if (subjectHidden) subjectHidden.value = formattedSubject;

      // Update UI to sending state
      submitBtn.disabled = true;
      if (spinner) spinner.classList.remove('hidden');
      if (btnText) btnText.textContent = 'Sending Message...';

      const payload = {
        name: nameVal,
        email: emailVal,
        phone: phoneVal,
        subject: subjectVal,
        message: messageVal,
        _cc: 'shirvadonboscoschool@gmail.com',
        _replyto: emailVal,
        _subject: formattedSubject,
        _template: 'table',
        _captcha: 'false'
      };

      try {
        const response = await fetch('https://formsubmit.co/ajax/enquires.wrnxt@gmail.com', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        const data = await response.json().catch(() => null);

        if (response.ok && data && (data.success === 'true' || data.success === true)) {
          feedback.className = 'form-feedback success';
          feedback.innerHTML = `<strong>Thank you, ${nameVal}!</strong> Your message has been sent successfully to <em>enquires.wrnxt@gmail.com</em> and <em>shirvadonboscoschool@gmail.com</em>. Our administration team will get back to you at <em>${emailVal}</em> shortly.`;
          form.reset();
        } else if (data && data.message && data.message.toLowerCase().includes('activate')) {
          feedback.className = 'form-feedback success';
          feedback.innerHTML = `<strong>Inquiry Received!</strong> Note: A confirmation link was sent to the administration email to activate this endpoint. Subsequent inquiries will be received immediately.`;
          form.reset();
        } else {
          const msg = (data && data.message) ? data.message : 'Unable to complete submission right now.';
          feedback.className = 'form-feedback error';
          feedback.innerHTML = `<strong>Notice:</strong> ${msg}<br>You can also email us directly at <a href="mailto:enquires.wrnxt@gmail.com,shirvadonboscoschool@gmail.com?subject=${encodeURIComponent(formattedSubject)}&body=${encodeURIComponent(messageVal)}">enquires.wrnxt@gmail.com / shirvadonboscoschool@gmail.com</a>.`;
        }
      } catch (err) {
        feedback.className = 'form-feedback error';
        feedback.innerHTML = `<strong>Network Notice:</strong> Unable to reach the mail server directly. Please email us at <a href="mailto:enquires.wrnxt@gmail.com,shirvadonboscoschool@gmail.com?subject=${encodeURIComponent(formattedSubject)}&body=${encodeURIComponent(messageVal)}">enquires.wrnxt@gmail.com</a> or <a href="mailto:shirvadonboscoschool@gmail.com">shirvadonboscoschool@gmail.com</a>.`;
      } finally {
        submitBtn.disabled = false;
        if (spinner) spinner.classList.add('hidden');
        if (btnText) btnText.textContent = 'Send Message';
        feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  });
</script>
