    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border-radius: var(--r-sm);
    background: var(--bg-alt);
    border: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.25s var(--ease);
  }
  .event-detail-btn:hover, .event-detail-btn:focus-visible {
    background: var(--gold) !important;
