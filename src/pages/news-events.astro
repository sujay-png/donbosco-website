---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Collaborations from '../components/Collaborations.astro';
import { activitiesList, kgActivitiesList } from '../data/news-events';
---

<Layout 
  title="News & Events - Don Bosco English Medium School Shirva"
  description="Explore the latest News and Events at Don Bosco English Medium School Shirva. Browse school activities, cultural fests, sports meets, and kindergarten happenings."
>
  <Header />

  <!-- Page Hero -->
  <section class="page-hero on-image">
    <div class="ph-media" data-parallax="-0.12">
      <img src="/about/old-school.jpg" alt="Don Bosco School Shirva Campus" fetchpriority="high" />
    </div>
    <div class="ph-shade" aria-hidden="true"></div>
    <div class="container ph-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb" data-reveal="fade">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page" class="crumb-current">News &amp; Events</span>
      </nav>
      <h1 class="h1 ph-title" data-split>News &amp; <em>Events</em></h1>
    </div>
  </section>

  <!-- Main Content Area -->
  <main class="inner-main section" id="events-content">
    <div class="container">

      <!-- Intro Section -->
      <header class="events-header" data-reveal>
        <div class="badge-pill">
          <span class="badge-dot"></span>
          Campus Highlights
        </div>
        <h2 class="h2 intro-title">Vibrant Campus Life &amp; Celebrations</h2>
        <p class="intro-desc">
          Experience the dynamic energy, holistic growth, and academic spirit of Don Bosco English Medium School, Shirva. From national festivals and sports meets to kindergarten learning fests, celebrate our students' joyful milestones.
        </p>

        <!-- Stats row -->
        <div class="stats-row">
          <div class="stat-item">
            <span class="stat-number">32+</span>
            <span class="stat-label">Events &amp; Celebrations</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-number">Pre-KG to X</span>
            <span class="stat-label">All-Grade Activities</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-number">100%</span>
            <span class="stat-label">Student Engagement</span>
          </div>
        </div>
      </header>

      <!-- Tabs Navigation -->
      <section class="events-showcase" aria-label="News and Events Categorized">
        <div class="tabs-container" data-reveal="fade">
          <div class="tab-nav-wrapper">
            <div class="tab-nav" role="tablist" aria-label="News and events category tabs">
              
              <!-- Tab 1: Activities -->
              <button 
                type="button" 
                class="tab-btn is-active" 
                role="tab" 
                id="tab-btn-activities" 
                aria-selected="true" 
                aria-controls="tab-panel-activities"
                data-tab="activities"
              >
                <span class="tab-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                </span>
                <span class="tab-title-wrap">
                  <span class="tab-title">Activities</span>
                  <span class="tab-subtitle">Primary &amp; High School</span>
                </span>
                <span class="tab-count">{activitiesList.length} Events</span>
              </button>

              <!-- Tab 2: KG Activities -->
              <button 
                type="button" 
                class="tab-btn" 
                role="tab" 
                id="tab-btn-kg" 
                aria-selected="false" 
                aria-controls="tab-panel-kg"
                data-tab="kg-activities"
              >
                <span class="tab-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
                    <line x1="9" y1="9" x2="9.01" y2="9"/>
                    <line x1="15" y1="9" x2="15.01" y2="9"/>
                  </svg>
                </span>
                <span class="tab-title-wrap">
                  <span class="tab-title">KG Activities</span>
                  <span class="tab-subtitle">Playschool &amp; Kindergarten</span>
                </span>
                <span class="tab-count">{kgActivitiesList.length} Events</span>
              </button>

            </div>
          </div>
        </div>

        <!-- Tab Panels Wrapper -->
        <div class="tab-panels-wrapper">
          
          <!-- Panel 1: Activities -->
          <div 
            class="tab-panel is-active" 
            role="tabpanel" 
            id="tab-panel-activities" 
            aria-labelledby="tab-btn-activities"
            data-panel="activities"
          >
            <div class="panel-header">
              <div class="panel-header-info">
                <span class="panel-tag">School Activities</span>
                <h3 class="panel-title">Primary &amp; Secondary School Events</h3>
              </div>
              <span class="panel-note">Showing all {activitiesList.length} published school activities</span>
            </div>

            <div class="events-grid">
              {activitiesList.map((item, idx) => (
                <article class="event-card" data-reveal="slide-up" style={`--delay: ${idx * 0.05}s`}>
                  <div class="event-media">
                    <img 
                      src={item.localImg} 
                      alt={item.title} 
                      loading="lazy" 
                      decoding="async"
                      width="400"
                      height="260"
                      class="event-img"
                    />
                    <div class="media-overlay">
                      <button 
                        type="button"
                        class="btn-zoom-photo"
                        data-modal-open
                        data-img={item.localImg}
                        data-title={item.title}
                        data-date={item.date}
                        data-desc={item.excerpt}
                        aria-label={`View enlarged photo for ${item.title}`}
                      >
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <circle cx="11" cy="11" r="8"/>
                          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                          <line x1="11" y1="8" x2="11" y2="14"/>
                          <line x1="8" y1="11" x2="14" y2="11"/>
                        </svg>
                        <span>View Photo</span>
                      </button>
                    </div>
                    <span class="event-category-badge">{item.category}</span>
                  </div>

                  <div class="event-content">
                    <div class="event-date">
                      <Icon name="calendar" size={15} />
                      <time datetime={item.rawDate}>{item.date}</time>
                    </div>

                    <h4 class="event-title">
                      <a href={`/news-events/${item.slug}`} class="event-title-link">
                        {item.title}
                      </a>
                    </h4>
                    <p class="event-excerpt">{item.excerpt}</p>

                    <div class="event-footer">
                      <span class="event-brand-tag">Don Bosco Shirva</span>
                      <a 
                        href={`/news-events/${item.slug}`} 
                        class="event-detail-btn"
                        aria-label={`Read full details about ${item.title}`}
                      >
                        <span>Details</span>
                        <Icon name="arrow" size={15} />
                      </a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>

          <!-- Panel 2: KG Activities -->
          <div 
            class="tab-panel" 
            role="tabpanel" 
            id="tab-panel-kg" 
            aria-labelledby="tab-btn-kg"
            data-panel="kg-activities"
          >
            <div class="panel-header">
              <div class="panel-header-info">
                <span class="panel-tag">Kindergarten Corner</span>
                <h3 class="panel-title">Playschool &amp; Kindergarten Activities</h3>
              </div>
              <span class="panel-note">Showing all {kgActivitiesList.length} published kindergarten events</span>
            </div>

            <div class="events-grid">
              {kgActivitiesList.map((item, idx) => (
                <article class="event-card" data-reveal="slide-up" style={`--delay: ${idx * 0.05}s`}>
                  <div class="event-media">
                    <img 
                      src={item.localImg} 
                      alt={item.title} 
                      loading="lazy" 
                      decoding="async"
                      width="400"
                      height="260"
                      class="event-img"
                    />
                    <div class="media-overlay">
                      <button 
                        type="button"
                        class="btn-zoom-photo"
                        data-modal-open
                        data-img={item.localImg}
                        data-title={item.title}
                        data-date={item.date}
                        data-desc={item.excerpt}
                        aria-label={`View enlarged photo for ${item.title}`}
                      >
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <circle cx="11" cy="11" r="8"/>
                          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                          <line x1="11" y1="8" x2="11" y2="14"/>
                          <line x1="8" y1="11" x2="14" y2="11"/>
                        </svg>
                        <span>View Photo</span>
                      </button>
                    </div>
                    <span class="event-category-badge kg-badge">{item.category}</span>
                  </div>

                  <div class="event-content">
                    <div class="event-date">
                      <Icon name="calendar" size={15} />
                      <time datetime={item.rawDate}>{item.date}</time>
                    </div>

                    <h4 class="event-title">
                      <a href={`/news-events/${item.slug}`} class="event-title-link">
                        {item.title}
                      </a>
                    </h4>
                    <p class="event-excerpt">{item.excerpt}</p>

                    <div class="event-footer">
                      <span class="event-brand-tag kg-tag">DB Kindergarten</span>
                      <a 
                        href={`/news-events/${item.slug}`} 
                        class="event-detail-btn"
                        aria-label={`Read full details about ${item.title}`}
                      >
                        <span>Details</span>
                        <Icon name="arrow" size={15} />
                      </a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>

        </div>
      </section>

    </div>
  </main>

  <!-- Interactive Lightbox Modal for Quick Photo Viewing -->
  <dialog class="event-modal" id="eventPhotoModal" aria-modal="true" aria-labelledby="modalEventTitle">
    <div class="modal-backdrop" id="modalBackdrop"></div>
    <div class="modal-dialog">
      <div class="modal-header">
        <div class="modal-header-meta">
          <span class="modal-date-pill" id="modalEventDate"></span>
          <h3 class="modal-title" id="modalEventTitle"></h3>
        </div>
        <button type="button" class="modal-close-btn" id="modalCloseBtn" aria-label="Close dialog">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="modal-body">
        <div class="modal-image-wrapper">
          <img src="" alt="" id="modalEventImg" class="modal-full-img" />
        </div>
        <div class="modal-caption-wrapper">
          <p class="modal-desc" id="modalEventDesc"></p>
        </div>
      </div>
    </div>
  </dialog>

  <!-- Partner Affiliations Marquee -->
  <Collaborations />

  <Footer />
</Layout>

<style>
  /* ==========================================================================
     News & Events Page Styles — Editorial Academic Design System
     ========================================================================== */

  /* Page Hero */
  .page-hero {
    position: relative;
    padding-top: calc(var(--header-h) + clamp(2.5rem, 5vw, 4.5rem));
    padding-bottom: clamp(3rem, 6vw, 5rem);
    background: var(--deep);
    color: var(--on-deep);
    overflow: hidden;
  }
  .page-hero.on-image .ph-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.38;
    filter: saturate(0.85);
  }
  .page-hero.on-image .ph-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }
  .ph-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(11, 12, 15, 0.75) 0%, rgba(11, 12, 15, 0.94) 100%);
    z-index: 1;
  }
  .ph-inner {
    position: relative;
    z-index: 2;
  }
  .breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--on-deep-muted);
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .breadcrumb a {
    color: var(--on-deep-muted);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }
  .breadcrumb a:hover {
    color: var(--gold);
  }
  .crumb-current {
    color: var(--gold);
    font-weight: 600;
  }
  .ph-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.15;
    font-weight: 500;
    color: var(--on-deep);
    margin: 0;
  }
  .ph-title em {
    font-style: italic;
    color: var(--gold);
    font-family: var(--font-display);
  }

  /* Main Content */
  .inner-main {
    padding-block: clamp(3.5rem, 7vw, 6rem);
    background: var(--bg);
  }

  /* Events Header */
  .events-header {
    max-width: 820px;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem) auto;
    text-align: center;
  }
  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    border-radius: var(--r-pill);
    background: rgba(255, 182, 6, 0.12);
    border: 1px solid rgba(255, 182, 6, 0.35);
    color: var(--gold-text);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 8px var(--gold);
  }
  .intro-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    line-height: 1.25;
    color: var(--ink);
    margin-bottom: 1rem;
    font-weight: 600;
  }
  .intro-desc {
    font-size: clamp(1rem, 1.2vw, 1.12rem);
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  /* Stats Row */
  .stats-row {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 1.25rem 2rem;
    box-shadow: var(--shadow-sm);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: 0.5rem;
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }
  .stat-number {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--gold-text);
    line-height: 1.1;
  }
  .stat-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .stat-divider {
    width: 1px;
    height: 38px;
    background: var(--line);
  }

  /* ==========================================================================
     Tab Navigation Styles
     ========================================================================= */
  .events-showcase {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .tabs-container {
    display: flex;
    justify-content: center;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .tab-nav-wrapper {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    padding: 0.4rem;
    box-shadow: var(--shadow-sm);
    display: inline-flex;
  }
  .tab-nav {
    display: flex;
    gap: 0.4rem;
  }
  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 1.6rem;
    min-height: 54px;
    border-radius: var(--r-pill);
    border: none;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    transition: all 0.3s var(--ease);
    position: relative;
    outline: none;
    text-align: left;
  }
  .tab-btn:hover {
    color: var(--ink);
    background: var(--bg-alt);
  }
  .tab-btn.is-active {
    background: var(--gold);
    color: #101216;
    box-shadow: 0 4px 18px -4px rgba(255, 182, 6, 0.6);
  }
  .tab-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s var(--ease);
  }
  .tab-btn.is-active .tab-icon {
    transform: scale(1.1);
  }
  .tab-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .tab-title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .tab-subtitle {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.75;
  }
  .tab-count {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: var(--r-pill);
    background: rgba(16, 18, 22, 0.08);
    color: inherit;
    margin-left: 0.35rem;
  }
  .tab-btn.is-active .tab-count {
    background: rgba(16, 18, 22, 0.15);
    color: #101216;
  }

  /* Tab Panels */
  .tab-panel {
    display: none;
  }
  .tab-panel.is-active {
    display: block;
    animation: panel-fade-in 0.4s var(--ease);
  }
  @keyframes panel-fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Panel Header */
  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
    flex-wrap: wrap;
  }
  .panel-header-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .panel-tag {
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-text);
  }
  .panel-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    color: var(--ink);
    margin: 0;
    font-weight: 600;
  }
  .panel-note {
    font-size: 0.84rem;
    color: var(--muted);
    background: var(--surface);
    padding: 0.4rem 0.9rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--line);
  }

  /* ==========================================================================
     Events Grid & Card Styles
     ========================================================================== */
  .events-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 2.5vw, 2.25rem);
  }

  .event-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease), border-color 0.4s var(--ease);
  }
  .event-card:hover {
    transform: translateY(-7px);
    box-shadow: var(--shadow);
    border-color: rgba(255, 182, 6, 0.4);
  }

  /* Event Media */
  .event-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--bg-alt);
  }
  .event-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .event-card:hover .event-img {
    transform: scale(1.06);
  }

  .media-overlay {
    position: absolute;
    inset: 0;
    background: rgba(16, 18, 22, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s var(--ease);
    backdrop-filter: blur(2px);
  }
  .event-card:hover .media-overlay {
    opacity: 1;
  }

  .btn-zoom-photo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.15rem;
    min-height: 44px;
    border-radius: var(--r-pill);
    background: #FFFFFF;
    color: #101216;
    border: none;
    font-size: 0.84rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s var(--ease), background 0.2s var(--ease);
  }
  .btn-zoom-photo:hover {
    transform: scale(1.06);
    background: var(--gold);
  }

  .event-category-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.35rem 0.8rem;
    border-radius: var(--r-pill);
    background: rgba(16, 18, 22, 0.75);
    backdrop-filter: blur(8px);
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border: 1px solid rgba(255, 255, 255, 0.2);
    z-index: 2;
  }
  .event-category-badge.kg-badge {
    background: rgba(62, 63, 240, 0.85);
  }

  /* Event Content */
  .event-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .event-date {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--gold-text);
    margin-bottom: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .event-title {
    font-family: var(--font-display);
    font-size: 1.22rem;
    line-height: 1.35;
    margin-bottom: 0.75rem;
    font-weight: 600;
  }
  .event-title-link {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }
  .event-title-link:hover {
    color: var(--gold-deep);
  }
  .event-excerpt {
