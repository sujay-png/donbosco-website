  :global([data-theme="dark"]) .event-detail-btn:hover,
  :global([data-theme="dark"]) .event-detail-btn:focus-visible {
    background: var(--gold) !important;
    color: #0b0c0f !important;
    border-color: var(--gold) !important;
  }
  :global([data-theme="dark"]) .event-detail-btn:hover * {
    color: #0b0c0f !important;
  }

  /* ==========================================================================
     Lightbox Modal
     ========================================================================== */
  .event-modal {
    border: none;
    background: transparent;
    padding: 0;
    max-width: 900px;
    width: 92vw;
    margin: auto;
    position: fixed;
    inset: 0;
    z-index: 9999;
    box-shadow: none;
    overflow: visible;
  }
  .event-modal::backdrop {
    background: rgba(11, 12, 15, 0.85);
    backdrop-filter: blur(6px);
