<script>
  function initStaffExplorer() {
    const filterPills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const searchInput = document.getElementById('facultySearch') as HTMLInputElement | null;
    const searchClear = document.getElementById('searchClear') as HTMLButtonElement | null;
    const resultsCount = document.getElementById('resultsCount');
    const cards = document.querySelectorAll<HTMLElement>('.staff-card');
    const tableRows = document.querySelectorAll<HTMLElement>('#complianceTable tbody tr');
    const noResultsBox = document.getElementById('noResultsBox');
    const resetBtn = document.getElementById('resetFiltersBtn');
    const viewModeBtns = document.querySelectorAll<HTMLButtonElement>('.view-mode-btn');
    const cardGrid = document.getElementById('staffCardGrid');
    const tableView = document.getElementById('staffTableView');

    let currentFilter = 'all';
    let searchQuery = '';
    let currentView = 'grid';

    function applyFilters() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const tags = (card.dataset.tags || '').split(' ');
        const name = card.dataset.name || '';
        const code = card.dataset.code || '';
        const desig = card.dataset.desig || '';

        const matchesCat = currentFilter === 'all' || tags.includes(currentFilter);
        const matchesSearch = !searchQuery || 
          name.includes(searchQuery) || 
          code.includes(searchQuery) || 
          desig.includes(searchQuery);

        if (matchesCat && matchesSearch) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Filter table rows synchronously
      tableRows.forEach((row) => {
        const name = row.dataset.name || '';
        const code = row.dataset.code || '';
        const desig = row.dataset.desig || '';

        const matchesSearch = !searchQuery || 
          name.includes(searchQuery) || 
          code.includes(searchQuery) || 
          desig.includes(searchQuery);

        row.style.display = matchesSearch ? '' : 'none';
      });

      if (resultsCount) {
        resultsCount.innerHTML = 'Showing <strong>' + visibleCount + '</strong> faculty members';
      }

      if (noResultsBox) {
        noResultsBox.classList.toggle('hidden', visibleCount > 0);
      }
    }

    // Filter pill click
    filterPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        filterPills.forEach((p) => {
          p.classList.remove('is-active');
          p.setAttribute('aria-selected', 'false');
        });
        pill.classList.add('is-active');
        pill.setAttribute('aria-selected', 'true');
        currentFilter = pill.dataset.filter || 'all';
        applyFilters();
      });
    });

    // Search input
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value.trim().toLowerCase();
        if (searchClear) {
          searchClear.classList.toggle('hidden', searchQuery.length === 0);
        }
        applyFilters();
      });
    }

    if (searchClear && searchInput) {
      searchClear.addEventListener('click', () => {
        searchInput.value = '';
        searchQuery = '';
        searchClear.classList.add('hidden');
        searchInput.focus();
        applyFilters();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        if (searchClear) searchClear.classList.add('hidden');
        filterPills.forEach((p, idx) => {
          p.classList.toggle('is-active', idx === 0);
          p.setAttribute('aria-selected', idx === 0 ? 'true' : 'false');
        });
        currentFilter = 'all';
        applyFilters();
      });
    }

    // View toggle (Grid vs Table)
    viewModeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.dataset.viewMode;
        if (!mode) return;
        currentView = mode;

        viewModeBtns.forEach((b) => b.classList.toggle('is-active', b === btn));

        if (cardGrid && tableView) {
          if (mode === 'grid') {
            cardGrid.classList.remove('hidden');
            tableView.classList.add('hidden');
          } else {
            cardGrid.classList.add('hidden');
            tableView.classList.remove('hidden');
          }
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStaffExplorer);
  } else {
    initStaffExplorer();
  }
</script>

