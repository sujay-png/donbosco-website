---
import Icon from './Icon.astro';
const photos = [
  { src: '/gallery/1.jpg', alt: 'School Event 1' },
  { src: '/gallery/2.jpg', alt: 'School Event 2' },
  { src: '/gallery/3.jpg', alt: 'School Event 3' },
];
const videos = [
  { src: '/gallery/5.jpg', alt: 'School Video 1', videoId: 'YE7VzlLtp-4' },
  { src: '/gallery/6.jpg', alt: 'School Video 2', videoId: 'YE7VzlLtp-4' },
  { src: '/gallery/1.jpg', alt: 'School Video 3', videoId: 'YE7VzlLtp-4' },
];
---
<section id="gallery" class="section gallery">
  <div class="container">
    <div class="sec-head">
      <div class="sec-meta" data-reveal>
        <span class="sec-index">(05)</span>
        <span class="eyebrow">Moments To Cherish</span>
      </div>
      <div class="sec-title-wrap gal-title-row">
        <h2 class="h2" data-split>Photo &amp; Video <em>Gallery</em></h2>
        <div class="tabs" role="tablist" aria-label="Gallery type" data-reveal>
          <button role="tab" aria-selected="true" aria-controls="panel-photos" id="tab-photos" class="tab" data-tab="photos">Photo Gallery</button>
          <button role="tab" aria-selected="false" aria-controls="panel-videos" id="tab-videos" class="tab" data-tab="videos" tabindex="-1">Video Gallery</button>
          <span class="tab-pill" aria-hidden="true"></span>
        </div>
      </div>
    </div>

    <div class="gal-panels">
      <div class="bento is-active" id="panel-photos" role="tabpanel" aria-labelledby="tab-photos" data-panel="photos">
        {photos.map((p, i) => (
          <figure class:list={['bento-item', `b-${i + 1}`]} data-reveal="clip" style={`--d:${i * 0.1}s`}>
            <img src={p.src} alt={p.alt} loading="lazy" />
            <figcaption><span>{String(i + 1).padStart(2, '0')}</span></figcaption>
          </figure>
        ))}
        <a href="/photo-gallery" class="bento-more b-4" data-reveal style="--d:.3s">
          <span class="bm-label">View Photo Gallery</span>
          <span class="bm-icon"><Icon name="arrow-up-right" size={26} /></span>
        </a>
      </div>

      <div class="bento" id="panel-videos" role="tabpanel" aria-labelledby="tab-videos" data-panel="videos" hidden>
        {videos.map((v, i) => (
          <button type="button" class:list={['bento-item video-item', `b-${i + 1}`]} data-video-id={v.videoId} aria-label={`Play ${v.alt}`}>
            <img src={v.src} alt={v.alt} loading="lazy" />
            <span class="play"><Icon name="play" size={22} /></span>
            <span class="video-tag">Watch Us In Action</span>
          </button>
        ))}
        <a href="/video-gallery" class="bento-more b-4">
          <span class="bm-label">View Video Gallery</span>
          <span class="bm-icon"><Icon name="arrow-up-right" size={26} /></span>
        </a>
      </div>
    </div>
  </div>

  <dialog id="video-modal" class="video-modal" aria-label="Video player">
    <button id="close-video-modal" class="vm-close" aria-label="Close video"><Icon name="close" size={22} /></button>
    <div class="vm-frame" id="video-container"></div>
  </dialog>
</section>

<script>
  // Tabs
  const tabs = document.querySelectorAll<HTMLButtonElement>('.gallery .tab');
  const panels = document.querySelectorAll<HTMLElement>('.gallery [data-panel]');
  const tablist = document.querySelector<HTMLElement>('.gallery .tabs');
  const select = (name: string) => {
    tabs.forEach((t) => {
      const on = t.dataset.tab === name;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
    });
    tablist?.setAttribute('data-active', name);
    panels.forEach((p) => {
      const on = p.dataset.panel === name;
      p.hidden = !on;
      p.classList.toggle('is-active', on);
      if (on) p.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-in'));
    });
  };
  tabs.forEach((t) => {
    t.addEventListener('click', () => select(t.dataset.tab!));
    t.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        const next = t.dataset.tab === 'photos' ? 'videos' : 'photos';
        select(next);
        (document.querySelector(`.gallery .tab[data-tab="${next}"]`) as HTMLElement)?.focus();
      }
    });
  });

  // Video modal
  const modal = document.getElementById('video-modal') as HTMLDialogElement | null;
  const frame = document.getElementById('video-container');
  const closeBtn = document.getElementById('close-video-modal');
  const lenis = () => (window as any).__lenis;
  const close = () => { modal?.close(); };
  document.querySelectorAll<HTMLElement>('.video-item').forEach((item) => {
    item.addEventListener('click', () => {
      const id = item.dataset.videoId;
      if (!id || !modal || !frame) return;
      frame.innerHTML = `<iframe src="https://www.youtube.com/embed/${id}?autoplay=1&rel=0" title="School video" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`;
      modal.showModal();
      lenis()?.stop();
    });
  });
  closeBtn?.addEventListener('click', close);
  modal?.addEventListener('click', (e) => { if (e.target === modal) close(); });
  modal?.addEventListener('close', () => { if (frame) frame.innerHTML = ''; lenis()?.start(); });
</script>

<style>
  .gal-title-row { flex-direction: row !important; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; }

  .tabs {
    position: relative;
    display: inline-grid; grid-template-columns: 1fr 1fr;
    padding: 5px; border-radius: var(--r-pill);
    border: 1px solid var(--line-strong);
    background: var(--surface);
  }
  .tab {
    position: relative; z-index: 1;
    padding: .7rem 1.25rem; min-height: 44px;
    border-radius: var(--r-pill);
    font-size: .88rem; font-weight: 700; white-space: nowrap;
    color: var(--muted);
    transition: color .4s var(--ease);
  }
  .tab[aria-selected="true"] { color: #101216; }
  .tab-pill {
    position: absolute; top: 5px; bottom: 5px; left: 5px; width: calc(50% - 5px);
    border-radius: var(--r-pill); background: var(--gold);
    transition: transform .55s var(--ease);
  }
  .tabs[data-active="videos"] .tab-pill { transform: translateX(100%); }

  .bento {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    grid-template-rows: repeat(2, clamp(200px, 20vw, 290px));
    gap: .9rem;
  }
  .bento[hidden] { display: none; }
  .bento.is-active > * { animation: bentoIn .9s var(--ease) both; }
  .bento.is-active > *:nth-child(2) { animation-delay: .06s; }
  .bento.is-active > *:nth-child(3) { animation-delay: .12s; }
  .bento.is-active > *:nth-child(4) { animation-delay: .18s; }
  @keyframes bentoIn { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }

  .bento-item {
    position: relative; margin: 0; overflow: hidden;
    border-radius: var(--r-lg); background: var(--bg-alt);
    display: block; width: 100%; padding: 0; text-align: left;
  }
  .bento-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .bento-item:hover img { transform: scale(1.06); }
  .b-1 { grid-row: 1 / 3; }
  .b-2 { grid-column: 2 / 4; }
  .b-3 { grid-column: 2 / 3; }
  .b-4 { grid-column: 3 / 4; }

  .bento-item figcaption {
    position: absolute; left: 1rem; bottom: 1rem;
    font-family: var(--font-display); font-style: italic; color: #fff;
    width: 44px; height: 44px; border-radius: 50%;
    display: grid; place-items: center;
    background: rgba(0,0,0,.35); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(255,255,255,.3);
  }

  .bento-more {
    border-radius: var(--r-lg);
    background: var(--deep); color: var(--on-deep);
    padding: 1.5rem;
    display: flex; flex-direction: column; justify-content: space-between;
    transition: background .5s var(--ease), color .5s;
  }
  :global([data-theme="dark"]) .bento-more { background: var(--surface); border: 1px solid var(--line); }
  .bento-more:hover { background: var(--gold); color: #101216; }
  .bm-label { font-family: var(--font-display); font-size: clamp(1.4rem, 2vw, 1.9rem); line-height: 1.1; max-width: 9ch; }
  .bm-icon {
    align-self: flex-end; width: 56px; height: 56px; border-radius: 50%;
    border: 1px solid currentColor; display: grid; place-items: center;
    transition: transform .6s var(--ease);
  }
  .bento-more:hover .bm-icon { transform: rotate(45deg); }

  .video-item { cursor: pointer; }
  .video-item::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(0,0,0,.6)); }
  .play {
    position: absolute; left: 50%; top: 50%; z-index: 1;
    width: 76px; height: 76px; margin: -38px 0 0 -38px; border-radius: 50%;
    background: var(--gold); color: #101216;
    display: grid; place-items: center;
    box-shadow: 0 0 0 0 rgba(255,182,6,.55);
    animation: pulse 2.2s infinite;
    transition: transform .5s var(--ease);
  }
  .play :global(svg) { margin-left: 3px; }
  .video-item:hover .play { transform: scale(1.12); }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(255,182,6,.55); } 100% { box-shadow: 0 0 0 26px rgba(255,182,6,0); } }
  .video-tag {
    position: absolute; left: 1.1rem; bottom: 1rem; z-index: 1;
    color: #fff; font-size: .7rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase;
  }

  /* Modal */
  .video-modal {
    width: min(1100px, 92vw);
    margin: auto; padding: 0; border: 0; background: transparent; overflow: visible;
  }
  .video-modal::backdrop { background: rgba(6,7,9,.88); backdrop-filter: blur(6px); }
  .vm-frame { position: relative; aspect-ratio: 16 / 9; border-radius: var(--r); overflow: hidden; background: #000; }
  .vm-frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .vm-close {
    position: absolute; right: 0; top: -60px;
    width: 48px; height: 48px; border-radius: 50%;
    background: #fff; color: #101216; display: grid; place-items: center;
  }

  @media (max-width: 768px) {
    .bento { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
    .b-1 { grid-column: 1 / 3; grid-row: auto; aspect-ratio: 4 / 3; }
    .b-2 { grid-column: 1 / 3; aspect-ratio: 16 / 10; }
    .b-3, .b-4 { grid-column: auto; aspect-ratio: 1; }
    .bento-more { padding: 1.1rem; }
    .bm-icon { width: 46px; height: 46px; }
    .tabs { width: 100%; }
    .tab { padding-inline: .75rem; }
  }
  @media (max-width: 480px) {
    .bento { grid-template-columns: 1fr; }
    .b-1, .b-2, .b-3, .b-4 { grid-column: 1 / -1; aspect-ratio: 16 / 10; }
    .bento-more { aspect-ratio: auto; min-height: 100px; flex-direction: row; align-items: center; justify-content: space-between; }
    .bm-label { max-width: none; font-size: 1.3rem; }
    .bm-icon { align-self: center; }
    .vm-close { top: -48px; right: 8px; width: 40px; height: 40px; }
  }
</style>
