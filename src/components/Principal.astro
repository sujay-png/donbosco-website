---
import Icon from './Icon.astro';
---
<section class="section deep principal" aria-labelledby="principal-title">
  <div class="principal-glow" aria-hidden="true"></div>
  <div class="container">
    <div class="principal-grid">
      <figure class="principal-portrait" data-reveal>
        <div class="media arch portrait-frame" data-reveal="clip">
          <img src="/about/principal.jpg" alt="Rev. Fr. Rolwyn Aranha, Principal" loading="lazy" />
        </div>
        <figcaption class="portrait-cap">
          <span class="cap-name">Rev. Fr. Rolwyn Aranha</span>
          <span class="cap-role">Principal</span>
        </figcaption>
        <span class="portrait-ring" aria-hidden="true"></span>
      </figure>

      <div class="principal-copy">
        <div class="sec-meta-inline" data-reveal>
          <span class="sec-index">(02)</span>
          <span class="eyebrow">Principal's Message</span>
        </div>

        <span class="quote-mark" data-reveal aria-hidden="true"><Icon name="quote" size={56} /></span>

        <blockquote class="principal-quote">
          <p class="h2" id="principal-title" data-split>“An investment in knowledge pays the <em>best interest.</em>”</p>
          <cite data-reveal style="--d:.3s">— Benjamin Franklin</cite>
        </blockquote>

        <p class="principal-text" data-reveal style="--d:.15s">
          Welcome to Don Bosco School, a vibrant and dynamic community dedicated to providing exceptional education. We believe in the holistic development of our students, nurturing them to grow in truth and purity.
        </p>

        <div class="principal-foot" data-reveal style="--d:.25s">
          <a href="/about/messages/principal-message" class="btn btn-gold">Read Full Message <Icon name="arrow" class="arrow" /></a>
          <span class="signature">Rev. Fr. Rolwyn Aranha</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .principal { overflow: hidden; }
  .principal-glow {
    position: absolute; width: 60vw; height: 60vw; max-width: 900px; max-height: 900px;
    right: -20vw; top: -20vw;
    background: radial-gradient(closest-side, rgba(255,182,6,.16), transparent 70%);
    pointer-events: none;
  }
  .principal-grid {
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
  }
  .principal-portrait { position: relative; max-width: 460px; margin: 0; }
  .portrait-frame { aspect-ratio: 4 / 5; border-radius: 999px 999px var(--r-lg) var(--r-lg); }
  .js .portrait-frame[data-reveal="clip"] { clip-path: inset(100% 0 0 0 round 999px 999px var(--r-lg) var(--r-lg)); }
  .js .portrait-frame[data-reveal="clip"].is-in { clip-path: inset(0 0 0 0 round 999px 999px var(--r-lg) var(--r-lg)); }
  .portrait-frame img { object-position: 30% center; }
  .portrait-ring {
    position: absolute; inset: -14px; z-index: -1;
    border: 1px solid rgba(255,182,6,.45);
    border-radius: 999px 999px calc(var(--r-lg) + 14px) calc(var(--r-lg) + 14px);
  }
  .portrait-cap {
    position: absolute; left: 50%; bottom: -1.25rem; transform: translateX(-50%);
    background: var(--gold); color: #101216;
    padding: .8rem 1.4rem; border-radius: var(--r-pill);
    display: flex; flex-direction: column; align-items: center; white-space: nowrap;
    box-shadow: 0 20px 40px -20px rgba(0,0,0,.6);
  }
  .cap-name { font-family: var(--font-display); font-size: 1.05rem; line-height: 1.2; }
  .cap-role { font-size: .66rem; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; }

  .principal-copy { display: flex; flex-direction: column; gap: 1.6rem; }
  .sec-meta-inline { display: flex; align-items: center; gap: 1rem; }
  .quote-mark { color: var(--gold); opacity: .9; margin-bottom: -.5rem; }
  .principal-quote { display: flex; flex-direction: column; gap: 1rem; }
  .principal-quote p { color: var(--on-deep); }
  .principal-quote cite { font-style: normal; font-weight: 700; font-size: .85rem; letter-spacing: .14em; text-transform: uppercase; color: var(--on-deep-muted); }
  .principal-text { font-size: 1.1rem; color: var(--on-deep-muted); max-width: 56ch; }
  .principal-foot { display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; padding-top: 1.5rem; border-top: 1px solid var(--on-deep-line); }
  .signature { font-family: var(--font-display); font-style: italic; font-size: 1.5rem; color: var(--gold); font-weight: 300; font-variation-settings: "opsz" 144, "SOFT" 100, "WONK" 1; }

  @media (max-width: 992px) {
    .principal-grid { grid-template-columns: 1fr; }
    .principal-portrait { max-width: 380px; margin-inline: auto; margin-bottom: 1.5rem; width: 100%; }
  }
  @media (max-width: 768px) {
    .principal-portrait { max-width: 300px; }
    .signature { font-size: 1.25rem; }
  }
  @media (max-width: 480px) {
    .principal-portrait { max-width: 250px; }
    .portrait-ring { inset: -8px; }
    .principal-foot { flex-direction: column; align-items: stretch; gap: 1rem; }
    .principal-foot .btn { width: 100%; justify-content: center; }
    .signature { text-align: center; }
  }
</style>
