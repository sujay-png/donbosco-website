---
import Icon from './Icon.astro';
---

<div 
  id="admissionPopup" 
  class="adm-popup-backdrop" 
  role="dialog" 
  aria-modal="true" 
  aria-labelledby="popupTitle" 
  aria-hidden="true"
>
  <div class="adm-popup-dialog">
    <!-- Close button with minimum 44x44px touch target -->
    <button 
      type="button" 
      class="adm-popup-close" 
      id="closeAdmissionPopup" 
      aria-label="Close admission announcement"
    >
      <Icon name="close" size={20} />
    </button>

    <!-- Visual Media Column / Header -->
    <div class="adm-popup-media">
      <img 
        src="/hero_new.jpg" 
        alt="Don Bosco English Medium School Campus" 
        class="adm-popup-img"
        loading="eager"
        width="600"
        height="800"
      />
      <div class="adm-popup-media-overlay" aria-hidden="true"></div>
      
      <div class="adm-popup-media-content">
        <div class="adm-brand-badge">
          <img src="/logo.jpg" alt="Don Bosco School Emblem" class="adm-logo-mini" width="48" height="48" />
          <div class="adm-brand-meta">
            <span class="adm-school-name">Don Bosco</span>
            <span class="adm-school-sub">English Medium School • Shirva</span>
          </div>
        </div>

        <div class="adm-media-footer">
          <span class="adm-pill-gold">Academic Year 2027–28</span>
          <p class="adm-media-quote">“Growing in Truth &amp; Purity — Shaping Confident Leaders of Tomorrow.”</p>
          <div class="adm-mini-tags">
            <span class="mini-tag">CBSE Affiliated</span>
            <span class="mini-tag">Since 1983</span>
            <span class="mini-tag">Play School to Class X</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Content & Action Column -->
    <div class="adm-popup-body">
      <div class="adm-badge-row">
        <span class="adm-live-badge">
          <span class="pulse-dot" aria-hidden="true"></span>
          Admissions Open 2027–28
        </span>
        <span class="adm-grade-badge">Pre-Primary to Grade 10</span>
      </div>

      <div class="adm-header">
        <h2 id="popupTitle" class="adm-popup-title">
          Admissions Open for <span class="highlight-gold">AY 2027–28</span>
        </h2>
        <p class="adm-popup-subtitle">
          Join the Don Bosco Shirva family. Give your child an enriching educational journey built on academic brilliance, moral character, and innovative CBSE learning.
        </p>
      </div>

      <!-- Feature Grid -->
      <div class="adm-features-grid">
        <div class="adm-feat-item">
          <div class="adm-feat-icon" aria-hidden="true">🎓</div>
          <div class="adm-feat-text">
            <strong>Exemplary CBSE Curriculum</strong>
            <span>Play School, Nursery, LKG, UKG &amp; Grades 1 to 10 with child-centric experiential learning.</span>
          </div>
        </div>
        <div class="adm-feat-item">
          <div class="adm-feat-icon" aria-hidden="true">💡</div>
          <div class="adm-feat-text">
            <strong>Modern Infrastructure</strong>
            <span>Interactive smart classrooms, advanced computer center &amp; fully equipped science labs.</span>
          </div>
        </div>
        <div class="adm-feat-item">
          <div class="adm-feat-icon" aria-hidden="true">⚽</div>
          <div class="adm-feat-text">
            <strong>Sports &amp; Holistic Growth</strong>
            <span>Expansive playground, athletics coaching, yoga, music, cultural arts, and active clubs.</span>
          </div>
        </div>
        <div class="adm-feat-item">
          <div class="adm-feat-icon" aria-hidden="true">🛡️</div>
          <div class="adm-feat-text">
            <strong>Safe &amp; Nurturing Campus</strong>
            <span>24/7 CCTV surveillance, caring qualified educators, and well-connected school bus service.</span>
          </div>
        </div>
      </div>

      <!-- Urgency Callout -->
      <div class="adm-urgency-box">
        <span class="urgency-icon" aria-hidden="true">⚡</span>
        <span class="urgency-text">
          <strong>Limited Seats Available:</strong> Admissions for Academic Year 2027–28 are processed on a first-come, first-served basis. Apply early to secure your seat.
        </span>
      </div>

      <!-- Call To Actions -->
      <div class="adm-popup-actions">
        <a href="/admission" class="adm-btn-primary" id="popupApplyBtn">
          <span>Go to Admission Page &amp; Guidelines</span>
          <Icon name="arrow" size={18} class="arrow-ic" />
        </a>

        <div class="adm-popup-subactions">
          <a href="tel:+918722089715" class="adm-contact-link" aria-label="Call school helpline">
            <Icon name="phone" size={16} />
            <span>Call Helpline: +91 87220 89715</span>
          </a>
          <button type="button" class="adm-btn-dismiss" id="popupDismissText">
            Continue to Website &rarr;
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function setupAdmissionPopup() {
    const popup = document.getElementById('admissionPopup');
    if (!popup) return;

    const closeBtn = document.getElementById('closeAdmissionPopup');
    const applyBtn = document.getElementById('popupApplyBtn');
    const dismissBtn = document.getElementById('popupDismissText');
    const STORAGE_KEY = 'dbems_admission_popup_2027_28_dismissed';

    // Check if dismissed in this session or if forced via query param (?admission-popup=true)
    const urlParams = new URLSearchParams(window.location.search);
    const forceOpen = urlParams.get('admission-popup') === 'true';
    const isDismissed = sessionStorage.getItem(STORAGE_KEY) === 'true';

    // Do not show if dismissed in this session unless explicitly forced
    if (isDismissed && !forceOpen) {
      return;
    }

    function openPopup() {
      if (!popup) return;
      popup.classList.add('is-open');
      popup.setAttribute('aria-hidden', 'false');
      document.body.classList.add('adm-popup-active');

      // Trap focus or focus on close button for accessibility
      setTimeout(() => {
        closeBtn?.focus();
      }, 100);
    }

    function closePopup() {
      if (!popup) return;
      popup.classList.remove('is-open');
      popup.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('adm-popup-active');
      sessionStorage.setItem(STORAGE_KEY, 'true');
    }

    // Attach listeners
    closeBtn?.addEventListener('click', closePopup);
    dismissBtn?.addEventListener('click', closePopup);
    applyBtn?.addEventListener('click', () => {
      sessionStorage.setItem(STORAGE_KEY, 'true');
    });

    // Close when clicking directly on the backdrop
    popup.addEventListener('click', (e) => {
      if (e.target === popup) {
        closePopup();
      }
    });

    // Close with Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && popup.classList.contains('is-open')) {
        closePopup();
      }
    });

    // Delay display slightly (600ms) for a silky entrance after initial page load
    setTimeout(openPopup, 600);
  }

  // Initialize on DOM load or view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAdmissionPopup);
  } else {
    setupAdmissionPopup();
  }
  document.addEventListener('astro:page-load', setupAdmissionPopup);
</script>

<style>
  /* ==========================================================================
     Admission Open 2027-28 Pop-up Modal Styles (Mobile-First & Fully Responsive)
     ========================================================================== */

  .adm-popup-backdrop {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(0.5rem, 2vw, 1.5rem);
    background: rgba(8, 10, 14, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.38s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.38s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .adm-popup-backdrop.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Prevent background scroll when popup is active */
  :global(body.adm-popup-active) {
    overflow: hidden !important;
  }

  /* Modal Dialog Container - Mobile-first uses flex column so body scrolls properly */
  .adm-popup-dialog {
    position: relative;
    width: 100%;
    max-width: 1020px;
    max-height: min(92vh, 880px);
    display: flex;
    flex-direction: column;
    background: #11141A;
    color: #F4F1EA;
    border-radius: clamp(1.1rem, 2.5vw, 1.85rem);
    border: 1px solid rgba(255, 182, 6, 0.28);
    box-shadow: 0 28px 80px -16px rgba(0, 0, 0, 0.8),
                0 0 0 1px rgba(255, 255, 255, 0.08);
    overflow: hidden;
    transform: scale(0.92) translateY(24px);
    transition: transform 0.42s cubic-bezier(0.2, 1, 0.3, 1);
  }

  .adm-popup-backdrop.is-open .adm-popup-dialog {
    transform: scale(1) translateY(0);
  }

  /* Close Button (Min 44x44px touch target) */
  .adm-popup-close {
    position: absolute;
    top: clamp(0.75rem, 2vw, 1.35rem);
    right: clamp(0.75rem, 2vw, 1.35rem);
    z-index: 20;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    border-radius: 50%;
    background: rgba(18, 22, 28, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #F4F1EA;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.2, 1, 0.3, 1);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
  }

  .adm-popup-close:hover,
  .adm-popup-close:focus-visible {
    background: var(--gold, #FFB606);
    color: #101216;
    border-color: var(--gold, #FFB606);
    transform: scale(1.08) rotate(90deg);
  }

  /* Media Visual Column / Banner */
  .adm-popup-media {
    position: relative;
    width: 100%;
    height: clamp(120px, 20vh, 145px);
    min-height: 120px;
    flex-shrink: 0;
    overflow: hidden;
    background: #0B0D12;
  }

  .adm-popup-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    transform: scale(1.04);
    filter: brightness(0.9);
  }

  .adm-popup-media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(17, 20, 26, 0.35) 0%,
      rgba(17, 20, 26, 0.85) 75%,
      rgba(17, 20, 26, 1) 100%
    );
  }

  .adm-popup-media-content {
    position: absolute;
    inset: 0;
    padding: 0.85rem 1.1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    z-index: 2;
  }

  .adm-brand-badge {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: rgba(10, 12, 16, 0.8);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.3rem 0.75rem 0.3rem 0.3rem;
    border-radius: 999px;
    width: fit-content;
    max-width: calc(100% - 56px); /* Never overlap with close button */
  }

  .adm-logo-mini {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .adm-brand-meta {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    overflow: hidden;
  }

  .adm-school-name {
    font-size: 0.9rem;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .adm-school-sub {
    font-size: 0.68rem;
    color: rgba(244, 241, 234, 0.75);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .adm-media-footer {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .adm-pill-gold {
    align-self: flex-start;
    padding: 0.25rem 0.75rem;
    background: var(--gold, #FFB606);
    color: #101216;
    font-size: 0.76rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 999px;
  }

  .adm-media-quote {
    font-family: var(--font-display, Georgia, serif);
    font-size: 0.95rem;
    font-style: italic;
    color: #F4F1EA;
    line-height: 1.35;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
  }

  .adm-mini-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .mini-tag {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #F4F1EA;
  }

  /* Content Body Column - flex: 1 with min-height: 0 ensures smooth scrolling on all mobile screens */
  .adm-popup-body {
    flex: 1 1 auto;
    min-height: 0;
    padding: clamp(1rem, 3.5vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }

  /* Custom subtle scrollbar */
  .adm-popup-body::-webkit-scrollbar {
    width: 6px;
  }
  .adm-popup-body::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.03);
    border-radius: 999px;
  }
  .adm-popup-body::-webkit-scrollbar-thumb {
    background: rgba(255, 182, 6, 0.4);
    border-radius: 999px;
  }
  .adm-popup-body::-webkit-scrollbar-thumb:hover {
    background: var(--gold, #FFB606);
  }

  .adm-badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
  }

  .adm-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.32rem 0.8rem;
    border-radius: 999px;
    background: rgba(255, 182, 6, 0.15);
    border: 1px solid rgba(255, 182, 6, 0.45);
    color: var(--gold, #FFB606);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--gold, #FFB606);
    box-shadow: 0 0 0 0 rgba(255, 182, 6, 0.7);
    animation: admPulse 2s infinite;
  }

  @keyframes admPulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(255, 182, 6, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 8px rgba(255, 182, 6, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(255, 182, 6, 0);
    }
  }

  .adm-grade-badge {
    font-size: 0.74rem;
    font-weight: 700;
    color: rgba(244, 241, 234, 0.7);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.32rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .adm-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .adm-popup-title {
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(1.45rem, 3.2vw, 2.35rem);
    font-weight: 700;
    line-height: 1.15;
    color: #FFFFFF;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .highlight-gold {
    color: var(--gold, #FFB606);
  }

  .adm-popup-subtitle {
    font-size: clamp(0.85rem, 1.2vw, 0.98rem);
    color: rgba(244, 241, 234, 0.82);
    line-height: 1.5;
    margin: 0;
  }

  /* Features Grid */
  .adm-features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.55rem;
    margin-block: 0.15rem;
  }

  .adm-feat-item {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    padding: 0.55rem 0.75rem;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .adm-feat-item:hover {
    background: rgba(255, 255, 255, 0.06);
    transform: translateX(3px);
  }

  .adm-feat-icon {
    font-size: 1.15rem;
    flex-shrink: 0;
    line-height: 1.2;
    padding-top: 0.08rem;
  }

  .adm-feat-text {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
  }

  .adm-feat-text strong {
    font-size: 0.86rem;
    color: #FFFFFF;
    font-weight: 700;
  }

  .adm-feat-text span {
    font-size: 0.76rem;
    color: rgba(244, 241, 234, 0.7);
    line-height: 1.38;
  }

  /* Urgency Callout */
  .adm-urgency-box {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.65rem 0.85rem;
    background: rgba(255, 182, 6, 0.08);
    border: 1px dashed rgba(255, 182, 6, 0.4);
    border-radius: 10px;
    font-size: 0.8rem;
    color: #F4F1EA;
    line-height: 1.42;
  }

  .urgency-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .adm-urgency-box strong {
    color: var(--gold, #FFB606);
  }

  /* Actions */
  .adm-popup-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .adm-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    min-height: 50px;
    padding: 0.8rem 1.5rem;
    background: var(--gold, #FFB606);
    color: #101216 !important;
    font-weight: 800;
    font-size: 0.98rem;
    letter-spacing: 0.01em;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 8px 24px -4px rgba(255, 182, 6, 0.45);
    transition: all 0.3s cubic-bezier(0.2, 1, 0.3, 1);
  }

  .adm-btn-primary:hover,
  .adm-btn-primary:focus-visible {
    background: #FFFFFF;
    color: #101216 !important;
    transform: translateY(-2px);
    box-shadow: 0 12px 30px -4px rgba(255, 182, 6, 0.55);
  }

  .adm-btn-primary :global(svg) {
    transition: transform 0.3s ease;
  }

  .adm-btn-primary:hover :global(svg) {
    transform: translateX(4px);
  }

  .adm-popup-subactions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .adm-contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.84rem;
    font-weight: 700;
    color: rgba(244, 241, 234, 0.85);
    text-decoration: none;
    min-height: 44px;
    padding: 0.4rem 0.6rem;
    border-radius: 8px;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .adm-contact-link :global(svg) {
    color: var(--gold, #FFB606);
  }

  .adm-contact-link:hover {
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.06);
  }

  .adm-btn-dismiss {
    background: transparent;
    border: none;
    color: rgba(244, 241, 234, 0.6);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    min-height: 44px;
    padding: 0.4rem 0.6rem;
    border-radius: 8px;
    transition: color 0.2s ease;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .adm-btn-dismiss:hover {
    color: #FFFFFF;
  }

  /* ==========================================================================
     Responsive Media Queries
     ========================================================================== */

  /* Desktop View: 2-Column Split Layout (Preserved 100% as requested) */
  @media (min-width: 860px) {
    .adm-popup-dialog {
      display: grid;
      grid-template-columns: 390px 1fr;
      grid-template-rows: 1fr;
      max-height: min(90vh, 880px);
    }

    .adm-popup-media {
      height: 100%;
      min-height: 580px;
    }

    .adm-popup-media-overlay {
      background: linear-gradient(
        180deg,
        rgba(17, 20, 26, 0.2) 0%,
        rgba(17, 20, 26, 0.75) 60%,
        rgba(17, 20, 26, 0.95) 100%
      );
    }

    .adm-popup-media-content {
      padding: 1.85rem;
    }

    .adm-popup-body {
      padding: 2.25rem 2.5rem;
      gap: 1.25rem;
    }

    .adm-features-grid {
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem 1rem;
    }
  }

  /* Tablet Adjustments (600px - 859px) */
  @media (max-width: 859px) and (min-width: 600px) {
    .adm-popup-dialog {
      max-width: 600px;
      max-height: min(92vh, 800px);
    }

    .adm-popup-media {
      height: 140px;
      min-height: 140px;
    }

    .adm-features-grid {
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
    }

    .adm-popup-body {
      padding: 1.35rem 1.5rem 1.85rem;
    }
  }

  /* Mobile Adjustments (max-width: 599px) */
  @media (max-width: 599px) {
    .adm-popup-backdrop {
      padding: 0.65rem;
    }

    .adm-popup-dialog {
      border-radius: 18px;
      max-height: 94vh;
      max-width: 480px;
    }

    .adm-popup-media {
      height: 125px;
      min-height: 125px;
    }

    .adm-popup-media-content {
      padding: 0.75rem 0.9rem;
    }

    .adm-media-footer {
      display: none; /* Keep header clean on small screens */
    }

    .adm-popup-body {
      padding: 1rem 0.95rem 1.75rem;
      gap: 0.85rem;
    }

    .adm-popup-title {
      font-size: 1.35rem;
      line-height: 1.2;
    }

    .adm-popup-subtitle {
      font-size: 0.82rem;
      line-height: 1.45;
    }

    .adm-features-grid {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }

    .adm-feat-item {
      padding: 0.45rem 0.65rem;
      gap: 0.55rem;
    }

    .adm-feat-icon {
      font-size: 1.05rem;
    }

    .adm-feat-text strong {
      font-size: 0.82rem;
    }

    .adm-feat-text span {
      font-size: 0.72rem;
      line-height: 1.32;
    }

