---
import Icon from './Icon.astro';
---
<section id="admissions" class="admissions" aria-labelledby="adm-title">
  <div class="container">
    <div class="adm-card" data-reveal>
      <div class="adm-copy">
        <span class="eyebrow no-line adm-eyebrow">Admissions</span>
        <h2 id="adm-title" class="adm-title" data-split>Admissions <em>Open</em></h2>
        <p class="adm-text">
          Become part of the Don Bosco family — a community built on inclusivity, equality and social responsibility, where every student has an equal opportunity to thrive.
        </p>
        <div class="adm-btn-wrap">
          <a href="/admission" class="adm-btn">
            <span>Explore Admissions &amp; Guidelines</span>
            <Icon name="arrow" class="arrow" />
          </a>
        </div>
      </div>
      <div class="adm-actions">
        <a href="tel:+918722089715" class="adm-contact">
          <span class="adm-ic"><Icon name="phone" size={20} /></span>
          <span><small>Call the school office</small>+91 87220 89715</span>
        </a>
        <a href="mailto:shirvadonboscoschool@gmail.com" class="adm-contact">
          <span class="adm-ic"><Icon name="mail" size={20} /></span>
          <span><small>Write to us</small>shirvadonboscoschool@gmail.com</span>
        </a>
      </div>
      <img src="/logo.jpg" alt="" class="adm-watermark" aria-hidden="true" loading="lazy" />
    </div>
  </div>
</section>

<style>
  .admissions { padding-block: clamp(1rem, 3vw, 2rem) var(--section); }
  .adm-card {
    position: relative;
    overflow: hidden;
    background: var(--gold);
    color: #101216;
    border-radius: clamp(24px, 3vw, 40px);
    padding: clamp(2.25rem, 6vw, 5rem);
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 2.5rem 4rem;
    align-items: end;
    isolation: isolate;
  }
  .adm-eyebrow { color: #101216; opacity: .75; }
  .adm-title {
    font-size: clamp(3rem, 8.5vw, 8rem);
    line-height: .92; letter-spacing: -0.045em; font-weight: 350;
    color: #101216; margin: .75rem 0 1.5rem;
  }
  .adm-title :global(em) { color: #101216; font-style: italic; font-weight: 300; font-variation-settings: "opsz" 144, "SOFT" 100, "WONK" 1; }
  .adm-text { max-width: 50ch; font-size: 1.08rem; color: rgba(16,18,22,.8); }
  .adm-btn-wrap { margin-top: 1.5rem; }
  .adm-btn {
    display: inline-flex; align-items: center; gap: .75rem;
    padding: .85rem 1.6rem; min-height: 50px;
    border-radius: var(--r-pill);
    background: #101216; color: #FFFFFF !important;
    font-weight: 700; font-size: .95rem;
    transition: all .3s var(--ease);
    box-shadow: 0 10px 24px -6px rgba(16, 18, 22, .3);
  }
  .adm-btn:hover {
    background: #FFFFFF; color: #101216 !important;
    transform: translateY(-2px);
    box-shadow: 0 14px 30px -6px rgba(16, 18, 22, .4);
  }
  .adm-btn :global(svg) { color: var(--gold); transition: transform .3s; }
  .adm-btn:hover :global(svg) { transform: translateX(3px); color: #101216; }

  .adm-actions { display: flex; flex-direction: column; gap: .75rem; }
  .adm-contact {
    display: flex; align-items: center; gap: 1rem;
    padding: 1rem 1.25rem; min-height: 72px;
    border-radius: var(--r);
    background: rgba(255,255,255,.35);
    border: 1px solid rgba(16,18,22,.12);
    font-weight: 700; font-size: 1rem;
    transition: background .4s var(--ease), color .4s, transform .5s var(--ease);
    word-break: break-word;
  }
  .adm-contact small { display: block; font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; opacity: .65; }
  .adm-contact:hover { background: #101216; color: #fff; transform: translateX(6px); }
  .adm-ic { width: 44px; height: 44px; flex-shrink: 0; border-radius: 50%; background: #101216; color: var(--gold); display: grid; place-items: center; }
  .adm-contact:hover .adm-ic { background: var(--gold); color: #101216; }

  .adm-watermark {
    position: absolute; right: -6%; top: -18%;
    width: 46%; max-width: 520px;
    mix-blend-mode: multiply; opacity: .12;
    z-index: -1; pointer-events: none;
    filter: grayscale(1);
  }

  @media (max-width: 992px) {
    .adm-card { grid-template-columns: 1fr; }
  }
  @media (max-width: 768px) {
    .adm-watermark { width: 70%; right: -20%; top: -8%; }
    .adm-contact { font-size: .92rem; }
  }
  @media (max-width: 480px) {
    .adm-card { padding: 1.75rem 1.25rem; border-radius: 20px; }
    .adm-btn { width: 100%; justify-content: center; }
    .adm-contact { padding: .75rem 1rem; min-height: 60px; font-size: .86rem; }
    .adm-contact small { font-size: .65rem; }
    .adm-ic { width: 38px; height: 38px; }
  }
</style>
